#include "ddm.dkh"
model "erp.requisiciones"
{
    /**
    * Requisiciones
    * =======================================================================
    */
    #include "induxsoft.abstracts.ddm"

    //* ======================================== [ DEPENDENCIAS (FK) ]
    // Enumeración de clases de productos
    entity "cclaseproducto" : "EnumModel" {}
    // Catálogo de tipos de documentos
    entity "cdocumentos" : "EnumModel" {}
    // Enumeración de formas de comisión de un producto
    entity "cformacomisionproducto" : "EnumModel" {}
    // Enumeración de formas de pago
    entity "cformaspago" : "EnumModel" {}
    // Enumeración de estados administrativos
    entity "cstatusadministrativos" : "EnumModel" {}
    // Enumeración de estados para el detalle de la compra
    entity "cstatusdetallecompra" : "EnumModel" {}
    // Enumeración de estados de entrega
    entity "cstatusentrega" : "EnumModel" {}
    // Enumeración de estados de facturación
    entity "cstatusfacturacion" : "EnumModel" {}
    // Enumeración de estados financieros
    entity "cstatusfinancieros" : "EnumModel" {}
    // Enumeración de estados posibles para un cliente, proveedor u organización
    entity "cstatusorg" : "EnumModel" {}
    // Tasas de IVA aplicables por razón de ubicación geográfica
    entity "ctasasiva" : "EnumModel" {}
    // Enumeración de tipos de categoria
    entity "ctiposcategorias" : "EnumModel" {}
    // Enumeración de tipo de productos
    entity "ctipoproducto" : "EnumModel" {}
    // Enumeración de tipos de comision de productos
    entity "ctiposcomisionesproducto" : "EnumModel" {}
    // Enumeración de metodos de valuación en inventarios
    entity "cmetodosvaluacion" : "EnumModel" {}

    //#region Domicilio
    entity "pais" : "TableModel"
    {
        @"codigo" string(8) unique required
        @"codigotel" string(5)
        @"nombre" string(100) unique required
    }
    entity "edoprov" : "TableModel"
    {
        @"codigo" string(8) unique required
        @"nombre" string(50) required
        @"ipais" ref:"pais" required
    }
    entity "ciudad" : "TableModel"
    {
        @"codigo" string(8) unique required
        @"codigotel" string(5)
        @"nombre" string(100) required
        @"estado" ref:"edoprov" required
    }
    entity "domicilio" : "TableModel"
    {
        @"codpos" string(10)
        @"colonia" string(150)
        @"direccion" string(1024)
        @"notas" string(150)
        @"telefonos" string(150)
        @"iciudad" ref:"ciudad"
        @"numint" string(1024)
        @"numext" string(1024)
    }
    //#endregion

    // Unidad organizacional
	entity "rh_unidad_org" : "TableModel"
	{
		@"codigo" string(32) unique required
		@"descripcion" string(150) required
		@"superior" ref:"rh_unidad_org"
		@"notas" string(4096)
		@"link" string(1024)
	}
    // Estados posibles para el presupuesto
    entity "gop_presupuesto_status" : "EnumModel"
    {
        /**
        * 1-Borrador
        * 2-Por aprobar
        * 3-Aprobado
        * 4-Cerrado
        */
    }
    // Catálogo de monedas o divisas
    entity "divisa" : "TableModel"
    {
        @"codigo" string(5) unique required
        @"descripcion" string(30) unique required
        @"tcambio" decimal(18,8)
    }
    // Presupuesto de una unidad organizacional	
	entity "gop_presupuesto" : "TableModel"
	{
		@"ref_unidad" ref:"rh_unidad_org" required
		@"ejercicio" int required
		@"titulo" string(150) required
		@"notas" memo
		@"status" ref:"gop_presupuesto_status" required
		@"divisa" ref:"divisa" required
		@"monto_autorizado" decimal(18,4) // El total aprobado del presupuesto
		@"monto_planeado" decimal(18,4) // El total presupuestado del ejercicio
		@"monto_comprometido" decimal(18,4) // El total que está en operaciones de adquisición en proceso
		@"monto_ejercido" decimal(18,4) // El total de operaciones de adquisición ya realizadas

		index "gop_presupuesto_id" unique
		{
			field "ref_unidad"
			field "ejercicio"
		}
	}
    // Partidas de un presupuesto
    entity "gop_partida" : "TableModel"
	{
		@"ref_presupuesto" ref:"gop_presupuesto" required
		@"id" string(36) required
		@"padre" ref:"gop_partida"
        @"partida" string(255) required
        @"ccontable" string(32) // Código de cuenta contable asociada a esta partida
		@"autorizado" decimal(18,4)

		// Importes presupuestados
		@"reserva" decimal(18,4)
		@"p01" decimal(18,4)
		@"p02" decimal(18,4)
		@"p03" decimal(18,4)
		@"p04" decimal(18,4)
		@"p05" decimal(18,4)
		@"p06" decimal(18,4)
		@"p07" decimal(18,4)
		@"p08" decimal(18,4)
		@"p09" decimal(18,4)
		@"p10" decimal(18,4)
		@"p11" decimal(18,4)
		@"p12" decimal(18,4)

		// Importes comprometidos
		@"rc" decimal(18,4)
		@"c01" decimal(18,4)
		@"c02" decimal(18,4)
		@"c03" decimal(18,4)
		@"c04" decimal(18,4)
		@"c05" decimal(18,4)
		@"c06" decimal(18,4)
		@"c07" decimal(18,4)
		@"c08" decimal(18,4)
		@"c09" decimal(18,4)
		@"c10" decimal(18,4)
		@"c11" decimal(18,4)
		@"c12" decimal(18,4)

		// Importes ejercidos
		@"re" decimal(18,4)
		@"e01" decimal(18,4)
		@"e02" decimal(18,4)
		@"e03" decimal(18,4)
		@"e04" decimal(18,4)
		@"e05" decimal(18,4)
		@"e06" decimal(18,4)
		@"e07" decimal(18,4)
		@"e08" decimal(18,4)
		@"e09" decimal(18,4)
		@"e10" decimal(18,4)
		@"e11" decimal(18,4)
		@"e12" decimal(18,4)

		@"notas" memo
	}
    // blockdocumentos
    entity "blockdocumentos" : "TableModel"
    {
        @"activo" bool required
        @"datos" string(255)
        @"documento" ref:"cdocumentos" required
        @"finicial" int required
        @"fiscal" bool required
        @"fultimo" int required
        @"idcontrol" string(32)
        @"numcontrol" int
        @"serie" string(10)
        @"uf_cfdfolio" int
        @"uf_cfdi_info" int
    }
    // foliosdocumentos
    entity "foliosdocumentos" : "TableModel"
    {
        @"cancelado" bool required
        @"fecha" date required
        @"folio" int required
        @"block" ref:"blockdocumentos" required

        index "idx_foliodoc" unique
        {
            field "folio"
            field "block"
        }
    }
    // Usuarios
    entity "tuser" : "TableModel"
    {
        @"locked" bool 
        @"message" string(255) 
        @"notes" memo 
        @"pwd" string(32) 
        @"userid" string(120) unique required
        @"username" string(120) required
        @"pwdmd5" string(64) 
        @"external" bool // Si es true, el usuario se consiera externo.
    }
    // departamento
    entity "departamento" : "TableModel"
    {
        @"codigo" string(5) unique required
        @"comision1" decimal(18,8)
        @"comision2" decimal(18,8)
        @"comision3" decimal(18,8)
        @"comision4" decimal(18,8)
        @"comision5" decimal(18,8)
        @"descripcion" string(50) unique required
    }
    // linea
    entity "linea" : "TableModel"
    {
        @"clase" ref:"cclaseproducto" required
        @"codigo" string(15) unique required
        @"color" int
        @"comision1" decimal(18,8)
        @"comision2" decimal(18,8)
        @"comision3" decimal(18,8)
        @"comision4" decimal(18,8)
        @"comision5" decimal(18,8)
        @"descripcion" string(50) unique required
        @"notas" string(4096)
        @"visible" bool
        @"uf_indicaciones" string(4096)
    }
    // marca
    entity "marca" : "TableModel"
    {
        @"codigo" string(5) unique required
        @"descripcion" string(50) unique required
    }
    // Configuracion de impuesto por zona
    entity "cfgimpuesto" : "TableModel"
    {
        @"i1compra" string(4096)
        @"i1venta" string(4096)
        @"i2compra" string(4096)
        @"i2venta" string(4096)
        @"i3compra" string(4096)
        @"i3venta" string(4096)
        @"i4compra" string(4096)
        @"i4venta" string(4096)
        @"nombre" string(25) unique required
        @"uf_tipoi1" string(25)
        @"uf_tipoi2" string(25)
        @"uf_tipoi3" string(25)
        @"uf_tipoi4" string(25)
        @"tasa" bool
        @"objetoimp" string(2)
    }
    // contacto
    entity "contacto" : "TableModel"
    {
        @"apellidos" string(50) required
        @"email1" string(50)
        @"email2" string(50)
        @"email3" string(50)
        @"email4" string(50)
        @"empresa" string(50)
        @"nombre" string(50) required
        @"notas" memo
        @"puesto" string(50)
        @"tel1" string(50)
        @"tel2" string(50)
        @"tel3" string(50)
        @"tratamiento" string(5)
        @"website" string(150)
        @"domicilio1" ref:"domicilio"
        @"domicilio2" ref:"domicilio"
    }
    // zona
    entity "zona" : "TableModel"
    {
        @"nombre" string(30) unique required
        @"notas" string(255) 
    }
    // Tipo (clasificación) del proveedor
    entity "tipoproveedor" : "TableModel"
    {
        @"codigo" string(15) unique required
        @"descripcion" string(50) unique required
        @"notas" string(4096) 
    }
    // tipooperacion
    entity "tipooperacion"
    {
        @"sys_pk" int key required autoincrement
        @"id" string(2) unique required
        @"descripcion" string(50)
        @"sys_recver" int
        @"sys_lock" int
        @"sys_deleted" bool
    }
    // Datos de un proveedor
    entity "proveedor" : "TableModel"
    {
        @"codcuenta" string(50) unique          // Código de cuenta contable asociado
        @"codigo" string(35) unique required    // Código o identificador del proveedor
        @"curp" string(35) unique
        @"diascredito" int                      // Días acordados de crédito comercial
        @"diasentrega" int
        @"email" string(50)                     // Correo electrónico
        @"fax" string(50)
        @"limitecredito" decimal(18,8)          // Importe máximo de crédito con el proveedor
        @"nombre" string(150) unique required   // Nombre o razón social
        @"notas" string(32000)                  // Notas generales
        @"rfc" string(15)                       // RFC
        @"saldo" decimal(18,8)                  // Saldo por pagar acumulado
        @"status" ref:"cstatusorg"              // Status del proveedor (normal o bloqueado)
        @"tasaiva" ref:"ctasasiva" required     // Tipo de tasa de IVA aplicable por razón de su zona económica
        @"telefonos" string(50)                 // Teléfonos de contacto
        @"website" string(150)                  // Sitio Web
        @"contacto1" ref:"contacto"
        @"contacto2" ref:"contacto"
        @"contacto3" ref:"contacto"
        @"domicilio1" ref:"domicilio"
        @"domicilio2" ref:"domicilio"
        @"domicilio3" ref:"domicilio"
        @"idivisa" ref:"divisa" required        // Divisa del proveedor
        @"izona" ref:"zona"
        @"tipo" ref:"tipoproveedor" required    // Tipo de proveedor
        @"uf_sys_baja" bool                     // Si es true, el proveedor está dado de baja
        @"uf_vueltaviajero" int
        @"uf_tipoop" ref:"tipooperacion"
    }
    // Información de productos
    entity "producto" : "TableModel"
    {
        @"adicional" bool
        @"cdirecto" decimal(18,8)
        @"cindirecto" decimal(18,8)
        @"cmanoobra" decimal(18,8)
        @"cmaquinaria" decimal(18,8)
        @"codbar1" string(35) unique
        @"codbar2" string(35) unique
        @"codbar3" string(35) unique
        @"codigo" string(35) unique required
        @"color" int
        @"comision" decimal(18,8)
        @"comision1" decimal(18,8)
        @"comision2" decimal(18,8)
        @"comision3" decimal(18,8)
        @"comision4" decimal(18,8)
        @"comision5" decimal(18,8)
        @"costopromedio" decimal(18,8)
        @"costoultimo" decimal(18,8)
        @"data1" string(500)
        @"data2" string(500)
        @"data3" string(500)
        @"desc2" decimal(18,8)
        @"desc3" decimal(18,8)
        @"desc4" decimal(18,8)
        @"desc5" decimal(18,8)
        @"descripcion" string(150) unique required
        @"diasentrega" int
        @"existencia" decimal(18,8)
        @"factorb" decimal(18,8)
        @"factorc" decimal(18,8)
        @"factord" decimal(18,8)
        @"factore" decimal(18,8)
        @"flaglimites" bool
        @"flagutilidad" bool
        @"formacomision" ref:"cformacomisionproducto"
        @"iclase" ref:"cclaseproducto" required
        @"itipo" ref:"ctipoproducto" required
        @"lim2" decimal(18,8)
        @"lim3" decimal(18,8)
        @"lim4" decimal(18,8)
        @"lim5" decimal(18,8)
        @"maximo" decimal(18,8)
        @"metodovaluacion" ref:"cmetodosvaluacion" required
        @"minimo" decimal(18,8)
        @"notas" memo
        @"padic1" decimal(18,8)
        @"padic2" decimal(18,8)
        @"padic3" decimal(18,8)
        @"padic4" decimal(18,8)
        @"padic5" decimal(18,8)
        @"ppuntos" decimal(18,8)
        @"precio1" decimal(18,8)
        @"precio2" decimal(18,8)
        @"precio3" decimal(18,8)
        @"precio4" decimal(18,8)
        @"precio5" decimal(18,8)
        @"puntoro" decimal(18,8)
        @"reqlote" bool required
        @"reqserie" bool required
        @"saldo" decimal(18,8)
        @"tipocomision" ref:"ctiposcomisionesproducto"
        @"unidad" string(10) required
        @"unidadb" string(10)
        @"unidadc" string(10)
        @"unidadd" string(10)
        @"unidade" string(10)
        @"util1" decimal(18,8)
        @"util2" decimal(18,8)
        @"util3" decimal(18,8)
        @"util4" decimal(18,8)
        @"util5" decimal(18,8)
        @"utilmin" decimal(18,8)
        @"vinculardata" bool
        @"visible" bool
        @"idepartamento" ref:"departamento"
        @"idivisa" ref:"divisa" required
        @"ilinea" ref:"linea" required
        @"imarca" ref:"marca"
        @"impuestos" ref:"cfgimpuesto" required
        @"ivariables" int
        @"proveedor1" ref:"proveedor"
        @"proveedor2" ref:"proveedor"
        @"proveedor3" ref:"proveedor"
        @"uf_solicitarcantidad" bool
        @"uf_sys_baja" bool
        @"uf_complemento" bool
        @"precio106" decimal(18,8)
        @"precio107" decimal(18,8)
        @"precio108" decimal(18,8)
        @"precio109" decimal(18,8)
        @"precio110" decimal(18,8)
        @"precio111" decimal(18,8)
        @"precio112" decimal(18,8)
        @"precio113" decimal(18,8)
        @"precio114" decimal(18,8)
        @"precio115" decimal(18,8)
        @"precio116" decimal(18,8)
        @"precio117" decimal(18,8)
        @"precio118" decimal(18,8)
        @"precio119" decimal(18,8)
        @"precio120" decimal(18,8)
        @"util106" decimal(18,8)
        @"util107" decimal(18,8)
        @"util108" decimal(18,8)
        @"util109" decimal(18,8)
        @"util110" decimal(18,8)
        @"util111" decimal(18,8)
        @"util112" decimal(18,8)
        @"util113" decimal(18,8)
        @"util114" decimal(18,8)
        @"util115" decimal(18,8)
        @"util116" decimal(18,8)
        @"util117" decimal(18,8)
        @"util118" decimal(18,8)
        @"util119" decimal(18,8)
        @"util120" decimal(18,8)
        @"uf_codigoparaproveedor1" string(50)
        @"uf_codigoparaproveedor2" string(50)
        @"uf_codigoparaproveedor3" string(50)
        @"uf_pdv" decimal(18,8)
        @"uf_dv_diasreorden" int
        @"uf_dv_inventarioseguridaddias" int
        @"uf_gruposimilares" int
        @"uf_inhabilitado" bool
        @"uf_fechainhabilitacion" datetime
        @"uf_sat_proser" string(50) required
        @"uf_sat_uniproser" string(50) required

        index "producto_sys_info"
        {
            field "sys_info"
        }
    }
    // Catálogo de almacenes
    entity "almacen" : "TableModel"
    {
        @"codcuenta" string(50) unique
        @"codigo" string(10) unique required
        @"descripcion" string(50) unique required
        @"email" string(50)
        @"fax" string(150)
        @"telefonos" string(150)
        @"website" string(150)
        @"domicilio1" ref:"domicilio"
        @"uf_movremoto" bool
        @"uf_inhabilitado" bool
        @"uf_fechainhabilitacion" datetime
        @"uf_formaproduccion" int
    }
    // categorias
    entity "categoria" : "TableModel"
    {
        @"codcuenta" string(50) unique
        @"codigo" string(5) unique required
        @"descripcion" string(50) unique required
        @"pmensual" decimal(18,8)
        @"tipo" ref:"ctiposcategorias"
        @"padre" ref:"categoria"
        @"uf_inhabilitado" bool
        @"uf_fechainhabilitacion" datetime
    }
    // cconsumo
    entity "cconsumo" : "TableModel"
    {
        @"codigo" string(5) unique required
        @"descripcion" string(50) unique required
        @"notas" string(2048)
        @"precio" int
        @"ialmacen" ref:"almacen"
        @"porcentaje_esperado" decimal(19,8)
        @"uf_domiciliocfd" int
        @"uf_expedicioncxc" int
        @"uf_inhabilitado" bool
        @"uf_fechainhabilitacion" datetime
        @"uf_grupoprod" int
    }
    // caja
    entity "caja" : "TableModel"
    {
        @"codcuenta" string(50) unique
        @"codigo" string(5) unique required
        @"descripcion" string(50) unique
        @"notas" string(2048)
        @"centroconsumo" ref:"cconsumo" required
        @"uf_limefectivo" decimal(18,8)
        @"uf_lime_vntadic" int
        @"uf_lime_aviso" decimal(18,8)
        @"uf_lime_alerta" string(500)
        @"uf_lime_pkprimerventa" int
        @"uf_corte_req" bool
        @"uf_horacorte1" time
        @"uf_horacorte2" time
        @"uf_horacorte3" time
        @"uf_horacorte4" time
        @"uf_horacorte5" time
        @"uf_cortereq_vntadic" int
        @"uf_lim_vntliber" int
    }
    // cajero
    entity "cajero" : "TableModel"
    {
        @"codigo" string(10) unique required
        @"codnomina" string(50) unique
        @"contrasena" string(32) required
        @"email" string(50)
        @"nombre" string(50) unique required
        @"notas" string(2048)
        @"telefono" string(25)
        @"domicilio1" ref:"domicilio"
        @"uf_sys_baja" bool
    }
    // corte
    entity "corte" : "TableModel"
    {
        @"cerrado" bool
        @"fapertura" date required
        @"fcierre" date
        @"hapertura" datetime required
        @"hcierre" datetime
        @"icaja" ref:"caja" required
        @"icajero" ref:"cajero"
    }
    // Catálogo de cajas
    entity "movcaja" : "TableModel"
    {
        @"auditado" bool
        @"cheques" decimal(18,8)
        @"contabilizado" bool
        @"depositos" decimal(18,8)
        @"documento" ref:"cdocumentos" required
        @"efectivo" decimal(18,8)
        @"fecha" date required
        @"hora" datetime required
        @"notas" string(255)
        @"partida" string(32)
        @"poliza" string(32)
        @"referencia" string(50) required
        @"tarjetas" decimal(18,8)
        @"tipocambio" decimal(18,8)
        @"vales" decimal(18,8)
        @"icategoria" ref:"categoria" required
        @"icorte" ref:"corte" required
        @"idivisa" ref:"divisa" required

        index "idx_movcaja" unique
        {
            field "cheques"
            field "efectivo"
            field "fecha"
            field "notas"
            field "referencia"
            field "tarjetas"
            field "vales"
        }
    }
    // Datos de una institución financiera
    entity "banco" : "TableModel"
    {
        @"nombre" string(50) unique required
        @"notas" string(2048)
        @"website" string(150)
        @"contacto" ref:"contacto"
    }
    // Datos de una cuenta en una institución financiera
    entity "chequera" : "TableModel"
    {
        @"clabe" string(18) unique
        @"codcuenta" string(50) unique
        @"nombre" string(25) unique required
        @"notas" string(4096)
        @"numcuenta" string(25) unique
        @"ibanco" ref:"banco"
        @"idivisa" ref:"divisa" required
    }
    // Movimientos de una cuenta en una institución financiera
    entity "movcuenta" : "TableModel"
    {
        @"aplicacion" date
        @"auditado" bool
        @"beneficiario" string(150)
        @"cancelado" bool
        @"conciliado" bool
        @"contabilizado" bool
        @"egreso" decimal(18,8)
        @"fecha" date
        @"ingreso" decimal(18,8)
        @"notas" string(4096) required
        @"partida" string(32)
        @"poliza" string(32)
        @"referencia" string(50) required
        @"tipo" ref:"cdocumentos" required
        @"icategoria" ref:"categoria" required
        @"icuenta" ref:"chequera" required
        @"uf_color" int
        @"uf_fechacancelacion" datetime
        @"uf_iproveedor" ref:"proveedor"

        index "movcuenta_id" unique
        {
            field "icuenta"
            field "referencia"
        }
    }
    // Registro de las compras
    entity "compra" : "TableModel"
    {
        @"auditado" bool
        @"contabilizado" bool
        @"descuento1" decimal(18,8)
        @"descuento2" decimal(18,8)
        @"directos" decimal(18,8)
        @"documento" ref:"cdocumentos" required
        @"fecha" date
        @"fembarque" date
        @"fentrega" date
        @"fliquidacion" date
        @"formapago" ref:"cformaspago" required
        @"fultimopago" date
        @"impuesto1" decimal(18,8)
        @"impuesto2" decimal(18,8)
        @"impuesto3" decimal(18,8)
        @"impuesto4" decimal(18,8)
        @"indirectos" decimal(18,8)
        @"notas" memo
        @"partida" string(32)
        @"poliza" string(32)
        @"referencia" string(25) required
        @"statusadministrativo" ref:"cstatusadministrativos" required
        @"statusentrega" ref:"cstatusentrega" required
        @"statusfacturacion" ref:"cstatusfacturacion" required
        @"statusfinanciero" ref:"cstatusfinancieros" required
        @"subtotal" decimal(18,8)
        @"tipoCambio" decimal(18,8)
        @"vencimiento" date
        @"aplicadoa" ref:"compra"
        @"ialmacen" ref:"almacen" required
        @"idivisa" ref:"divisa" required
        @"imovcaja" ref:"movcaja"
        @"imovchequera" ref:"movcuenta"
        @"iproveedor" ref:"proveedor" required
        @"uf_color" int
        @"uf_fechacancelacion" datetime
        @"uf_importado" bool
        @"uf_iaduana" int
        @"uf_numdocaduanero" string(200)
        @"uf_fechadocaduanero" date
    }
    // Detalle de las compras (productos adquiridos)
    entity "dcompra" : "TableModel"
    {
        @"cantidad" decimal(18,8)
        @"costototal" decimal(18,8)
        @"descuento1" decimal(18,8)
        @"descuento2" decimal(18,8)
        @"factor" decimal(18,8)
        @"impuesto1" decimal(18,8)
        @"impuesto2" decimal(18,8)
        @"impuesto3" decimal(18,8)
        @"impuesto4" decimal(18,8)
        @"notas" string(255)
        @"precio" decimal(18,8)
        @"status" ref:"cstatusdetallecompra" required
        @"tipocambio" decimal(18,8)
        @"unidad" string(10) required
        @"xfacturar" decimal(18,8)
        @"documento" ref:"compra"
        @"doc_partida" ref:"dcompra"
        @"iproducto" ref:"producto" required
        @"fk_compra_detalle" ref:"compra" required
    }

    //* ======================================== [ ENTIDADES PRINCIPALES ]
    // Estados posibles para la requisición
    entity "cmpreq_status" : "EnumModel"
    {
        /**
        * 0-Borrador
        * 1-Por aprobar
        * 10-Aprobada
        * 20-En proceso
        * 30-Completada
        * 99-Cancelada
        */
    }
    // Tipos de requisiciones
    entity "cmpreq_type" : "EnumModel"
    {
        /**
        * 1-Gastos de operacion
        * 2-Mantenimiento de stock
        * 3-Previsión en general
        * 10-Consolidación
        */
    }
    // Requisiciones
    entity "cmpreq": "TableModel"
    {
        @"fecha" date required // Fecha formal de elaboración
        @"flimite" datetime // Fecha y hora límite para completarla
        @"partida" ref:"gop_partida"
        @"periodo" int
        @"referencia" string(32) unique required
        @"folio" ref:"foliosdocumentos" unique required
        @"ucreo" ref:"tuser" required // Id del usuario que creó la requisición
        @"uaprobo" ref:"tuser" // Id del usuario que aprobó la requisición
        @"status" ref:"cmpreq_status" required
        @"notas" memo
        @"consolidacion" bool // Es una consolidación (no debe tener detalle)
        @"en" ref:"cmpreq" // Requisición en la que está consolidada
        @"subtotal" decimal(14,4) required     // No modificable de manera directa, lo calcula el modelo
        @"impuestos" decimal(14,4) required // No modificable de manera directa, lo calcula el modelo
        @"divisa" ref:"divisa" required
        @"tcambio" decimal(12,6) required
        @"tipo" ref:"cmpreq_type"
        @"almacen" ref:"almacen"
    }
    // Detalle de la requisición
    entity "dcmpreq": "TableModel"
    {
        @"ref_req" ref:"cmpreq" required
        @"producto" ref:"producto" required
        @"cantidad" decimal(12,4) required
        @"unidad" string(15) required
        @"precio" decimal(12,4) required
        @"impuestos" decimal(12,4) required
        @"excluido" bool
        @"notas" memo
        @"pedido" ref:"dcompra" // Fila (partida) del pedido de esta partida (lote) de la requisición
    }
    
    // Relacion entre filas de detalle de requisiciones directas y requisiciones consolidadas
    // entity "cmpreqdcon": "TableModel"
    // {
    //     @"ref_req" ref:"cmpreq" required // Consolidada (requisicion)
    //     @"ref_dcmpreq" ref: "dcmpreq" required // Fila de la requisicion directa que se considero antes de hacer el pedido (este desierta o no)
    // }

    //Solicitud de cotización a proveedor
    entity "solcot": "TableModel"
    {
        @"referencia" string(32) unique required
        @"folio" ref:"foliosdocumentos" unique required
        @"proveedor" ref:"proveedor" required
        @"fenvio" date // fecha oficial en que fue enviada al proveedor
        @"redaccion" memo // Texto libre (generalmente de una variable de configuración)
        @"notas" memo
        @"req" ref:"cmpreq" required // Requisición de origen
        @"fresp" datetime // fecha y hora en que se recibió la cotización
        @"cotizacion" ref:"compra"
        @"completa" bool // Es true si la cotización del proveedor cubre todos los elementos solicitados
        @"cancelada" bool // true indica que se ha decidido considerar cancelada la solicitud
        @"motivo" memo // Motivo de la cancelación
        @"ucreo" ref:"tuser" required // usuario que creó la solicitud de cotización
        @"urecibio" ref:"tuser" // usuario que recibió (vinculó) la cotización
        @"ucancelo" ref:"tuser" // usuario que canceló la solicitud de cotización
    }

    //* ======================================== [ ... ]
    // Permisos disponibles
    entity "sitem" : "TableModel"
    {
        @"description" string(250)
        @"itemid" string(32) unique required
        @"itemparent" ref:"sitem"
    }
    // Información de la aplicación
    entity "sys_app_catalog"
    {
        @"pack_id" string(32) required
        @"app_id" string(32) key
        @"app_title" string(255)
        @"created" datetime required
        @"app_info" mmemo
    }
    // Categoria de la aplicación
    entity "sys_app_category"
    {
        @"id" string(32) key
        @"title" string(255) required
    }
    // Recursos de la aplicación
    entity "sys_app_shortcut" 
    {
        @"id" string(32) key
        @"title" string(255) required
        @"icon96x96" string(1024) required
        @"src" string(1024) required
        @"_blank" bool
        @"appid" ref:"sys_app_catalog"
        @"cat" ref:"sys_app_category"
    }
    // Tipos de elementos de la aplicación
    entity "sys_app_item_type"
    {
        @"id" string(32) key
        @"title" string(255) required
    }
    // Acciones Generales o Especificas de elementos de la aplicación
    entity "sys_app_item_action"
    {
        @"id" string(32) key
        @"title" string(255) required
        @"shorttitle" string(25) 
        @"icon16x16" string(1024) required
        @"href" string(1024) required
        @"_blank" bool
        @"appid" ref : "sys_app_catalog"
        @"itemtype" ref : "sys_app_item_type"
        @"req_context_item_id" bool
        @"act_type" string(15) //Cadena con el tipo de acción: 'action' o 'report'
    }
}