[
    {
        "id": "cmpreq",
        "caption": "Requisiciones",
        "help": "Variables del paquete: cmpreq",
        "vars": [
            {
                "varname": "cmpreq_fix_ref_size",
                "vardefault": "6",
                "varvalue": "6",
                "varcaption": "Tamaño de la referencia",
                "varhelp": "Cantidad de '0' alineados a la izquierda del identificador numérico para la referencia.",
                "vartype": "int",
                "varinput": {
                    "control": "number"
                }
            },
            {
                "varname": "cmpreq_zimpuesto",
                "vardefault": "1",
                "varvalue": "1",
                "varcaption": "Zona de impuestos",
                "varhelp": "Configuración de la zona para el cálculo de impuestos de los productos.",
                "vartype": "int",
                "varinput": {
                    "control": "select",
                    "source":{
                        "type":"list",
                        "values":[
                            {"id":"1", "const":"cInterior"},
                            {"id":"2", "const":"cFrontera"}
                        ],
                        "keyfield":"id",
                        "showfield":"const"
                    }
                }
            },
            {
                "varname": "cmpreq_redaccion_solcot",
                "vardefault": "",
                "varvalue": "",
                "varcaption": "Redacción de solicitud",
                "varhelp": "Redacción predeterminada para las solicitudes de cotización a proveedores.",
                "vartype": "text",
                "varinput": {
                    "control": "textarea"
                }
            },
            {
                "varname": "cmpreq_sobre_aprovisionamiento",
                "vardefault": "",
                "varvalue": "0",
                "varcaption": "Sobre aprovisionar productos",
                "varhelp": "",
                "vartype": "int",
                "varinput": {
                    "control": "select",
                    "source":{
                        "type":"list",
                        "keyfield":"id",
                        "showfield":"const",
                        "values":[
                            {"id":"0", "const":"Nada (solo lo que necesito)"},
                            {"id":"1", "const":"Hasta el mínimo del producto en el almacen del centro de consumo"}
                        ]
                    }
                }
            },
            {
                "varname": "cmpreq_surtir_al_consolidar",
                "vardefault": "",
                "varvalue": "0",
                "varcaption": "Surtir al consolidar",
                "varhelp": "",
                "vartype": "bool",
                "varinput": {
                    "control": "select",
                    "source":{
                        "type":"list",
                        "keyfield":"id",
                        "showfield":"const",
                        "values":[
                            {"id":"0", "const":"Se toma la cantidad de la requisición directa"},
                            {"id":"1", "const":"Se toma la cantidad menos lo surtido de la requisición directa"}
                        ]
                    }
                }
            },
            {
                "varname": "cmpreq_catinv_para_surtir",
                "vardefault": "",
                "varvalue": "SR",
                "varcaption": "Categoría de inventario predeterminada para surtir",
                "varhelp": "",
                "vartype": "string",
                "varinput": {
                    "control": "select",
                    "source":{
                        "type":"query",
                        "query":"select codigo, descripcion from categoria where not ifnull(sys_deleted,0) and tipo=3",
                        "keyfield":"codigo",
                        "showfield":"descripcion"
                    }
                }
            },
            {
                "varname": "cmpreq_transfer_mode",
                "vardefault": "",
                "varvalue": "1",
                "varcaption": "Modo de aplicación de transferencia",
                "varhelp": "",
                "vartype": "int",
                "varinput": {
                    "control": "select",
                    "source":{
                        "type":"list",
                        "keyfield":"id",
                        "showfield":"const",
                        "values":[
                            {"id":"1", "const":"Completa"},
                            {"id":"2", "const":"En 2 pasos"}
                        ]
                    }
                }
            }
        ]
    }
]