#include "dkli.dkh"
#!
module "form.new.dk"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "uielements.v12.dkl"
    #include "../_lib/config.dk"
    #include "../_lib/lib.dk"
	#include "../_lib/icons.dk"

    do @context.begin(@crud_context)

    ref unidad_org = ifnull(@("&./dt_unidad_org"),record.create())
    ref partida_pre = ifnull(@("&./dt_partida_pre"),record.create())

	@_entities_type = @("$parameters/_entities_type")
	@_entity_id = @("$parameters/_entity_id")
	@is_new = (@_entity_id == "_new")
    @form_id = "form-new-cmpreq"

    ik_sm_style = "
    #input_search_container, #input_description_container,
    #button_search_container, #button_clear_container {
        height: calc(1.5em + .5rem + 2px) !important;
        padding: .25rem .5rem !important;
        font-size: .875rem !important;
    }
    "

    function printNavButtons()
    {
        cls = "btn btn-main-action btn-sm border-secondary induxsoft-corners no-shadow"
        #$
        button(class="#<cls>" type="submit" form="#<@form_id>" title="Guardar"){$"#<@ICON_SAVE>"}
        #!
    }
    point buttons to printNavButtons
    new nav_config
    {
        @"title": "Nueva requisición"
        @"buttons*": buttons
        
        member @"hidden"
        {
            @"send": @true
            @"copy": @true
            @"csv": @true
            @"print": @true
        }
    }

    new sel_tipo
    {
        @"id": "sel_tipo"
        @"value_field": "id"
        @"text_field": "const"
        @"selected": @('#./tipo')
        @"datatable*": ifnull(@("&./list_tipos"),list.create())
        member "attributes"
        {
            @"class": "form-select form-select-sm rounded-0"
            @"name": "tipo"
            @"required": ""
        }
    }
    
    new sel_serie
    {
        @"id": "sel_serie"
        @"value_field": "serie"
        @"text_field": "serie"
        @"selected": @('#./serie')
        @"datatable*": ifnull(@("&./list_series"),list.create())
        member "attributes"
        {
            @"class": "form-select form-select-sm rounded-0"
            @"style": "max-width:5rem;"
            @"name": "serie"
            @"required": ""
        }
        member "attr_options"
        {
            @"data-iblock": "#<@@(row,'#sys_pk')>"
        }
    }

    new sel_almacen
    {
        @"id": "sel_almacen"
        // @"first_value": "-1"
        // @"first_text": "(Todos los almacenes)"
        @"value_field": "sys_pk"
        @"text_field": "descripcion"
        @"selected": @('#./almacen')
        @"datatable*": ifnull(@("&./list_almacenes"),list.create())
        member "attributes"
        {
            @"class": "form-select form-select-sm rounded-0"
            @"name": "almacen"
            @"required": ""
        }
    }

    new sel_divisa
    {
        @"id": "sel_divisa"
        @"value_field": "sys_pk"
        @"text_field": "text"
        @"selected": @('#./divisa')
        @"datatable*": ifnull(@("&./list_divisas"),list.create())
        member "attributes"
        {
            @"class": "form-select form-select-sm rounded-0"
            @"name": "divisa"
            @"required": ""
        }
        member "attr_options"
        {
            @"data-codigo": "#<toupper(@@(row,'$codigo'))>"
            @"data-tcambio": "#<@@(row,'#tcambio')>"
        }
    }

    new sel_status
    {
        @"id": "sel_status"
        @"value_field": "id"
        @"text_field": "const"
        @"selected": field.dnum(@('&.'),"status",1)
        @"datatable*": ifnull(@("&./list_status"),list.create())
        member "attributes"
        {
            @"class": "form-select form-select-sm rounded-0"
            @"name": "status"
            @"required": ""
        }
    }

    new fil_clase
    {
        @"id": "fil_clase"
        @"first_value": "-1"
        @"first_text": "(Todas las clases)"
        @"value_field": "id"
        @"text_field": "const"
        @"selected": @('#./fil_clase')
        @"datatable*": ifnull(@("&./list_clases"),list.create())
        member "attributes"
        {
            @"class": "form-select form-select-sm rounded-0"
            @"name": "fil_clase"
        }
    }

    new fil_linea
    {
        @"id": "fil_linea"
        @"first_value": "-1"
        @"first_text": "(Todas las lineas)"
        @"value_field": "sys_pk"
        @"text_field": "descripcion"
        @"selected": @('#./fil_linea')
        @"datatable*": ifnull(@("&./list_lineas"),list.create())
        member "attributes"
        {
            @"class": "form-select form-select-sm rounded-0"
            @"name": "fil_linea"
        }
    }

    new fil_marca
    {
        @"id": "fil_marca"
        @"first_value": "-1"
        @"first_text": "(Todas las marcas)"
        @"value_field": "sys_pk"
        @"text_field": "descripcion"
        @"selected": @('#./fil_marca')
        @"datatable*": ifnull(@("&./list_marcas"),list.create())
        member "attributes"
        {
            @"class": "form-select form-select-sm rounded-0"
            @"name": "fil_marca"
        }
    }

    new fil_depto
    {
        @"id": "fil_depto"
        @"first_value": "-1"
        @"first_text": "(Todos los departamentos)"
        @"value_field": "sys_pk"
        @"text_field": "descripcion"
        @"selected":@('#./fil_depto')
        @"datatable*": ifnull(@("&./list_deptos"),list.create())
        member "attributes"
        {
            @"class": "form-select form-select-sm rounded-0"
            @"name": "fil_depto"
        }
    }

    new fil_prod_below
    {
        @"id": "fil_prod_below"
        @"value_field": "v"
        @"text_field": "t"
        @"selected": @('$./fil_prod_below')
        @"datatable*": from.json('[{"v":"preorden","t":"Punto de re-orden"}, {"v":"minimo","t":"Mínimo"}]')
        member "attributes"
        {
            @"class": "form-select form-select-sm rounded-0 w-auto"
            @"name": "fil_prod_below"
        }
    }

    new fil_prod_until
    {
        @"id": "fil_prod_until"
        @"value_field": "v"
        @"text_field": "t"
        @"selected": @('$./fil_prod_until')
        @"datatable*": from.json('[{"v":"minimo","t":"Mínimo"}, {"v":"maximo","t":"Máximo"}, {"v":"promedio","t":"Promedio"}]')
        member "attributes"
        {
            @"class": "form-select form-select-sm rounded-0 w-auto"
            @"name": "fil_prod_until"
        }
    }

    new sel_periodo
    {
        @"id": "sel_periodo"
        @"value_field": "id"
        @"text_field": "const"
        @"selected": @('#./periodo')
        @"datatable*": @periodos
        member "attributes"
        {
            @"class": "form-select form-select-sm rounded-0"
            @"name": "periodo"
        }
    }
    // Encapsula a la vista en su totalidad, todo lo que hay antes o después no se considera 
    #$
    div(class="container-lg" id="view")
    {
        // link(href="/$/{_pack}/css/styles.css" rel="stylesheet"){""}

        // Filtros y acciones
        section(id="top_area")
        {
            #!
            do uie.printV12FormBar(nav_config)
            #$
        }
        // Contenido principal
        section(id="work_area" style="overflow-y:auto; overflow-x:hidden;")
        {
            #!
            error = @("$error/message")
            if error != ""
            {
                #$
                div(class="alert alert-danger alert-dismissible fade show mb-2 pb-1" role="alert")
                {
                    div(class="w-100 overflow-auto pb-2"){$"#<error>"}
                    button(type="button" class="btn-close" "data-bs-dismiss"="alert" "aria-label"="Close"){""}
                }
            }
            #$
            form(class="px-1" action="./" method="POST" id="#<@form_id>")
            {
                input(type="hidden" name="sys_pk" value="0")
                input(type="hidden" name="sys_recver" value="0")
                #!
                do uie.print_from_url_field()
                #$

                div(class="row gx-1 gx-sm-2 gx-md-3 gx-lg-4")
                {
                    div(class="col-6 col-sm-12 col-md-3")
                    {
                        label(class="form-label" "for"="sel_tipo"){"Tipo:"}
                        ##
                        do uie.dbSelect(sel_tipo)
                        ##
                    }
                    div(class="col-6 col-sm-4 col-md-3")
                    {
                        label(class="form-label" "for"="sel_serie"){"Referencia:"}
                        div(class="input-group input-group-sm")
                        {
                            ##
                            do uie.dbSelect(sel_serie)
                            ##
                            input(class="form-control form-control-sm rounded-0 text-end" type="number" name="folio" value="" id="txt_folio" min="1" step="1" placeholder="<A>")
                            button(class="btn btn-light btn-sm rounded-0 border" type="button" id="btn_get_folio" title="Obtener folio disponible para la serie seleccionada"){$"#<@ICON_HDOTS>"}
                        }
                    }
                    div(class="col-6 col-sm-4 col-md-3")
                    {
                        label(class="form-label" "for"="txt_fecha"){"Elaboración:"}
                        input(class="form-control form-control-sm rounded-0" type="date" name="fecha" value="#<@('$./fecha')>" id="txt_fecha" required="" title="Fecha formal de elaboración")
                    }
                    div(class="col-6 col-sm-4 col-md-3")
                    {
                        label(class="form-label" "for"="txt_flimite"){"Vencimiento:"}
                        input(class="form-control form-control-sm rounded-0" type="date" name="flimite" value="#<@('$./flimite')>" id="txt_flimite" title="Fecha límite para completarla")
                    }

                    div(class="col-12 col-lg-8")
                    {
                        label(class="form-label" "for"="ik_unidad_org"){"Unidad organizacional:"}
                        "input-key"(name="unidad_org" id="ik_unidad_org" required="true" "data-key"="sys_pk" "data-search"="codigo" "data-text"="descripcion" 
                            "data-value"="#<to.json(unidad_org)>" "data-source"="#<@URL_BUSCAR_UNIDAD_ORG>" columns="codigo,descripcion" colcaptions="Código,Descripción"
                            "control-styles"="#<ik_sm_style>"
                        ){""}
                    }
                    div(class="col-12 col-sm-6 col-lg-4")
                    {
                        label(class="form-label" "for"="sel_almacen"){"Almacén:"}
                        ##
                        do uie.dbSelect(sel_almacen)
                        ##
                    }

                    div(class="col-12")
                    {
                        div(class="d-flex align-items-center gap-2 my-2")
                        {
                            input(class="form-check-input" type="checkbox" name="add-products" id="chk-add-products" "data-bs-toggle"="collapse" "data-bs-target"="#collapse-add-products" "aria-expanded"="false" "aria-controls"="collapse-add-products" onchange="document.getElementById('products-filters').disabled = !this.checked")
                            label(class="form-check-label" "for"="chk-add-products"){"Agregar productos"}
                            hr(class="flex-grow-1 m-0"){""}
                        }
                        div(class="collapse pt-2 pb-4" id="collapse-add-products")
                        {
                            fieldset(class="row gx-2 gy-2" id="products-filters")
                            {
                                div(class="col-12 col-sm-6 col-md-3")
                                {
                                    ##
                                    do uie.dbSelect(fil_clase)
                                    ##
                                }
                                div(class="col-12 col-sm-6 col-md-3")
                                {
                                    ##
                                    do uie.dbSelect(fil_linea)
                                    ##
                                }
                                div(class="col-12 col-sm-6 col-md-3")
                                {
                                    ##
                                    do uie.dbSelect(fil_marca)
                                    ##
                                }
                                div(class="col-12 col-sm-6 col-md-3")
                                {
                                    ##
                                    do uie.dbSelect(fil_depto)
                                    ##
                                }
                                div(class="col-12")
                                {
                                    div(class="form-check")
                                    {
                                        #!
                                        checked = ifstr(parse.bool(@('$./fil_gv')), "checked", "")
                                        #$
                                        input(class="form-check-input" type="checkbox" name="fil_gv" id="chk_use_gv" "#<checked>"="")
                                        label(class="form-check-label" "for"="chk_use_gv"){"Si no hay valores por almacén, usar los valores globales del producto"}
                                    }
                                }
                                div(class="col-12")
                                {
                                    div(class="d-flex gap-1 flex-wrap")
                                    {
                                        div(class="d-flex align-items-center gap-1")
                                        {
                                            label(class="" "for"="fil_prod_below"){"Incluir productos iguales o por debajo del:"}
                                            ##
                                            do uie.dbSelect(fil_prod_below)
                                            ##
                                        }
                                        div(class="d-flex align-items-center gap-1")
                                        {
                                            label(class="" "for"="fil_prod_until"){"hasta alcanzar el:"}
                                            ##
                                            do uie.dbSelect(fil_prod_until)
                                            ##
                                        }
                                    }
                                }
                            }
                        }
                    }

                    div(class="col-12")
                    {
                        div(class="d-flex align-items-center gap-2 my-2")
                        {
                            input(class="form-check-input" type="checkbox" name="affect-gop" id="chk-affect-gop" "data-bs-toggle"="collapse" "data-bs-target"="#collapse-affect-gop" "aria-expanded"="false" "aria-controls"="collapse-affect-gop" onchange="document.getElementById('gop-fields').disabled = !this.checked")
                            label(class="form-check-label" "for"="chk-affect-gop"){"Afectar presupuesto de gastos de operación"}
                            hr(class="flex-grow-1 m-0"){""}
                        }
                        div(class="collapse pt-2 pb-4" id="collapse-affect-gop")
                        {
                            fieldset(class="row gx-1" id="gop-fields")
                            {
                                div(class="col-3 col-sm-2")
                                {
                                    label(class="form-label" "for"="sel_ejercicio"){"Ejercicio:"}
                                    select(class="form-select form-select-sm rounded-0" name="ejercicio" id="sel_ejercicio")
                                    {
                                        #!
                                        syear = @('#./ejercicio')
                                        if syear == 0 { syear = @curr_year }

                                        ref list_ejercicios = lib.list_years(10,5)
                                        for i = 0; i < list.count(list_ejercicios)
                                        {
                                            year = list.num(list_ejercicios,i)
                                            #$ option(value="#<year>" "#<ifstr(syear == year,'selected','')>"=""){"#<year>"}
                                        }
                                    }
                                }
                                div(class="col-9 col-sm-8")
                                {
                                    label(class="form-label" "for"="ik_partida_pre"){"Partida presupuestal:"}
                                    "input-key"(name="partida" id="ik_partida_pre" "data-key"="sys_pk" "data-search"="id" "data-text"="partida"
                                        "data-value"="#<to.json(partida_pre)>" "data-source"="#<@URL_BUSCAR_PARTIDA_PRE>" columns="id,partida" colcaptions="Id,Partida"
                                        "control-styles"="#<ik_sm_style>"
                                    ){""}
                                }
                                div(class="col-sm-2")
                                {
                                    label(class="form-label" "for"="sel_periodo"){"Periodo:"}
                                    ##
                                    do uie.dbSelect(sel_periodo)
                                    ##
                                }
                            }
                        }
                    }

                    div(class="col-12 col-sm-6")
                    {
                        label(class="form-label" "for"="sel_divisa"){"Divisa:"}
                        ##
                        do uie.dbSelect(sel_divisa)
                        ##
                    }
                    div(class="col-4 col-sm-3")
                    {
                        label(class="form-label" "for"="txt_tcambio"){"T.Cambio:"}
                        input(class="form-control form-control-sm rounded-0" type="number" name="tcambio" value="#<@('#./tcambio')>" id="txt_tcambio" min="1" step="0.000001" required="")
                    }
                    div(class="col-6 col-sm-3")
                    {
                        label(class="form-label" "for"="txt_status"){"Estado:"}
                        ##
                        do uie.dbSelect(sel_status)
                        ##
                    }
                }
            }
        }
        // Resúmenes y datos al pie
        section(id="bottom_area")
        {
            //////////////////////////////////////////////////////////////////
            div(id="_custom_area")
            {
                // script(src="/$/{_pack}/js/script.js"){$""}
                script(src="#<@JS_MAIN>"){$""}
                script(src="#<@JS_REQUISICIONES>"){$""}
                script(type="text/javascript")
                {$'
                    document.addEventListener("DOMContentLoaded", () => {
                        requisiciones.form.url_get_fultimo = "#<@URL_OBTENER_FULTIMO>";
                        requisiciones.form.url_get_linea = "#<@URL_OBTENER_LINEAS_XCLASE>";
                        requisiciones.form.url_get_unialm = "#<@URL_OBTENER_UNIALM>";
                        requisiciones.form.init();
                        // Script injection
                        #<@@(@crud_context,"$script")>
                    });
                '}
            }
        }
    }
    #!
    
    do @context.end()
}