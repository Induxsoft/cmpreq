#include "dkli.dkh"
#!
module "form.edt.dk"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "uielements.v12.dkl"
    #include "../_lib/config.dk"
    #include "../_lib/lib.dk"
	#include "../_lib/icons.dk"

    do @context.begin(@crud_context)

    ref @_GET = ifnull(@("&parameters"),record.create())
    ref cmpreq = ifnull(@("&./cmpreq"),record.create())
    ref dcmpreq = ifnull(@("&./dcmpreq"),list.create())

	@_entities_type = @("$parameters/_entities_type")
	@_entity_id = @("$parameters/_entity_id")

    if @@(cmpreq,"#consolidacion") {
        @http_context<"response/headers/location"> : path.concat(@CMP_CONSOLIDADO,@_entity_id)+"/"
        return
    }

    @curr_status = @@(cmpreq,"#status")
    @show_btn_xaprobar = (@curr_status == @stt_borrador)
    @show_btn_aprobar = (@curr_status == @stt_xaprobar)
    @show_btn_nproceso = (@curr_status == @stt_aprobado)
    @show_btn_cancelar = containsword(@curr_status, "0,1,10,20")
    @enable_editing = (@curr_status == @stt_borrador || @curr_status == @stt_xaprobar)

    in_consol = (@@(cmpreq,"#en") > 0)
    if in_consol 
    {
        @show_btn_xaprobar = @false
        @show_btn_aprobar = @false
        @show_btn_nproceso = @false
        @show_btn_cancelar = @false
        @enable_editing = @false
    }

    // ["En proceso", "Completa", "Incompleta"]
    if containsword(@curr_status, "20,30,31") && not(in_consol) {
        endpoint = replace(@CMP_IN_PROCESS,"{ireq}",@_entity_id)
        /* new context
        {
            @"entity*": cmpreq
            @"detail*": dcmpreq
        }
        jsonContext = to.json(context)
        jsonContext = url_encode(jsonContext)
        endpoint = path.concat(endpoint,ftext("?_context=#<jsonContext>")) */

        @http_context<"response/headers/location"> : endpoint
        return
    }

    if @("$error/message") != "" {
        _detalle = @("$./form/_detalle")
        if _detalle != "" { ref dcmpreq = from.json(_detalle) }
    }
    do lib.AutoFillRows(dcmpreq,10)

    periodo = ""
    go foreach.lobj(value:itm) with(@periodos)
    {
        if @@(itm,"#id") == @@(cmpreq,'#periodo') { periodo = @@(itm,"$const") }
    }

    header_act::
    {
        btn_cls = "btn btn-sm border-secondary induxsoft-corners btn-main-action no-print"
        
        if @show_btn_xaprobar { #$ button(class="#<btn_cls> btn-status" type="button" "data-status"="#<@stt_xaprobar>" title="Cambiar estado de la requisición"){$"#<@ICON_HOURGLASS> Por Aprobar"} #! }
        if @show_btn_aprobar { #$ button(class="#<btn_cls> btn-status" type="button" "data-status"="#<@stt_aprobado>" title="Cambiar estado de la requisición"){$"#<@ICON_CHECK> Aprobar"} #! }
        if @show_btn_nproceso { #$ button(class="#<btn_cls> btn-status" type="button" "data-status"="#<@stt_nproceso>" title="Cambiar estado de la requisición"){$"#<@ICON_PROCESS> En proceso"} #! }
        if @show_btn_cancelar { #$ button(class="#<btn_cls> btn-status" type="button" "data-status"="#<@stt_cancelado>" title="Cambiar estado de la requisición"){$"#<@ICON_FILE_CANCEL> Cancelar"} #! }
        
        if @enable_editing { #$ button(class="#<btn_cls>" type="button" id="btn_submit"){$"#<@ICON_SAVE>"} #! }
    }
    point general_act to header_act
    new nav_config
    {
        @"title": @@(cmpreq,"$referencia")
        @"buttons*": general_act
        @"urlexit": "../"
        member @"hidden" { @"print": @true }
    }

    #$
    div(class="container-lg")
    {
        link(href="#<@CSS_MAIN>" rel="stylesheet")

        #! do uie.printV12FormBar(nav_config)

        #$
        div(id="work_area" class="container-section #<ifstr(@enable_editing,'','disabled-all')>")
        {
            div(class="#<ifstr(@('$error/message')!='','alert alert-danger','')>"){$"#<@('$error/message')>"}

            form(method="POST" action="./" id="form-edt-cmpreq")
            {
                input(type="hidden" name="sys_pk" value="#<@@(cmpreq,'#sys_pk')>")
                input(type="hidden" name="sys_recver" value="#<@@(cmpreq, '#sys_recver')>")

                div(class="row mb-2")
                {
                    div(class="col-12 col-md-4 d-md-flex align-items-center justify-content-md-start gap-1")
                    {
                        h6(class="my-0"){"Tipo:"}
                        p(class="my-0"){"#<@@(cmpreq,'$ctipo')>"}
                    }
                    div(class="col-9 col-md-8 d-md-flex align-items-center justify-content-md-end gap-1")
                    {
                        h6(class="my-0"){"Unidad Organizacional:"}
                        p(class="my-0"){"#<@@(cmpreq,'$unidad_org')>"}
                    }
                    div(class="col-3 col-md-2 d-md-flex align-items-center justify-content-md-start gap-1")
                    {
                        h6(class="my-0"){"Ejercicio:"}
                        p(class="my-0"){"#<@@(cmpreq,'$ejercicio')>"}
                    }
                    div(class="col-9 col-md-8 d-md-flex align-items-center justify-content-md-center gap-1")
                    {
                        h6(class="my-0"){"Partida Presupuestal:"}
                        p(class="my-0"){"#<@@(cmpreq,'$partida_pre')>"}
                    }
                    div(class="col-3 col-md-2 d-md-flex align-items-center justify-content-md-end gap-1")
                    {
                        h6(class="my-0"){"Periodo:"}
                        p(class="my-0"){"#<periodo>"}
                    }
                }

                div(class="row gx-2")
                {
                    div(class="col-6 col-sm-3 col-md-2")
                    {
                        label(class="form-label" "for"="txt_fecha"){$"Elaboración:"}
                        input(class="form-control form-control-sm rounded-0" type="date" name="fecha" value="#<lib.form('fecha','dt',cmpreq)>" id="txt_fecha" required="" title="Fecha formal de elaboración")
                    }
                    div(class="col-6 col-sm-3 col-md-2")
                    {
                        label(class="form-label" "for"="txt_flimite"){$"Vencimiento:"}
                        input(class="form-control form-control-sm rounded-0" type="date" name="flimite" value="#<lib.form('flimite','dt',cmpreq)>" id="txt_flimite" title="Fecha y hora límite para completarla")
                    }
                    div(class="col-8 col-sm-6 col-md-4")
                    {
                        label(class="form-label" "for"="txt_divisa"){$"Divisa:"}
                        input(class="form-control form-control-sm rounded-0" type="text" value="#<@@(cmpreq,'$ddivisa')>" id="txt_divisa" "data-codigo"="#<@@(cmpreq,'$cdivisa')>" disabled="")
                    }
                    div(class="col-4 col-sm-3 col-md-2")
                    {
                        label(class="form-label" "for"="txt_tcambio"){$"T.Cambio:"}
                        input(class="form-control form-control-sm rounded-0 induxsoft-num-field mw-100" type="number" name="tcambio" value="#<lib.form('tcambio','nm',cmpreq)>" id="txt_tcambio" min="1" max="999999.999999" step="0.000001" required="" "num-decs"="6")
                    }

                    div(class="col-12" id="cmpreq_status_control"){$""}
                }

                label(class="form-label" "for"="txt_notas"){$"Notas:"}
                textarea(class="form-control rounded-0" name="notas" id="txt_notas" maxlength="32000"){$"#<lib.form('notas','tx',cmpreq)>"}

                input(type="hidden" name="_detalle" value="" id="txt_detalle")
            }

            div(class="d-flex justify-content-end align-items-center border-top gap-1 px-2 my-2" id="tbl_action_bar")
            {
                small(class="flex-grow-1 text-muted"){$"Seleccione los productos en la cuadrícula"}

                button(class="btn btn-sm d-flex align-items-center justify-content-center gap-2 no-shadow" type="button" id="btn-add-row" title="Agregar fila"){$"#<@ICON_ADD_ROW>"}
                button(class="btn btn-sm d-flex align-items-center justify-content-center gap-2 no-shadow" type="button" id="btn-del-row" title="Eliminar fila"){$"#<@ICON_REMOVE_ROW>"}
            }

            div(class="alert alert-danger rounded-0 mb-1 py-0 d-none" role="alert" id="tbl_alerts"){$""}

            div(class="" id="div_tbl_productos" style="width:auto; min-width:100%; max-height:55vh; display:flex;")
            {
                "edit-table"(id="tbl_productos" data="#<to.json(dcmpreq)>" "auto-confirm"="true" style="width:100%;"
                "row-height"="1.2rem"
                "control-styles"="
                    tr th{ white-space:nowrap; overflow:hidden; text-overflow:ellipsis; -o-text-overflow:ellipsis; }
                    tr td { font-size:.8rem; }
                    th { font-size:.9rem; outline:none !important; font-weight:500 !important; }
                    #__table_input { font-size:unset !important; }
                ")
                {
                    "edit-thead"
                    {
                        "edit-tr"
                        {
                            "edit-th"(type="Text" field="codigo" button="true"){$"Código"}
                            "edit-th"(type="Text" field="descripcion" button="true"){$"Descripción"}
                            "edit-th"(type="Select" field="unidad" options="{}"){$"Unidad"}
                            "edit-th"(type="Number" field="precio" textalign="end" format="true" thousandssep="true" decs="4"){$"Precio"}
                            "edit-th"(type="Number" field="cantidad" textalign="center"){$"Cantidad"}
                            "edit-th"(type="NoEditable" field="subtotal" textalign="end" format="true" thousandssep="true" decs="4"){$"Subtotal"}
                            "edit-th"(type="NoEditable" field="impuestos" textalign="end" format="true" thousandssep="true" decs="4"){$"Impuestos"}
                            "edit-th"(type="NoEditable" field="importe" textalign="end" format="true" thousandssep="true" decs="4"){$"Importe"}
                            "edit-th"(type="Memo" field="notas"){$"Notas"}
                        }
                    }
                }
            }

            div(class="d-flex justify-content-between w-100 bg-light p-2 border")
            {
                b{$"Subtotal: " span(id="lbl_subtotal"){$""}}
                b{$"Impuesto: " span(id="lbl_impuesto"){$""}}
                b{$"Importe: " span(id="lbl_importe"){$""}}
            }
        }

        div
        {
            "input-key"(id="ik_producto" "data-key"="sys_pk" "data-search"="codigo" "data-text"="descripcion" "data-source"="#<@URL_BUSCAR_PRODUCTO>" columns="codigo,descripcion" colcaptions="Código,Descripción" "box-title-text"="Seleccione un producto" "control-styles"="#container{display:none !important;}"){$""}
        }

        #$
        script(src="#<@JS_MAIN>"){$""}
        script(src="#<@JS_REQUISICIONES>"){$""}
		script(type="text/javascript")
		{$'
            document.addEventListener("DOMContentLoaded", () => {
                requisiciones.edit.url_change_status = "#<@URL_CHANGE_STATUS>";
                requisiciones.edit.url_solcot = "#<@CMP_SOLCOT>";
                requisiciones.edit.formId = "form-edt-cmpreq";
                requisiciones.edit.tableId = "tbl_productos";
                requisiciones.edit.divAlerts = "#tbl_alerts";
                requisiciones.edit.init();
                InduxsoftNumberFields.Init();

                
                _bitacora._url="#<@URL_BITACORA>";
                _bitacora.EnableLog("#<@("$./cmpreq/sys_guid")>");
            });
		'}
    }
}