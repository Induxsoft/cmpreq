#include "dkli.dkh"
#!
module ""
{
    @table_name = "cmpreq"
    @sys_fields = "sys_pk,sys_guid,sys_dtcreated,sys_timestamp,sys_info,sys_user,sys_lastuser,sys_exported,sys_dtexported,sys_recver,sys_deleted,sys_lock"

    @create_fields = @sys_fields + ",fecha,flimite,partida,periodo,referencia,folio,ucreo,uaprobo,status,notas,consolidacion,en,subtotal,impuestos,divisa,tcambio,tipo,almacen"
    @update_fields = @sys_fields + ",fecha,flimite,periodo,uaprobo,status,notas,en,subtotal,impuestos,tcambio"
    
    @create_exclude_fields = "sys_lastuser"
    @update_exclude_fields = "sys_pk,sys_guid,sys_dtcreated,sys_user,status"
    
    @create_alias_fields = ""
    @update_alias_fields = ""

    @list_query = @qry_list_cmpreq
    @read_query = @qry_cmpreq

    buscarUnidad::&db,&params
    {
        if trim(@@(params,"$id")) != ""
        {
            conditions = "AND (sys_pk = @id OR sys_guid = @id)"
            return dbr.rec(db,ftext(@qry_buscar_unidad),params)
        }
        if trim(@@(params,"$search")) != ""
        {
            conditions = "
                AND NOT IFNULL(sys_deleted,0)
                AND (codigo LIKE CONCAT('%',@search,'%') OR descripcion LIKE CONCAT('%',@search,'%'))
            "
            return dbr.list(db,ftext(@qry_buscar_unidad),params)
        }

        return list.create()
    }

    buscarPartida::&db,&params
    {
        if trim(@@(params,"$id")) != ""
        {
            conditions = "AND (pda.sys_pk = @id OR pda.sys_guid = @id)"
            return dbr.rec(db,ftext(@qry_buscar_partida),params)
        }
        if trim(@@(params,"$search")) != ""
        {
            joins = "
                INNER JOIN gop_presupuesto AS pto ON pto.sys_pk = pda.ref_presupuesto
                INNER JOIN rh_unidad_org AS uni ON uni.sys_pk = pto.ref_unidad
            "

            conditions = "
                AND NOT IFNULL(pda.sys_deleted,0)
                AND pto.ejercicio = @ejercicio
                AND uni.sys_pk = @iunidad
                AND (select count(sys_pk) from gop_partida where padre = pda.sys_pk) = 0
                AND (pda.id LIKE CONCAT('%',@search,'%') OR pda.partida LIKE CONCAT('%',@search,'%'))
            "
            return dbr.list(db,ftext(@qry_buscar_partida),params)
        }

        return list.create()
    }

    buscarProducto::&db,&params
    {
        do setZonaImpuesto(db,params)
        
        conditions = "
            AND NOT IFNULL(p.sys_deleted,0)
            AND (p.codigo LIKE CONCAT('%',@search,'%') OR p.descripcion LIKE CONCAT('%',@search,'%'))
        "
        
        return dbr.list(db,ftext(@qry_buscar_producto),params)
    }

    obtenerFultimo::&db,&params
    {
        new data
        {
            @"fultimo": dbr.folios.get_new(db,@@(params,"#_entity_id"))
        }
        return data
    }

    obtenerLineaXClase::&db,&params
    {
        return dbr.list(db,"SELECT sys_pk, codigo, descripcion FROM linea WHERE NOT IFNULL(sys_deleted,0) AND clase = @iclase",params)
    }

    obtenerUnidad::&db,id
    {
        new params { @"id": id }
        return buscarUnidad(db,params)
    }

    obtenerPartida::&db,id
    {
        new params { @"id": id }
        return buscarPartida(db,params)
    }

    setZonaImpuesto::&db,&params
    {
        /**
        * Zona de impuesto
        * 1 => 1 = cInterior
        * 2 => -1 = cFrontera
        */
        
        zimpuesto = dbr.vars.getd(db,"cmpreq_zimpuesto","1")
        if parse.num(zimpuesto) > 1 { zimpuesto = "-1" }
        params<"zimpuesto"> : zimpuesto
    }

    prepareList::&db,&params,&data
    {
        data<"list_status*"> : dbr.list(db,"SELECT * FROM cmpreq_status",@null)
    }

    prepareView::&db,&params,&data
    {
        isNew = (@@(params,"$_entity_id") == "_new")

        if isNew
        {
            ref fd = ifnull(@@(data,"&form"),record.create())
            new args
            {
                @"doctype": @cRequisicion
            }

            if @@(fd,"#unidad_org") > 0 { data<"dt_unidad_org*"> : obtenerUnidad(db,@@(fd,"#unidad_org")) }
            if @@(fd,"#partida") > 0 { data<"dt_partida_pre*"> : obtenerPartida(db,@@(fd,"#partida")) }

            data<"list_series*"> : dbr.list(db, @qry_list_series, args)
            data<"list_status*"> : dbr.list(db,"SELECT * FROM cmpreq_status WHERE id <= 10",@null)
            data<"list_divisas*"> : dbr.list(db, @qry_list_divisas, @null)

            if @@(params,"#cmpreq_type") == @type_req_stock
            {
                data<"list_almacenes*"> : dbr.list(db,"SELECT sys_pk, codigo, descripcion FROM almacen WHERE NOT IFNULL(sys_deleted,0)",@null)
                data<"list_clases*"> : dbr.list(db,"SELECT id, const FROM cclaseproducto",@null)
                data<"list_lineas*"> : list.create()
                data<"list_marcas*"> : dbr.list(db,"SELECT sys_pk, codigo, descripcion FROM marca WHERE NOT IFNULL(sys_deleted,0)",@null)
                data<"list_deptos*"> : dbr.list(db,"SELECT sys_pk, codigo, descripcion FROM departamento WHERE NOT IFNULL(sys_deleted,0)",@null)
            }
        }
        else
        {
            do setZonaImpuesto(db,params)

            if not(field.exist(data,"cmpreq")) { data<"cmpreq*"> : entity.read(db,params) }
            data<"dcmpreq*"> : dbr.list(db,ftext(@qry_dcmpreq),params)
        }
    }

    evaluateFilters::&params
    {
        conditions = ""

        if replace(@@(params,"$fil_status"),"*","") != "" { conditions = conditions + "AND req.`status` = @fil_status" }

        if trim(@@(params,"$fil_text")) != "" {
            conditions = conditions + "AND (req.referencia LIKE CONCAT('%',@fil_text,'%') OR IFNULL(pda.partida,'') LIKE CONCAT('%',@fil_text,'%'))"
        }

        // filter-date-range [start]
        new req_date_fields
        {
            @"1": "req.fecha" // Elaboración
            @"2": "req.flimite" // Vencimiento
        }
        
        fdr_field = @@(req_date_fields,str(@@(params,"#fil_fdr_field")))

        switch @@(params,"$fdr_mode")
        {
            case "month"
            {
                curr_ndt = ndatetime.now()
                curr_year = ndatetime.year(curr_ndt)
                curr_month = ndatetime.month(curr_ndt)
                curr_day = ndatetime.day(curr_ndt)

                if not(field.exist(params,"fdr_year")) { params<"fdr_year"> : curr_year }
                if not(field.exist(params,"fdr_month")) { params<"fdr_month"> : curr_month }

                conditions = conditions + " AND YEAR(#<fdr_field>) = @fdr_year AND MONTH(#<fdr_field>) = @fdr_month"
                break
            }
            case "lastdays"
            {
                if not(field.exist(params,"fdr_range")) { params<"fdr_range"> : 30 } // Últimos 30 días

                conditions = conditions + " AND DATE(#<fdr_field>) BETWEEN ADDDATE(DATE(NOW()), INTERVAL -@fdr_range DAY) AND DATE(NOW())"
                break
            }
            case "range"
            {
                if not(field.exist(params,"fdr_from"))
                {
                    curr_ndt = ndatetime.now()
                    subt_ndt = ndatetime.add(curr_ndt, -30, "d")
                    ult_30_days = ndatetime.tostr(subt_ndt, "yyyy-MM-dd")

                    params<"fdr_from"> : ult_30_days
                }
                if not(field.exist(params,"fdr_to")) { params<"fdr_to"> : hoy("yyyy-MM-dd") }

                if trim(@@(params,"$fdr_from")) != "" && trim(@@(params,"$fdr_to")) != ""
                {
                    conditions = conditions + " AND DATE(#<fdr_field>) BETWEEN @fdr_from AND @fdr_to"
                }
                else if trim(@@(params,"$fdr_from")) != "" && trim(@@(params,"$fdr_to")) == ""
                {
                    conditions = conditions + " AND DATE(#<fdr_field>) >= @fdr_from"
                }
                else if trim(@@(params,"$fdr_from")) == "" && trim(@@(params,"$fdr_to")) != ""
                {
                    conditions = conditions + " AND DATE(#<fdr_field>) <= @fdr_to"
                }

                break
            }
        }
        // filter-date-range [end]
        conditions = conditions + " LIMIT #<@default_max_rows>"

        conditions = ftext(conditions)
        @list_query = ftext(@list_query)
    }

    req.changeStatus::&db,&params,&data
    {
        @use_transaction = @false
        
        new_status = @@(data,"#status")

        new cmpreq
        {
            @"sys_pk": @@(data,"#sys_pk")
            @"sys_timestamp*": now()
            @"sys_lastuser": @@(@http_context, "$session/user/uid")
            @"sys_recver": @@(data,"#sys_recver")

            @"status": new_status
        }

        do dbr.begin(db)

        if new_status == @stt_aprobado
        {
            ref req = entity.read(db,params)
            
            if @@(req,"$tipo") == "D"
            {
                if dbr.num(db,"SELECT status FROM gop_presupuesto WHERE sys_pk = @ipresupuesto",req) < 3
                { do rise_error(500,"¡No es posible aprobar la requisición!\r\nEs necesario aprobar el presupuesto de la partida presupuestal.") }

                if dbr.num(db,"SELECT COUNT(sys_pk) FROM gop_partida WHERE padre = @ipartida",req) > 0
                { do rise_error(500,"No se puede afectar la requisición porque la partida presupuestal tiene sub-partidas, relacione la requisción a la sub-partida correspondiente") }

                ref pre = pregop.partida.importes(db, @@(req,"#ipartida"), @@(req,"#periodo"))

                if @@(req,"#importe") > @@(pre,"#disponible") { do rise_error(500,"¡No fue posible aprobar!\r\nEl total de la requisición supera el disponible del presupuesto en el periodo seleccionado.") }

                new gop_mov_data
                {
                    @"sys_pk": @@(req,"#ipartida") //(int) Clave primaria de la partida.
                    @"referencia": @@(req,"$referencia") //(string) Referencia del elemento que realiza la afectación.
                    @"periodo": @@(req,"#periodo") //(int) Mes (MM) sobre el que se hara la afectación.
                    @"comprometido": @@(req,"#importe") //(decimal) Monto (+\-) de la afectación.
                    @"ejercido": 0 //(decimal) Monto (+\-) de la afectación.
                    @"det": "DET070" //(string) Código DET (Data Element Type) del elemento que realiza la afectación.
                    @"det_id": @@(req,"#sys_pk") //(int) Clave primaria del elemento que realiza la afectación.
                    @"usuario": @@(@http_context, "$session/user/uid") //(string) UserId del usuario logueado que realiza la afectación.
                    @"notas": "Requisición aprobada" //(string) Descripción sobre el movimiento de afectación de presupuesto.
                }
                // if not(pregop.partida.comprometido(db, @@(req,"$partida_id"), @@(req,"#ejercicio"), @@(req,"#periodo"), @@(req,"#importe")))
                if not(pregop.partida.movimiento(db,gop_mov_data))
                { do rise_error(500,"¡No fue posible aprobar!\r\nHubo un problema al comprometer el ejercicio correspondiente.") }
            }

            cmpreq<"uaprobo"> : lib.GetPkUsr(db, @@(@http_context, "$session/user/uid"))
        }

        if new_status == @stt_cancelado
        {
            ref req = entity.read(db,params)
            
            if @@(req,"$tipo") == "D"
            {
                new gop_mov_data
                {
                    @"sys_pk": @@(req,"#ipartida") //(int) Clave primaria de la partida.
                    @"referencia": @@(req,"$referencia") //(string) Referencia del elemento que realiza la afectación.
                    @"periodo": @@(req,"#periodo") //(int) Mes (MM) sobre el que se hara la afectación.
                    @"comprometido": (@@(req,"#importe") * -1) //(decimal) Monto (+\-) de la afectación.
                    @"ejercido": 0 //(decimal) Monto (+\-) de la afectación.
                    @"det": "DET070" //(string) Código DET (Data Element Type) del elemento que realiza la afectación.
                    @"det_id": @@(req,"#sys_pk") //(int) Clave primaria del elemento que realiza la afectación.
                    @"usuario": @@(@http_context, "$session/user/uid") //(string) UserId del usuario logueado que realiza la afectación.
                    @"notas": "Requisición cancelada" //(string) Descripción sobre el movimiento de afectación de presupuesto.
                }
                // if not(pregop.partida.comprometido(db, @@(req,"$partida_id"), @@(req,"#ejercicio"), @@(req,"#periodo"), (@@(req,"#importe") * -1)))
                if not(pregop.partida.movimiento(db,gop_mov_data))
                { do rise_error(500,"¡No fue posible cancelar!\r\nHubo un problema al afectar el comprometido del ejercicio correspondiente.") }
            }

            if @@(req,"$tipo") == "C"
            {
                ref list_reqs = dbr.list(db,"SELECT sys_pk AS _entity_id FROM cmpreq WHERE en = @_entity_id",params)
                for i = 0; i < list.count(list_reqs)
                {
                    ref itm = list.obj(list_reqs,i)
                    ref req = entity.read(db,itm)

                    new gop_mov_data
                    {
                        @"sys_pk": @@(req,"#ipartida") //(int) Clave primaria de la partida.
                        @"referencia": @@(req,"$referencia") //(string) Referencia del elemento que realiza la afectación.
                        @"periodo": @@(req,"#periodo") //(int) Mes (MM) sobre el que se hara la afectación.
                        @"comprometido": (@@(req,"#importe") * -1) //(decimal) Monto (+\-) de la afectación.
                        @"ejercido": 0 //(decimal) Monto (+\-) de la afectación.
                        @"det": "DET070" //(string) Código DET (Data Element Type) del elemento que realiza la afectación.
                        @"det_id": @@(req,"#sys_pk") //(int) Clave primaria del elemento que realiza la afectación.
                        @"usuario": @@(@http_context, "$session/user/uid") //(string) UserId del usuario logueado que realiza la afectación.
                        @"notas": "Requisición cancelada" //(string) Descripción sobre el movimiento de afectación de presupuesto.
                    }
                    // if not(pregop.partida.comprometido(db, @@(req,"$partida_id"), @@(req,"#ejercicio"), @@(req,"#periodo"), (@@(req,"#importe") * -1)))
                    if not(pregop.partida.movimiento(db,gop_mov_data))
                    { do rise_error(500,"¡No fue posible cancelar!\r\nHubo un problema al afectar el comprometido del ejercicio correspondiente de la requisición: " + @@(req,"$referencia")) }
                }

                new reg
                {
                    @"sys_timestamp*": now()
                    @"sys_lastuser": @@(@http_context, "$session/user/uid")
                    @"sys_recver*": dbr.sql("(sys_recver + 1)")
                    @"status": new_status
                }
                do dbr.update(db, "cmpreq", reg, "en = @_entity_id", params)
            }
        }

        ref entity = dbr.save(db,"cmpreq",cmpreq)

        do dbr.commit(db)
        return entity

        exception
        {
            do errordet(@false)
            if dbr.in_transaction(db) { do dbr.rollback(db) }

            // ref FormData = record.copy(data,"*")
            code = last_error_code()
            error = last_error()

            // do record.clear(data)
            // data<"form*"> : FormData

            // do prepareView(db,params,data)
            do rise_error(code,error)
        }
    }

    req.getStockKeepingProducts::&db,&params
    {
        do setZonaImpuesto(db,params)

        selects = ",
        CASE @fil_prod_until
            WHEN 'minimo' THEN
                IF(mm.iproducto IS NULL AND @fil_gv = 'on',
                    (p.minimo - p.existencia),
                    (mm.uf_minimo - ex.existencia)
                )
            WHEN 'maximo' THEN
                IF(mm.iproducto IS NULL AND @fil_gv = 'on',
                    (p.maximo - p.existencia),
                    (mm.uf_maximo - ex.existencia)
                )
            WHEN 'promedio' THEN
                IF(mm.iproducto IS NULL AND @fil_gv = 'on',
                    ((p.minimo + ((p.maximo - p.minimo)/2)) - p.existencia),
                    ((mm.uf_minimo + ((mm.uf_maximo - mm.uf_minimo)/2)) - ex.existencia)
                )
        END AS cantidad_2
        "

        joins = "LEFT JOIN ut_maxmin AS mm ON mm.iproducto = p.sys_pk LEFT JOIN existencias AS ex ON ex.fk_producto_iexistencias = p.sys_pk"
        
        conditions = ""

        if @@(params,"#almacen") > 0 { conditions = conditions + " AND mm.ialmacen = @almacen AND ex.ialmacen = @almacen" }
        if @@(params,"#fil_clase") > 0 { conditions = conditions + " AND p.iclase = @fil_clase" }
        if @@(params,"#fil_linea") > 0 { conditions = conditions + " AND p.ilinea = @fil_linea" }
        if @@(params,"#fil_marca") > 0 { conditions = conditions + " AND p.imarca = @fil_marca" }
        if @@(params,"#fil_depto") > 0 { conditions = conditions + " AND p.idepartamento = @fil_depto" }

        // Incluir productos iguales o por debajo del...
        conditions = conditions + " AND IF(mm.iproducto IS NULL AND @fil_gv = 'on',
            IFNULL(p.existencia,0) <= IF(@fil_prod_below = 'preorden', IFNULL(p.puntoro,0), IFNULL(p.minimo,0)),
            IFNULL(ex.existencia,0) <= IF(@fil_prod_below = 'preorden', IFNULL(mm.uf_preorden,0), IFNULL(mm.uf_minimo,0))
        )
        "

        return dbr.list(db,ftext(@qry_buscar_producto),params)
    }

    req.calculateTaxes::&product
    {
        costo = @@(product,"#precio")
        cantidad = @@(product,"#cantidad")
        descuentos = @@(product,"#descuentos")
        i1_tasa = @@(product,"#i1_tasa")
        i2_tasa = @@(product,"#i2_tasa")
        i3_tasa = @@(product,"#i3_tasa")
        i4_tasa = @@(product,"#i4_tasa")

        subtotal = (costo * cantidad)
        sub_desc = (subtotal - descuentos)
        impuesto1 = (sub_desc * i1_tasa)
        impuesto2 = (sub_desc * i2_tasa)
        i1_i2 = (impuesto1 + impuesto2)
        sub_desc_i1_i2 = (sub_desc + i1_i2)
        impuesto3 = (sub_desc_i1_i2 * i3_tasa)
        impuesto4 = (sub_desc_i1_i2 * i4_tasa)
        i3_i4 = (impuesto3 + impuesto4)
        impuestos = (i1_i2 + i3_i4)
        total = (sub_desc + impuestos)

        new taxes
        {
            @"costo": costo
            @"cantidad": cantidad
            @"subtotal": subtotal
            @"descuentos": descuentos
            @"impuestos": impuestos
            @"total": total
            @"impuesto1": impuesto1
            @"impuesto2": impuesto2
            @"impuesto3": impuesto3
            @"impuesto4": impuesto4
        }

        return taxes
    }

    req.setStockKeeping::&db,&params,&data
    {
        ref products = req.getStockKeepingProducts(db,params)
        ref dcmpreq = list.create()

        subtotal = 0.00
        impuestos = 0.00

        for i = 0; i < list.count(products); i+1
        {
            ref product = list.obj(products,i)
            product<"cantidad"> : @@(product,"#cantidad_2")

            if @@(product,"#cantidad") > 0
            {
                ref taxes = req.calculateTaxes(product)

                new item
                {
                    @"producto": @@(product,"#sys_pk")
                    @"cantidad": @@(taxes,"#cantidad")
                    @"unidad": @@(product,"$unidada")
                    @"precio": @@(taxes,"#costo")
                    @"impuestos": @@(taxes,"#impuestos")
                    @"excluido": @false
                    @"notas": ""
                }

                subtotal = subtotal + @@(taxes,"#subtotal")
                impuestos = impuestos + @@(taxes,"#impuestos")
                do list.add(dcmpreq,item)
            }
        }

        data<"subtotal"> : subtotal
        data<"impuestos"> : impuestos
        data<"_detalle*"> : dcmpreq

        using @childs
        {
            member "_detalle"
            {
                @"joinfield": "ref_req"
                @"keyfield": "sys_pk"
                @"table": "dcmpreq"
                @"select_query": "SELECT NULL"
                @"fields": "producto,cantidad,unidad,precio,impuestos,excluido,notas"
            }
        }
    }

    req.list::&db,&params
    {
        do evaluateFilters(params)

        new data
        {
            @"requisiciones*": entity.list(db,params)
        }
        do prepareList(db,params,data)

        return data
    }

    req.read::&db,&params
    {
        new data
        {
            @"cmpreq*": entity.read(db,params)
        }
        do prepareView(db,params,data)

        return data
    }

    req.blank::&db,&params
    {
        new data {}
        do prepareView(db,params,data)

        return data
    }

    req.create::&db,&params,&data
    {
        @use_transaction = @false
        
        serie = trim(@@(data,"$serie"))
        folio = abs(@@(data,"#folio"))

        do dbr.begin(db)

        iblock = dbr.folios.id_block(db,@cRequisicion,serie)
        if folio > 0 { folio = dbr.folios.set_new(db,iblock,folio,3) }
        else { folio = dbr.folios.set_new(db,iblock,dbr.folios.get_new(db,iblock),3) }
        ref infoFolio = dbr.folios.info(db,iblock,folio)

        referencia = serie + padleft(str(folio),6,"0")

        new cmpreq
        {
            @"sys_user": @@(@http_context, "$session/user/uid")

            @"partida": @@(data,"#partida")
            @"periodo": @@(data,"#periodo")
            @"referencia": referencia
            @"folio": @@(infoFolio,"#sys_pk")
            @"fecha*": str2dt(trim(@@(data,"$fecha")))
            @"flimite*": @null
            @"subtotal": 0
            @"impuestos": 0
            @"divisa": @@(data,"#divisa")
            @"tcambio": @@(data,"#tcambio")
            @"status": @@(data,"#status")
            @"ucreo": lib.GetPkUsr(db,@@(@http_context, "$session/user/uid"))
            @"tipo": @@(data,"#tipo")
        }

        if trim(@@(data,"$flimite")) != "" { cmpreq<"flimite*"> : str2dt(trim(@@(data,"$flimite"))) }
        
        if @@(data,"#tipo") == @type_req_gop
        {
            cmpreq<"notas"> : "Requisición directa para gastos de operación."
        }
        if @@(data,"#tipo") == @type_req_stock
        {
            do field.remove(cmpreq,"partida")
            do field.remove(cmpreq,"periodo")

            cmpreq<"notas"> : "Requisición directa para mantenimiento de stock."
            cmpreq<"almacen"> : @@(data,"#almacen")

            ref filters = record.copy(data,"almacen,fil_clase,fil_linea,fil_marca,fil_depto,fil_gv,fil_prod_below,fil_prod_until")
            do req.setStockKeeping(db,filters,cmpreq)
        }
        if @@(data,"#tipo") == @type_req_gral
        {
            do field.remove(cmpreq,"partida")
            do field.remove(cmpreq,"periodo")

            cmpreq<"notas"> : "Requisición directa para previsión en general."
        }
        
        ref entity = @@(entity.create(db,params,cmpreq),"&cmpreq")

        do dbr.commit(db)

        @url_redir = path.concat(@CMP_REQUISICION, @@(entity,"$sys_pk") + "/")

        exception
        {
            do errordet(@false)
            if dbr.in_transaction(db) { do dbr.rollback(db) }

            ref FormData = record.copy(data,"*")
            code = last_error_code()
            error = last_error()

            do record.clear(data)
            data<"form*"> : FormData

            do prepareView(db,params,data)
            do rise_error(code,error)
        }
    }

    req.update::&db,&params,&data
    {
        @use_transaction = @false

        do dbr.begin(db)

        new cmpreq
        {
            @"sys_timestamp*": now()
            @"sys_lastuser": @@(@http_context, "$session/user/uid")
            @"sys_recver": @@(data,"#sys_recver")

            @"periodo": @@(data,"#periodo")
            @"fecha*": str2dt(trim(@@(data,"$fecha")))
            @"flimite*": @null
            @"subtotal": 0
            @"impuestos": 0
            @"tcambio": @@(data,"#tcambio")
            @"notas": trim(@@(data,"$notas"))
        }

        if trim(@@(data,"$flimite")) != "" { cmpreq<"flimite*"> : str2dt(trim(@@(data,"$flimite"))) }

        // 1 - $ | 2 - # | 3 - * | 0 - not exist
        if field.typeof(data,"_detalle") == 1
        {
            ref _detalle = from.json(@@(data,"_detalle"))
            ref dcmpreq = list.create()

            subtotal = 0
            impuestos = 0

            for i = 0; i < list.count(_detalle)
            {
                ref producto = list.obj(_detalle,i)

                new d
                {
                    @"producto": @@(producto,"#producto")
                    @"cantidad": @@(producto,"#cantidad")
                    @"unidad": @@(producto,"$unidad")
                    @"precio": @@(producto,"#precio")
                    @"impuestos": (@@(producto,"#impuesto1") + @@(producto,"#impuesto2") + @@(producto,"#impuesto3") + @@(producto,"#impuesto4"))
                    @"excluido": parse.bool(@@(producto,"$excluido"))
                    @"notas": @@(producto,"$notas")
                }
                do list.add(dcmpreq,d)

                subtotal = subtotal + @@(producto,"#subtotal")
                impuestos = impuestos + @@(d,"#impuestos")
            }

            cmpreq<"subtotal"> : subtotal
            cmpreq<"impuestos"> : impuestos
            cmpreq<"_detalle*"> : dcmpreq
        }

        using @childs
        {
            member "_detalle"
            {
                @"joinfield": "ref_req"
                @"keyfield": "sys_pk"
                @"table": "dcmpreq"
                @"select_query": "SELECT NULL"
                @"fields": "producto,cantidad,unidad,precio,impuestos,excluido,notas"
            }
        }

        ref entity = @@(entity.update(db,params,cmpreq),"&cmpreq")

        do dbr.commit(db)

        exception
        {
            do errordet(@false)
            if dbr.in_transaction(db) { do dbr.rollback(db) }

            ref FormData = record.copy(data,"*")
            code = last_error_code()
            error = last_error()

            do record.clear(data)
            data<"form*"> : FormData

            do prepareView(db,params,data)
            do rise_error(code,error)
        }
    }

    req.delete::&db,&params
    {
        do rise_error(500,"Acción no implementada")
    }
}