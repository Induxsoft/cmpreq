#include "dkli.dkh"
#!
module ""
{
    @table_name = "cmpreq"
    @sys_fields = "sys_pk,sys_guid,sys_dtcreated,sys_timestamp,sys_info,sys_user,sys_lastuser,sys_exported,sys_dtexported,sys_recver,sys_deleted,sys_lock"

    @create_fields = @sys_fields + ",fecha,flimite,partida,periodo,referencia,folio,ucreo,uaprobo,status,notas,consolidacion,en,subtotal,impuestos,divisa,tcambio"
    @update_fields = @sys_fields + ",fecha,flimite,periodo,uaprobo,status,notas,en,subtotal,impuestos,tcambio"
    @create_exclude_fields = "sys_lastuser"
    @update_exclude_fields = "sys_pk,sys_guid,sys_dtcreated,sys_user,status"

    @list_query = "
    SELECT
        req.sys_pk,
        req.sys_guid,
        req.referencia,
        DATE_FORMAT(req.fecha,'%Y-%m-%d') AS fecha,
        IFNULL(DATE_FORMAT(req.flimite,'%Y-%m-%d'),'') AS flimite,
        CONCAT('$',FORMAT(req.subtotal,4)) AS subtotal,
        CONCAT('$',FORMAT(req.impuestos,4)) AS impuestos,
        CONCAT('$',FORMAT((req.subtotal + req.impuestos),4)) AS total,
        IF(req.consolidacion,'C','D') AS tipo,
        IFNULL(con.referencia,'') AS consolidadoen,
        IFNULL(pda.partida,'') AS partida,
        stt.const AS `status`,
        dvs.codigo AS `divisa`
    FROM #<@table_name> AS req
        LEFT JOIN #<@table_name> AS con ON con.sys_pk = req.en
        LEFT JOIN gop_partida AS pda ON pda.sys_pk = req.partida
        INNER JOIN cmpreq_status AS stt ON stt.id = req.`status`
        INNER JOIN divisa AS dvs ON dvs.sys_pk = req.`divisa`
    WHERE NOT IFNULL(req.sys_deleted,0)
    #<conditions>
    LIMIT #<@default_max_rows>
    "

    @read_query = "
    SELECT
        req.sys_pk,
        req.sys_guid,
        req.sys_recver,
        req.referencia,
        DATE_FORMAT(req.fecha,'%Y-%m-%d') AS fecha,
        IFNULL(DATE_FORMAT(req.flimite,'%Y-%m-%d'),'') AS flimite,
        req.subtotal,
        req.impuestos,
        (req.subtotal + req.impuestos) AS importe,
        req.periodo,
        req.tcambio,
        req.`status`,
        IFNULL(req.notas,'') AS notas,
        IFNULL(pda.partida,'') AS partida_pre,
        IFNULL(pto.ejercicio,'') AS ejercicio,
        IFNULL(CONCAT('[',uni.codigo,'] ',uni.descripcion),'') AS unidad_org,
        CONCAT(dvs.codigo,' [',dvs.descripcion,']') AS ddivisa,
        stt.const AS cstatus,
        dvs.codigo AS cdivisa
    FROM #<@table_name> AS req
        LEFT JOIN gop_partida AS pda ON pda.sys_pk = req.partida
        LEFT JOIN gop_presupuesto AS pto ON pto.sys_pk = pda.ref_presupuesto
        LEFT JOIN rh_unidad_org AS uni ON uni.sys_pk = pto.ref_unidad
        INNER JOIN cmpreq_status AS stt ON stt.id = req.`status`
        INNER JOIN divisa AS dvs ON dvs.sys_pk = req.`divisa`
    WHERE req.#<@keyfield> = @_entity_id
    "

    @childs_query = "
    SELECT
    -- Campos visibles en el editable
        p.codigo AS edt_codigo,
        p.descripcion AS edt_descripcion,
        d.unidad AS edt_unidad,
        d.precio AS edt_precio,
        d.cantidad AS edt_cantidad,
        (d.precio * d.cantidad) AS edt_subtotal,
        0 AS edt_descuentos,
        d.impuestos AS edt_impuestos,
        ((d.cantidad * d.precio) + d.impuestos) AS edt_importe,
        d.notas AS edt_notas,
    -- Campos para el insert
        d.producto,
        d.cantidad,
        d.unidad,
        d.precio,
        d.impuestos,
        IFNULL(d.excluido,0) AS excluido,
        IFNULL(d.notas,'') AS notas,
    -- Campos extras para operaciones
        (d.precio * d.cantidad) AS subtotal,
        0 AS descuentos,
        ((d.cantidad * d.precio) + d.impuestos) AS importe,
        (CONVERT(REPLACE(SUBSTRING_INDEX(i.i1compra, '|', @zimpuesto),'%',''), DECIMAL) / 100) AS i1_tasa,
        (CONVERT(REPLACE(SUBSTRING_INDEX(i.i1compra, '|', @zimpuesto),'%',''), DECIMAL) / 100) AS i2_tasa,
        (CONVERT(REPLACE(SUBSTRING_INDEX(i.i3compra, '|', @zimpuesto),'%',''), DECIMAL) / 100) AS i3_tasa,
        (CONVERT(REPLACE(SUBSTRING_INDEX(i.i4compra, '|', @zimpuesto),'%',''), DECIMAL) / 100) AS i4_tasa,
        TRIM(p.unidad) AS unidada,
        TRIM(IFNULL(p.unidadb,'')) AS unidadb,
        TRIM(IFNULL(p.unidadc,'')) AS unidadc,
        TRIM(IFNULL(p.unidadd,'')) AS unidadd,
        TRIM(IFNULL(p.unidade,'')) AS unidade,
        IFNULL(p.factorb,0) AS factorb,
        IFNULL(p.factorc,0) AS factorc,
        IFNULL(p.factord,0) AS factord,
        IFNULL(p.factore,0) AS factore
    FROM dcmpreq AS d
        INNER JOIN producto AS p ON p.sys_pk = d.producto
        INNER JOIN cfgimpuesto AS i ON i.sys_pk = p.impuestos
    WHERE d.ref_req = @_entity_id
    "

    buscarUnidad::&db,&params
    {
        sql = "
        SELECT
            sys_pk,
            sys_guid,
            codigo,
            descripcion
        FROM rh_unidad_org
        WHERE #<condition>
        "
        if trim(@@(params,"$id")) != ""
        {
            condition = "(sys_pk = @id OR sys_guid = @id)"
            return dbr.rec(db,ftext(sql),params)
        }
        if trim(@@(params,"$search")) != ""
        {
            condition = "(codigo LIKE CONCAT('%',@search,'%') OR descripcion LIKE CONCAT('%',@search,'%'))"
            return dbr.list(db,ftext(sql),params)
        }
        return list.create()
    }

    buscarPartida::&db,&params
    {
        sql = "
        SELECT
            pda.sys_pk,
            pda.sys_guid,
            pda.id,
            pda.partida
        FROM gop_partida AS pda
            INNER JOIN gop_presupuesto AS pto ON pto.sys_pk = pda.ref_presupuesto
            INNER JOIN rh_unidad_org AS uni ON uni.sys_pk = pto.ref_unidad
        WHERE #<condition>
        "
        if trim(@@(params,"$id")) != ""
        {
            condition = "(pda.sys_pk = @id OR pda.sys_guid = @id)"
            return dbr.rec(db,ftext(sql),params)
        }
        if trim(@@(params,"$search")) != ""
        {
            condition = "(pda.id LIKE CONCAT('%',@search,'%') OR pda.partida LIKE CONCAT('%',@search,'%'))"
            condition = condition + " AND pto.ejercicio = @ejercicio AND uni.sys_pk = @iunidad"
            condition = condition + " AND (select count(sys_pk) from gop_partida where padre = pda.sys_pk) = 0"
            
            return dbr.list(db,ftext(sql),params)
        }
        return list.create()
    }

    buscarProducto::&db,&params
    {
        do setZonaImpuesto(db,params)
        
        sql = "
        SELECT
            p.sys_pk,
            p.sys_guid,
            p.codigo,
            p.descripcion,
            TRIM(p.unidad) AS unidada,
            TRIM(IFNULL(p.unidadb,'')) AS unidadb,
            TRIM(IFNULL(p.unidadc,'')) AS unidadc,
            TRIM(IFNULL(p.unidadd,'')) AS unidadd,
            TRIM(IFNULL(p.unidade,'')) AS unidade,
            IFNULL(p.factorb,0) AS factorb,
            IFNULL(p.factorc,0) AS factorc,
            IFNULL(p.factord,0) AS factord,
            IFNULL(p.factore,0) AS factore,
            p.costoultimo AS precio,
            1 AS cantidad,
            0 AS descuentos,
            IFNULL(p.existencia,0) AS existencia,
            dvs.codigo AS `divisa`,
            dvs.tcambio AS tipocambio,
            imp.nombre AS conf_impuestos,
            IFNULL(imp.uf_tipoi1,'') AS i1_txt,
            (CONVERT(REPLACE(SUBSTRING_INDEX(imp.i1compra, '|', @zimpuesto),'%',''), DECIMAL) / 100) AS i1_tasa,
            IFNULL(imp.uf_tipoi2,'') AS i2_txt,
            (CONVERT(REPLACE(SUBSTRING_INDEX(imp.i1compra, '|', @zimpuesto),'%',''), DECIMAL) / 100) AS i2_tasa,
            IFNULL(imp.uf_tipoi3,'') AS i3_txt,
            (CONVERT(REPLACE(SUBSTRING_INDEX(imp.i3compra, '|', @zimpuesto),'%',''), DECIMAL) / 100) AS i3_tasa,
            IFNULL(imp.uf_tipoi4,'') AS i4_txt,
            (CONVERT(REPLACE(SUBSTRING_INDEX(imp.i4compra, '|', @zimpuesto),'%',''), DECIMAL) / 100) AS i4_tasa
        FROM producto AS p
            INNER JOIN divisa AS dvs ON dvs.sys_pk = p.idivisa
            INNER JOIN cfgimpuesto AS imp ON imp.sys_pk = p.impuestos
        WHERE (p.codigo LIKE CONCAT('%',@search,'%') OR p.descripcion LIKE CONCAT('%',@search,'%'))
        "
        
        return dbr.list(db,sql,params)
    }

    obtenerFultimo::&db,&params
    {
        new data
        {
            @"fultimo": dbr.folios.get_new(db,@@(params,"#_entity_id"))
        }
        return data
    }

    obtenerUnidad::&db,id
    {
        new params { @"id": id }
        return buscarUnidad(db,params)
    }

    obtenerPartida::&db,id
    {
        new params { @"id": id }
        return buscarPartida(db,params)
    }

    obtenerPkUsr::&db,id
    {
        new params { @"id": id }
        return dbr.num(db,"SELECT sys_pk FROM tuser WHERE sys_pk = @id OR sys_guid = @id OR userid = @id",params)
    }

    setZonaImpuesto::&db,&params
    {
        /**
        * Zona de impuesto
        * 1 => 1 = cInterior
        * 2 => -1 = cFrontera
        */
        
        zimpuesto = dbr.vars.getd(db,"cmpreq_zimpuesto","1")
        if parse.num(zimpuesto) > 1 { zimpuesto = "-1" }
        params<"zimpuesto"> : zimpuesto
    }

    prepareList::&db,&params,&data
    {
        data<"list_status*"> : dbr.list(db,"SELECT * FROM cmpreq_status",@null)
    }

    prepareView::&db,&params,&data
    {
        isNew = (@@(params,"$_entity_id") == "_new")

        if isNew
        {
            ref fd = ifnull(@@(data,"&form"),record.create())
            new args
            {
                @"cRequisicion": @cRequisicion
            }

            if @@(fd,"#unidad_org") > 0 { data<"dt_unidad_org*"> : obtenerUnidad(db,@@(fd,"#unidad_org")) }
            if @@(fd,"#partida") > 0 { data<"dt_partida_pre*"> : obtenerPartida(db,@@(fd,"#partida")) }

            data<"list_series*"> : dbr.list(db,"SELECT sys_pk, serie FROM blockdocumentos WHERE NOT IFNULL(sys_deleted,0) AND activo AND documento = @cRequisicion",args)
            data<"list_status*"> : dbr.list(db,"SELECT * FROM cmpreq_status WHERE id <= 10",@null)
            data<"list_divisas*"> : dbr.list(db,"SELECT sys_pk, codigo, tcambio, CONCAT(codigo,' [',descripcion,']') AS `text` FROM divisa WHERE NOT IFNULL(sys_deleted,0)",@null)
        }
        else
        {
            do setZonaImpuesto(db,params)

            if not(field.exist(data,"cmpreq")) { data<"cmpreq*"> : entity.read(db,params) }
            data<"dcmpreq*"> : dbr.list(db,@childs_query,params)
        }
    }

    evaluateFilters::&params
    {
        conditions = ""

        if replace(@@(params,"$fil_status"),"*","") != "" { conditions = conditions + "AND req.`status` = @fil_status" }

        if trim(@@(params,"$fil_text")) != "" {
            conditions = conditions + "AND (req.referencia LIKE CONCAT('%',@fil_text,'%') OR IFNULL(pda.partida,'') LIKE CONCAT('%',@fil_text,'%'))"
        }

        // filter-date-range [start]
        new req_date_fields
        {
            @"1": "req.fecha" // Elaboración
            @"2": "req.flimite" // Vencimiento
        }
        
        fdr_field = @@(req_date_fields,str(@@(params,"#fil_fdr_field")))

        switch @@(params,"$fdr_mode")
        {
            case "month"
            {
                curr_ndt = ndatetime.now()
                curr_year = ndatetime.year(curr_ndt)
                curr_month = ndatetime.month(curr_ndt)
                curr_day = ndatetime.day(curr_ndt)

                if not(field.exist(params,"fdr_year")) { params<"fdr_year"> : curr_year }
                if not(field.exist(params,"fdr_month")) { params<"fdr_month"> : curr_month }

                conditions = conditions + " AND YEAR(#<fdr_field>) = @fdr_year AND MONTH(#<fdr_field>) = @fdr_month"
                break
            }
            case "lastdays"
            {
                if not(field.exist(params,"fdr_range")) { params<"fdr_range"> : 30 } // Últimos 30 días

                conditions = conditions + " AND DATE(#<fdr_field>) BETWEEN ADDDATE(DATE(NOW()), INTERVAL -@fdr_range DAY) AND DATE(NOW())"
                break
            }
            case "range"
            {
                if not(field.exist(params,"fdr_from"))
                {
                    curr_ndt = ndatetime.now()
                    subt_ndt = ndatetime.add(curr_ndt, -30, "d")
                    ult_30_days = ndatetime.tostr(subt_ndt, "yyyy-MM-dd")

                    params<"fdr_from"> : ult_30_days
                }
                if not(field.exist(params,"fdr_to")) { params<"fdr_to"> : hoy("yyyy-MM-dd") }

                if trim(@@(params,"$fdr_from")) != "" && trim(@@(params,"$fdr_to")) != ""
                {
                    conditions = conditions + " AND DATE(#<fdr_field>) BETWEEN @fdr_from AND @fdr_to"
                }
                else if trim(@@(params,"$fdr_from")) != "" && trim(@@(params,"$fdr_to")) == ""
                {
                    conditions = conditions + " AND DATE(#<fdr_field>) >= @fdr_from"
                }
                else if trim(@@(params,"$fdr_from")) == "" && trim(@@(params,"$fdr_to")) != ""
                {
                    conditions = conditions + " AND DATE(#<fdr_field>) <= @fdr_to"
                }

                break
            }
        }
        // filter-date-range [end]

        conditions = ftext(conditions)
        @list_query = ftext(@list_query)
    }

    req.list::&db,&params
    {
        do evaluateFilters(params)

        new data
        {
            @"requisiciones*": entity.list(db,params)
        }
        do prepareList(db,params,data)

        return data
    }

    req.read::&db,&params
    {
        new data
        {
            @"cmpreq*": entity.read(db,params)
        }
        do prepareView(db,params,data)

        return data
    }

    req.blank::&db,&params
    {
        new data {}
        do prepareView(db,params,data)

        return data
    }

    req.create::&db,&params,&data
    {
        @use_transaction = @false
        
        serie = trim(@@(data,"$serie"))
        folio = abs(@@(data,"#folio"))

        do dbr.begin(db)

        iblock = dbr.folios.id_block(db,@cRequisicion,serie)
        if folio > 0 { folio = dbr.folios.set_new(db,iblock,folio,3) }
        else { folio = dbr.folios.set_new(db,iblock,dbr.folios.get_new(db,iblock),3) }
        ref infoFolio = dbr.folios.info(db,iblock,folio)

        referencia = serie + padleft(str(folio),6,"0")

        new cmpreq
        {
            @"sys_user": @@(@http_context, "$session/user/uid")

            @"partida": @@(data,"#partida")
            @"periodo": @@(data,"#periodo")
            @"referencia": referencia
            @"folio": @@(infoFolio,"#sys_pk")
            @"fecha*": str2dt(trim(@@(data,"$fecha")))
            @"flimite*": @null
            @"subtotal": 0
            @"impuestos": 0
            @"divisa": @@(data,"#divisa")
            @"tcambio": @@(data,"#tcambio")
            @"status": @@(data,"#status")
            @"ucreo": obtenerPkUsr(db,@@(@http_context, "$session/user/uid"))
        }

        if trim(@@(data,"$flimite")) != "" { cmpreq<"flimite*"> : str2dt(trim(@@(data,"$flimite"))) }
        
        ref entity = @@(entity.create(db,params,cmpreq),"&cmpreq")

        do dbr.commit(db)

        @url_redir = path.concat(@CMP_REQUISICION, @@(entity,"$sys_pk") + "/")

        exception
        {
            do errordet(@false)
            if dbr.in_transaction(db) { do dbr.rollback(db) }

            ref FormData = record.copy(data,"*")
            code = last_error_code()
            error = last_error()

            do record.clear(data)
            data<"form*"> : FormData

            do prepareView(db,params,data)
            do rise_error(code,error)
        }
    }

    req.update::&db,&params,&data
    {
        @use_transaction = @false

        do dbr.begin(db)

        new cmpreq
        {
            @"sys_timestamp*": now()
            @"sys_lastuser": @@(@http_context, "$session/user/uid")
            @"sys_recver": @@(data,"#sys_recver")

            @"periodo": @@(data,"#periodo")
            @"fecha*": str2dt(trim(@@(data,"$fecha")))
            @"flimite*": @null
            @"subtotal": 0
            @"impuestos": 0
            @"tcambio": @@(data,"#tcambio")
            @"notas": trim(@@(data,"$notas"))
        }

        if trim(@@(data,"$flimite")) != "" { cmpreq<"flimite*"> : str2dt(trim(@@(data,"$flimite"))) }

        // 1 - $ | 2 - # | 3 - * | 0 - not exist
        if field.typeof(data,"_detalle") == 1
        {
            ref _detalle = from.json(@@(data,"_detalle"))
            ref dcmpreq = list.create()

            subtotal = 0
            impuestos = 0

            for i = 0; i < list.count(_detalle)
            {
                ref producto = list.obj(_detalle,i)

                new d
                {
                    @"producto": @@(producto,"#producto")
                    @"cantidad": @@(producto,"#cantidad")
                    @"unidad": @@(producto,"$unidad")
                    @"precio": @@(producto,"#precio")
                    @"impuestos": (@@(producto,"#impuesto1") + @@(producto,"#impuesto2") + @@(producto,"#impuesto3") + @@(producto,"#impuesto4"))
                    @"excluido": parse.bool(@@(producto,"$excluido"))
                    @"notas": @@(producto,"$notas")
                }
                do list.add(dcmpreq,d)

                subtotal = subtotal + @@(producto,"#subtotal")
                impuestos = impuestos + @@(d,"#impuestos")
            }

            cmpreq<"subtotal"> : subtotal
            cmpreq<"impuestos"> : impuestos
            cmpreq<"_detalle*"> : dcmpreq
        }

        using @childs
        {
            member "_detalle"
            {
                @"joinfield": "ref_req"
                @"keyfield": "sys_pk"
                @"table": "dcmpreq"
                @"select_query": "SELECT NULL"
                @"fields": "producto,cantidad,unidad,precio,impuestos,excluido,notas"
            }
        }

        ref entity = @@(entity.update(db,params,cmpreq),"&cmpreq")

        do dbr.commit(db)

        exception
        {
            do errordet(@false)
            if dbr.in_transaction(db) { do dbr.rollback(db) }

            ref FormData = record.copy(data,"*")
            code = last_error_code()
            error = last_error()

            do record.clear(data)
            data<"form*"> : FormData

            do prepareView(db,params,data)
            do rise_error(code,error)
        }
    }

    req.delete::&db,&params
    {
        do rise_error(500,"Acción no implementada")
    }
}