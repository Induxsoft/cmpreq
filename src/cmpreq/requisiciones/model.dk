#include "dkli.dkh"
#!
module "Requisiciones :req"
{
    #include "webcl.dkh"
    if file.exists("dprod/orden/model.dk") {
        #include "dprod/orden/model.dk"
    }

    setGlobalConfigs::
    {
        @table_name = "cmpreq"
        @keyfield = "sys_pk"
        @sys_fields = "sys_pk,sys_guid,sys_dtcreated,sys_timestamp,sys_info,sys_user,sys_lastuser,sys_exported,sys_dtexported,sys_recver,sys_deleted,sys_lock"
        
        @create_fields = @sys_fields + ",tipo,referencia,folio,fecha,flimite,almacen,unidad_org,ejercicio,partida,periodo,divisa,tcambio,status,notas,subtotal,impuestos,consolidacion,en,cc,origen,ucreo,uaprobo"
        @update_fields = @sys_fields + ",fecha,flimite,tcambio,status,notas,subtotal,impuestos,en,uaprobo"
        
        @create_exclude_fields = "sys_lastuser"
        @update_exclude_fields = "sys_pk,sys_guid,sys_dtcreated,sys_user,status"
        
        @create_alias_fields = ""
        @update_alias_fields = ""
        
        @list_query = @qry_list_cmpreq
        @read_query = @qry_cmpreq
    }
    do setGlobalConfigs()

    buscarUnidad::&db,&params
    {
        if trim(@@(params,"$id")) != ""
        {
            conditions = "AND (sys_pk = @id OR sys_guid = @id)"
            return dbr.rec(db,ftext(@qry_buscar_unidad),params)
        }
        if trim(@@(params,"$search")) != ""
        {
            conditions = "
                AND NOT IFNULL(sys_deleted,0)
                AND (codigo = @search OR descripcion LIKE CONCAT('%',@search,'%'))
            "
            return dbr.list(db,ftext(@qry_buscar_unidad),params)
        }

        return list.create()
    }

    buscarPartida::&db,&params
    {
        if trim(@@(params,"$id")) != ""
        {
            conditions = "AND (pda.sys_pk = @id OR pda.sys_guid = @id)"
            return dbr.rec(db,ftext(@qry_buscar_partida),params)
        }
        if trim(@@(params,"$search")) != ""
        {
            joins = "
                INNER JOIN gop_presupuesto AS pto ON pto.sys_pk = pda.ref_presupuesto
                INNER JOIN rh_unidad_org AS uni ON uni.sys_pk = pto.ref_unidad
            "

            conditions = "
                AND NOT IFNULL(pda.sys_deleted,0)
                AND pto.ejercicio = @ejercicio
                AND uni.sys_pk = @iunidad
                AND (select count(sys_pk) from gop_partida where padre = pda.sys_pk) = 0
                AND (pda.id LIKE CONCAT('%',@search,'%') OR pda.partida LIKE CONCAT('%',@search,'%'))
            "
            return dbr.list(db,ftext(@qry_buscar_partida),params)
        }

        return list.create()
    }

    buscarProducto::&db,&params
    {
        do setZonaImpuesto(db,params)
        
        conditions = "
            AND NOT IFNULL(p.sys_deleted,0)
            AND (p.codigo = @search OR p.descripcion LIKE CONCAT('%',@search,'%'))
        "
        
        return dbr.list(db,ftext(@qry_buscar_producto),params)
    }

    //#region buscarCProduccion()
    buscarCProduccion::&db,&params
    {
        if dbr.str(db,"SHOW TABLES LIKE 'cproduccion';",@null) == "" { return list.create() }
        A = 0 //Centros de producción asociados al producto
        B = 0 //Centros de producción asociados al centro de consumo
        
        if dbr.str(db,"SHOW TABLES LIKE 'cproduccion_producto_';",@null) != "" {
            A = dbr.num(db,"SELECT COUNT(*) FROM cproduccion_producto_ WHERE icentrosproduccion = @iproducto",params)
        }
        if dbr.str(db,"SHOW TABLES LIKE 'cconsumo_cproduccion_';",@null) != "" {
            B = dbr.num(db,"SELECT COUNT(*) FROM cconsumo_cproduccion_ WHERE iconsumo = @icconsumo",params)
        }

        if A > 0
        { 
            if B > 0
            {
                sql_cp_p_cc = "
                SELECT
                    cp.sys_pk,
                    cp.codigo,
                    cp.descripcion
                FROM cproduccion cp
                    INNER JOIN cproduccion_producto_ cpp ON cpp.icentrosproduccion = cp.sys_pk
                    INNER JOIN cconsumo_cproduccion_ cpcc ON cpcc.icproduccion = cp.sys_pk
                WHERE
                    NOT IFNULL(cp.sys_deleted,0)
                    AND cpp.iproductos = @iproducto
                    AND cpcc.iconsumo = @icconsumo
                    AND (cp.codigo = @search OR cp.descripcion LIKE CONCAT('%',@search,'%'))
                "
                return dbr.list(db,sql_cp_p_cc,params)
            }
            else
            {
                sql_cp_p = "
                SELECT
                    cp.sys_pk,
                    cp.codigo,
                    cp.descripcion
                FROM cproduccion_producto_ cpp
                    INNER JOIN cproduccion cp ON cpp.icentrosproduccion = cp.sys_pk
                WHERE
                    NOT IFNULL(cp.sys_deleted,0)
                    AND cpp.iproductos = @iproducto
                    AND (cp.codigo = @search OR cp.descripcion LIKE CONCAT('%',@search,'%'))
                "
                return dbr.list(db,sql_cp_p,params)
            }
        }
        else
        {
            if B > 0
            {
                sql_cp_cc = "
                SELECT
                    cp.sys_pk,
                    cp.codigo,
                    cp.descripcion
                FROM cconsumo_cproduccion_ cpcc
                    INNER JOIN cproduccion cp ON cpcc.icproduccion = cp.sys_pk
                WHERE
                    NOT IFNULL(cp.sys_deleted,0)
                    AND cpcc.iconsumo = @icconsumo
                    AND (cp.codigo = @search OR cp.descripcion LIKE CONCAT('%',@search,'%'))
                "
                return dbr.list(db,sql_cp_cc,params)
            }
            else
            {
                sql_cp = "
                SELECT
                    sys_pk,
                    codigo,
                    descripcion
                FROM cproduccion
                WHERE
                    NOT IFNULL(sys_deleted,0)
                    AND (codigo = @search OR descripcion LIKE CONCAT('%',@search,'%'))
                "
                return dbr.list(db,sql_cp,params)
            }
        }
    }

    obtenerFultimo::&db,&params
    {
        new data
        {
            @"fultimo": dbr.folios.get_new(db,@@(params,"#_entity_id"))
        }
        return data
    }

    obtenerLineaXClase::&db,&params
    {
        return dbr.list(db,"SELECT sys_pk, codigo, descripcion FROM linea WHERE NOT IFNULL(sys_deleted,0) AND clase = @iclase",params)
    }

    obtenerUnidad::&db,id
    {
        new params { @"id": id }
        return buscarUnidad(db,params)
    }

    obtenerPartida::&db,id
    {
        new params { @"id": id }
        return buscarPartida(db,params)
    }

    setZonaImpuesto::&db,&params
    {
        /**
        * Zona de impuesto
        * 1 => 1 = cInterior
        * 2 => -1 = cFrontera
        */
        
        zimpuesto = dbr.vars.getd(db,"cmpreq_zimpuesto","1")
        if parse.num(zimpuesto) > 1 { zimpuesto = "-1" }
        params<"zimpuesto"> : zimpuesto
    }

    
    //#region setGParams()
    setGParams::&db,&params
    {
        if not(field.exist(params,"currency_decs")){ params<"currency_decs"> : parse.num(dbr.vars.get(db,"FXCA001")) }
        if not(field.exist(params,"volume_decs")){ params<"volume_decs"> : parse.num(dbr.vars.get(db,"FXCA002")) }
        if not(field.exist(params,"visible_currency_decs")){ params<"visible_currency_decs"> : parse.num(dbr.vars.get(db,"V12-0A-001")) }
        if not(field.exist(params,"visible_volume_decs")){ params<"visible_volume_decs"> : parse.num(dbr.vars.get(db,"V12-0A-002")) }
        if not(field.exist(params,"divisa")){ params<"divisa"> : parse.num(dbr.vars.get(db,"FXCA013")) }
        if not(field.exist(params,"pais")){ params<"pais"> : parse.num(dbr.vars.get(db,"V12-00-001")) }
        if not(field.exist(params,"idioma")){ params<"idioma"> : parse.num(dbr.vars.get(db,"V12-00-002")) }
    }

    //#region setPrintTitles()
    setPrintTitles::&db,&data
    {
        using data
        {
            member @"titles"
            {
                @"title": dbr.vars.getd(db,"FXCA108","")
                @"subtitle": dbr.vars.getd(db,"FXCA109","")
                @"subtitle_2": dbr.vars.getd(db,"FXCA110","")
                @"footer": dbr.vars.getd(db,"FXCA111","")
            }
        }
    }

    //#region prepareView()
    prepareView::&db,&params,&data
    {
        isNew = (@@(params,"$_entity_id") == "_new")
        view =  @@(params,"$_view")

        if not(isNew)
        {
            do setGlobalConfigs()
            do setGParams(db,params)
            do setZonaImpuesto(db,params)

            if not(field.exist(data,"cmpreq")) { data<"cmpreq*"> : entity.read(db,params) }
        }

        if isNew
        {
            ref fd = ifnull(@@(data,"&form"),record.create())
            new args
            {
                @"doctype": @cRequisicion
            }

            if @@(fd,"#unidad_org") > 0 { data<"dt_unidad_org*"> : obtenerUnidad(db,@@(fd,"#unidad_org")) }
            if @@(fd,"#partida") > 0 { data<"dt_partida_pre*"> : obtenerPartida(db,@@(fd,"#partida")) }

            using data
            {
                @"list_tipos*": dbr.list(db,"SELECT * FROM cmpreq_type WHERE id != 4",@null)
                @"list_series*": dbr.list(db, @qry_list_series, args)
                @"list_status*": dbr.list(db,"SELECT * FROM cmpreq_status WHERE id < 10",@null)
                @"list_divisas*": dbr.list(db, @qry_list_divisas, @null)
                @"list_csurtido*": dbr.list(db,"SELECT b.sys_pk, b.descripcion FROM cmpreq_cc a INNER JOIN cconsumo b ON a.cc = b.sys_pk",@null)
                @"list_almacenes*": dbr.list(db,"SELECT sys_pk, codigo, descripcion FROM almacen WHERE NOT IFNULL(sys_deleted,0)",@null)
                @"list_clases*": dbr.list(db,"SELECT id, const FROM cclaseproducto",@null)
                @"list_lineas*": list.create()
                @"list_marcas*": dbr.list(db,"SELECT sys_pk, codigo, descripcion FROM marca WHERE NOT IFNULL(sys_deleted,0)",@null)
                @"list_deptos*": dbr.list(db,"SELECT sys_pk, codigo, descripcion FROM departamento WHERE NOT IFNULL(sys_deleted,0)",@null)
            }
        }
        else if view == "aprovisionar"
        {
            params<"sobre_aprovisionar"> : parse.num(dbr.vars.get(db,"cmpreq_sobre_aprovisionamiento"))

            data<"dcmpreq*"> : dbr.list(db,@qry_aprovisionar_dcmpreq,params)
        }
        else if view == "surtir"
        {
            params<"surtir_al_consolidar"> : parse.num(dbr.vars.get(db,"cmpreq_surtir_al_consolidar"))

            data<"dcmpreq*"> : dbr.list(db,@qry_surtir_dcmpreq,params)
        }
        else
        {
            data<"dcmpreq*"> : dbr.list(db,ftext(@qry_dcmpreq),params)
        }
    }

    //#region prepareList()
    prepareList::&db,&params,&data
    {
        using data
        {
            @"list_status*": dbr.list(db,"SELECT * FROM cmpreq_status",@null)
            @"list_tipos*": dbr.list(db,"SELECT * FROM cmpreq_type",@null)
            @"list_csurtido*": dbr.list(db,"SELECT b.sys_pk, b.descripcion FROM cmpreq_cc a INNER JOIN cconsumo b ON a.cc = b.sys_pk",@null)
        }
    }

    //#region evaluateFilters()
    evaluateFilters::&params
    {
        if not(field.exist(params,"fil_status")) { params<"fil_status"> : -1 }
        if not(field.exist(params,"fil_type")) { params<"fil_type"> : -1 }
        if not(field.exist(params,"fil_csurtido")) { params<"fil_csurtido"> : -1 }

        conditions = ""

        if @@(params,"#fil_type") > 0 { conditions = conditions + "AND req.tipo = @fil_type " }
        if @@(params,"#fil_csurtido") > 0 { conditions = conditions + "AND req.cc = @fil_csurtido " }
        if @@(params,"#fil_status") >= 0 { conditions = conditions + "AND req.`status` = @fil_status " }

        if trim(@@(params,"$fil_text")) != "" {
            conditions = conditions + "AND (req.referencia LIKE CONCAT('%',@fil_text,'%') OR IFNULL(pda.partida,'') LIKE CONCAT('%',@fil_text,'%'))"
        }

        // filter-date-range [start]
        new req_date_fields
        {
            @"1": "req.fecha" // Elaboración
            @"2": "req.flimite" // Vencimiento
        }
        
        fdr_field = @@(req_date_fields,str(@@(params,"#fil_fdr_field")))

        switch @@(params,"$fdr_mode")
        {
            case "month"
            {
                curr_ndt = ndatetime.now()
                curr_year = ndatetime.year(curr_ndt)
                curr_month = ndatetime.month(curr_ndt)
                curr_day = ndatetime.day(curr_ndt)

                if not(field.exist(params,"fdr_year")) { params<"fdr_year"> : curr_year }
                if not(field.exist(params,"fdr_month")) { params<"fdr_month"> : curr_month }

                conditions = conditions + " AND YEAR(#<fdr_field>) = @fdr_year AND MONTH(#<fdr_field>) = @fdr_month"
                break
            }
            case "lastdays"
            {
                if not(field.exist(params,"fdr_range")) { params<"fdr_range"> : 30 } // Últimos 30 días

                conditions = conditions + " AND DATE(#<fdr_field>) BETWEEN ADDDATE(DATE(NOW()), INTERVAL -@fdr_range DAY) AND DATE(NOW())"
                break
            }
            case "range"
            {
                if not(field.exist(params,"fdr_from"))
                {
                    curr_ndt = ndatetime.now()
                    subt_ndt = ndatetime.add(curr_ndt, -30, "d")
                    ult_30_days = ndatetime.tostr(subt_ndt, "yyyy-MM-dd")

                    params<"fdr_from"> : ult_30_days
                }
                if not(field.exist(params,"fdr_to")) { params<"fdr_to"> : hoy("yyyy-MM-dd") }

                if trim(@@(params,"$fdr_from")) != "" && trim(@@(params,"$fdr_to")) != ""
                {
                    conditions = conditions + " AND DATE(#<fdr_field>) BETWEEN @fdr_from AND @fdr_to"
                }
                else if trim(@@(params,"$fdr_from")) != "" && trim(@@(params,"$fdr_to")) == ""
                {
                    conditions = conditions + " AND DATE(#<fdr_field>) >= @fdr_from"
                }
                else if trim(@@(params,"$fdr_from")) == "" && trim(@@(params,"$fdr_to")) != ""
                {
                    conditions = conditions + " AND DATE(#<fdr_field>) <= @fdr_to"
                }

                break
            }
        }
        // filter-date-range [end]
        conditions = conditions + " LIMIT #<@default_max_rows>"

        conditions = ftext(conditions)
        @list_query = ftext(@list_query)
    }

    //#region aprobar()
    aprobar::&db,&params,&data
    {
        if @@(data,"#status") != @stt_req_aprobado { return }
        ref req = entity.read(db,params)
        if field.exist(req,"_detalle"){do field.remove(req,"_detalle")}
        
        // Si es una requisición directa que afecta presupuesto de gastos de operación.
        if not(@@(req,"#consolidacion")) && @@(req,"#partida") > 0
        {
            if @@(req,"#ipresupuesto")>0 && dbr.num(db,"SELECT status FROM gop_presupuesto WHERE sys_pk = @ipresupuesto",req) < 3
            { do rise_error(500,"¡No es posible aprobar la requisición!\r\nEs necesario aprobar el presupuesto de la partida presupuestal.") }
            
            if @@(req,"#partida")>0 && dbr.num(db,"SELECT COUNT(sys_pk) FROM gop_partida WHERE padre = @partida",req) > 0
            { do rise_error(500,"No se puede afectar la requisición porque la partida presupuestal tiene sub-partidas, relacione la requisción a la sub-partida correspondiente") }

            if @@(req,"#partida")>0
            {
                ref pre = pregop.partida.importes(db, @@(req,"#partida"), @@(req,"#periodo"))

                if @@(req,"#importe") > @@(pre,"#disponible") { do rise_error(500,"¡No fue posible aprobar!\r\nEl total de la requisición supera el disponible del presupuesto en el periodo seleccionado.") }

                new gop_mov_data
                {
                    @"sys_pk": @@(req,"#partida") //(int) Clave primaria de la partida.
                    @"referencia": @@(req,"$referencia") //(string) Referencia del elemento que realiza la afectación.
                    @"periodo": @@(req,"#periodo") //(int) Mes (MM) sobre el que se hara la afectación.
                    @"comprometido": @@(req,"#importe") //(decimal) Monto (+\-) de la afectación.
                    @"ejercido": 0 //(decimal) Monto (+\-) de la afectación.
                    @"det": "DET070" //(string) Código DET (Data Element Type) del elemento que realiza la afectación.
                    @"det_id": @@(req,"#sys_pk") //(int) Clave primaria del elemento que realiza la afectación.
                    @"usuario": @@(@http_context, "$session/user/uid") //(string) UserId del usuario logueado que realiza la afectación.
                    @"notas": "Requisición aprobada" //(string) Descripción sobre el movimiento de afectación de presupuesto.
                }
                // if not(pregop.partida.comprometido(db, @@(req,"$partida_id"), @@(req,"#ejercicio"), @@(req,"#periodo"), @@(req,"#importe")))
                if not(pregop.partida.movimiento(db,gop_mov_data))
                { do rise_error(500,"¡No fue posible aprobar!\r\nHubo un problema al comprometer el ejercicio correspondiente.") }
            }
        }
        // Cuando se trata de una consolidación, las requisiciones consolidadas ya fueron aprobadas
    }

    //#region cancelar()
    cancelar::&db,&params,&data
    {
        if @@(data,"#status") != @stt_adm_cancelado { return }
        ref req = entity.read(db,params)
            
        // Si es una requisición directa que afecta presupuesto de gastos de operación.
        if not(@@(req,"#consolidacion")) && @@(req,"#partida") > 0
        {
            new gop_mov_data
            {
                @"sys_pk": @@(req,"#partida") //(int) Clave primaria de la partida.
                @"referencia": @@(req,"$referencia") //(string) Referencia del elemento que realiza la afectación.
                @"periodo": @@(req,"#periodo") //(int) Mes (MM) sobre el que se hara la afectación.
                @"comprometido": (@@(req,"#importe") * -1) //(decimal) Monto (+\-) de la afectación.
                @"ejercido": 0 //(decimal) Monto (+\-) de la afectación.
                @"det": "DET070" //(string) Código DET (Data Element Type) del elemento que realiza la afectación.
                @"det_id": @@(req,"#sys_pk") //(int) Clave primaria del elemento que realiza la afectación.
                @"usuario": @@(@http_context, "$session/user/uid") //(string) UserId del usuario logueado que realiza la afectación.
                @"notas": "Requisición cancelada" //(string) Descripción sobre el movimiento de afectación de presupuesto.
            }
            // if not(pregop.partida.comprometido(db, @@(req,"$partida_id"), @@(req,"#ejercicio"), @@(req,"#periodo"), (@@(req,"#importe") * -1)))
            if not(pregop.partida.movimiento(db,gop_mov_data))
            { do rise_error(500,"¡No fue posible cancelar!\r\nHubo un problema al afectar el comprometido del ejercicio correspondiente.") }
        }

        if @@(req,"#consolidacion")
        {
            ref list_reqs = dbr.list(db,"SELECT sys_pk AS _entity_id FROM cmpreq WHERE en = @_entity_id",params)
            for i = 0; i < list.count(list_reqs)
            {
                ref itm = list.obj(list_reqs,i)
                ref req = entity.read(db,itm)

                // Si la requisición consolidada afecta presupuesto de gastos de operación.
                if @@(req,"#partida") > 0
                {
                    new gop_mov_data
                    {
                        @"sys_pk": @@(req,"#partida") //(int) Clave primaria de la partida.
                        @"referencia": @@(req,"$referencia") //(string) Referencia del elemento que realiza la afectación.
                        @"periodo": @@(req,"#periodo") //(int) Mes (MM) sobre el que se hara la afectación.
                        @"comprometido": (@@(req,"#importe") * -1) //(decimal) Monto (+\-) de la afectación.
                        @"ejercido": 0 //(decimal) Monto (+\-) de la afectación.
                        @"det": "DET070" //(string) Código DET (Data Element Type) del elemento que realiza la afectación.
                        @"det_id": @@(req,"#sys_pk") //(int) Clave primaria del elemento que realiza la afectación.
                        @"usuario": @@(@http_context, "$session/user/uid") //(string) UserId del usuario logueado que realiza la afectación.
                        @"notas": "Requisición cancelada" //(string) Descripción sobre el movimiento de afectación de presupuesto.
                    }
                    // if not(pregop.partida.comprometido(db, @@(req,"$partida_id"), @@(req,"#ejercicio"), @@(req,"#periodo"), (@@(req,"#importe") * -1)))
                    if not(pregop.partida.movimiento(db,gop_mov_data))
                    { do rise_error(500,"¡No fue posible cancelar!\r\nHubo un problema al afectar el comprometido del ejercicio correspondiente de la requisición: " + @@(req,"$referencia")) }
                }
            }

            new reg
            {
                @"sys_timestamp*": now()
                @"sys_lastuser": @@(@http_context, "$session/user/uid")
                @"sys_recver*": dbr.sql("(sys_recver + 1)")
                @"status": new_status
            }
            do dbr.update(db, "cmpreq", reg, "en = @_entity_id", params)
        }
    }

    //#region changeStatus()
    changeStatus::&db,&params,&data
    {
        @use_transaction = @false

        action_code = ""
        new_status = @@(data,"#status")

        if new_status == @stt_req_aprobado { action_code = "TD13" }
        else if new_status == @stt_req_nproceso { action_code = "TD14" }
        else if new_status == @stt_adm_cancelado { action_code = "TD15" }
        else { action_code = "TD12" }

        do dbr.apps.action.pre(action_code)
        do dbr.begin(db)

        new cmpreq
        {
            @"sys_pk": @@(data,"#sys_pk")
            @"sys_timestamp*": now()
            @"sys_lastuser": @@(@http_context, "$session/user/uid")
            @"sys_recver": @@(data,"#sys_recver")

            @"status": new_status
        }

        if new_status == @stt_req_aprobado
        {
            cmpreq<"uaprobo"> : lib.GetPkUsr(db, @@(@http_context, "$session/user/uid"))

            consolidacion = dbr.num(db,ftext("select ifnull(consolidacion,0) from cmpreq where #<@keyfield> = @_entity_id"),params)
            if not(consolidacion)
            {
                _detalle = field.dstr(data,"_detalle","[]")
                if _detalle == "" { _detalle = "[]" }
                if _detalle != "[]"
                {
                    ref req = entity.update(db,params,genArrayDetails(data))
                    cmpreq<"sys_recver"> : @@(req,"#sys_recver")
                }
            }
            else
            {
                new args
                {
                    @"conId": trim(@@(params,"$_entity_id"))
                    @"reqsId": trim(@@(data,"$_requisiciones"))
                }
                
                do dbr.execute(db,"UPDATE cmpreq SET en = NULL WHERE en = @conId",args)
                // Agregar requisiciones directas a requisición consolidada
                if @@(args,"$reqsId") != "" { do dbr.execute(db,"UPDATE cmpreq SET en = @conId WHERE sys_pk IN("+@@(args,"$reqsId")+")",args) }

                ref tt = dbr.rec(db,"SELECT ROUND(SUM(subtotal),4) subtotal, ROUND(SUM(impuestos),4) impuestos FROM cmpreq WHERE en = @conId",args)
                cmpreq<"subtotal"> : @@(tt,"#subtotal")
                cmpreq<"impuestos"> : @@(tt,"#impuestos")
            }

            do aprobar(db,params,data)
        }
        if new_status == @stt_req_cancelado
        {
            do cancelar(db,params,data)
        }

        ref entity = dbr.save(db,"cmpreq",cmpreq)

        do dbr.apps.action.pos(entity)
        do dbr.commit(db)
        do dbr.apps.action.ext(entity)

        return entity

        exception{ do catch(db,params,data) }
    }

    //#region getStockKeepingProducts()
    getStockKeepingProducts::&db,&params
    {
        do setZonaImpuesto(db,params)

        selects = ",
        CASE @fil_prod_until
            WHEN 'minimo' THEN
                IF(mm.iproducto IS NULL AND @fil_gv = 'on',
                    (p.minimo - p.existencia),
                    (mm.uf_minimo - ex.existencia)
                )
            WHEN 'maximo' THEN
                IF(mm.iproducto IS NULL AND @fil_gv = 'on',
                    (p.maximo - p.existencia),
                    (mm.uf_maximo - ex.existencia)
                )
            WHEN 'promedio' THEN
                IF(mm.iproducto IS NULL AND @fil_gv = 'on',
                    ((p.minimo + ((p.maximo - p.minimo)/2)) - p.existencia),
                    ((mm.uf_minimo + ((mm.uf_maximo - mm.uf_minimo)/2)) - ex.existencia)
                )
        END AS cantidad_2
        "

        joins = "LEFT JOIN ut_maxmin AS mm ON mm.iproducto = p.sys_pk LEFT JOIN existencias AS ex ON ex.fk_producto_iexistencias = p.sys_pk"
        
        conditions = ""

        if @@(params,"#almacen") > 0 { conditions = conditions + " AND mm.ialmacen = @almacen AND ex.ialmacen = @almacen" }
        if @@(params,"#fil_clase") > 0 { conditions = conditions + " AND p.iclase = @fil_clase" }
        if @@(params,"#fil_linea") > 0 { conditions = conditions + " AND p.ilinea = @fil_linea" }
        if @@(params,"#fil_marca") > 0 { conditions = conditions + " AND p.imarca = @fil_marca" }
        if @@(params,"#fil_depto") > 0 { conditions = conditions + " AND p.idepartamento = @fil_depto" }

        // Incluir productos iguales o por debajo del...
        conditions = conditions + " AND IF(mm.iproducto IS NULL AND @fil_gv = 'on',
            IFNULL(p.existencia,0) <= IF(@fil_prod_below = 'preorden', IFNULL(p.puntoro,0), IFNULL(p.minimo,0)),
            IFNULL(ex.existencia,0) <= IF(@fil_prod_below = 'preorden', IFNULL(mm.uf_preorden,0), IFNULL(mm.uf_minimo,0))
        )
        "

        return dbr.list(db,ftext(@qry_buscar_producto),params)
    }

    //#region calculateTaxes()
    calculateTaxes::&product
    {
        costo = @@(product,"#precio")
        cantidad = @@(product,"#cantidad")
        descuentos = @@(product,"#descuentos")
        i1_tasa = @@(product,"#i1_tasa")
        i2_tasa = @@(product,"#i2_tasa")
        i3_tasa = @@(product,"#i3_tasa")
        i4_tasa = @@(product,"#i4_tasa")

        subtotal = (costo * cantidad)
        sub_desc = (subtotal - descuentos)
        impuesto1 = (sub_desc * i1_tasa)
        impuesto2 = (sub_desc * i2_tasa)
        i1_i2 = (impuesto1 + impuesto2)
        sub_desc_i1_i2 = (sub_desc + i1_i2)
        impuesto3 = (sub_desc_i1_i2 * i3_tasa)
        impuesto4 = (sub_desc_i1_i2 * i4_tasa)
        i3_i4 = (impuesto3 + impuesto4)
        impuestos = (i1_i2 + i3_i4)
        total = (sub_desc + impuestos)

        new taxes
        {
            @"costo": costo
            @"cantidad": cantidad
            @"subtotal": subtotal
            @"descuentos": descuentos
            @"impuestos": impuestos
            @"total": total
            @"impuesto1": impuesto1
            @"impuesto2": impuesto2
            @"impuesto3": impuesto3
            @"impuesto4": impuesto4
        }

        return taxes
    }

    //#region setStockKeeping()
    setStockKeeping::&db,&params,&data
    {
        ref products = getStockKeepingProducts(db,params)
        ref dcmpreq = list.create()

        subtotal = 0.00
        impuestos = 0.00

        for i = 0; i < list.count(products); i+1
        {
            ref product = list.obj(products,i)
            product<"cantidad"> : @@(product,"#cantidad_2")

            if @@(product,"#cantidad") > 0
            {
                ref taxes = calculateTaxes(product)

                new item
                {
                    @"producto": @@(product,"#sys_pk")
                    @"cantidad": @@(taxes,"#cantidad")
                    @"unidad": @@(product,"$unidada")
                    @"precio": @@(taxes,"#costo")
                    @"impuestos": @@(taxes,"#impuestos")
                    @"excluido": @false
                    @"notas": ""
                }

                subtotal = subtotal + @@(taxes,"#subtotal")
                impuestos = impuestos + @@(taxes,"#impuestos")
                do list.add(dcmpreq,item)
            }
        }

        data<"subtotal"> : subtotal
        data<"impuestos"> : impuestos
        data<"_detalle*"> : dcmpreq

        using @childs
        {
            member "_detalle"
            {
                @"joinfield": "ref_req"
                @"keyfield": "sys_pk"
                @"table": "dcmpreq"
                @"select_query": "SELECT NULL"
                @"fields": "producto,cantidad,unidad,precio,impuestos,excluido,notas"
            }
        }
    }

    //#region list()
    list::&db,&params
    {
        do dbr.apps.action.grant("TD10")

        do evaluateFilters(params)
        new data
        {
            @"requisiciones*": entity.list(db,params)
        }
        do prepareList(db,params,data)
        do setPrintTitles(db,data)
        
        return data

        exception{ do catch(db,params,@null) }
    }

    //#region read()
    read::&db,&params
    {
        do dbr.apps.action.grant("TD10")

        if not(isset("@just_read_entity")) { @just_read_entity = @false }
        if @just_read_entity { return entity.read(db,params) }

        new data
        {
            @"cmpreq*": entity.read(db,params)
        }
        do prepareView(db,params,data)
        return data

        exception{ do catch(db,params,@null) }
    }

    //#region blank()
    blank::&db,&params
    {
        do dbr.apps.action.grant("TD10")

        new data
        {
            @"fecha": date_str(now(),"yyyy-MM-dd")
        }
        do prepareView(db,params,data)
        return data

        exception{ do catch(db,params,@null) }
    }

    //#region foliodocumento()
    foliodocumento::&db,serie,folio
    {
        iblock = dbr.folios.id_block(db,@cRequisicion,serie)
        
        if folio > 0 { folio = dbr.folios.set_new(db,iblock,folio,3) }
        else { folio = dbr.folios.set_new(db,iblock,dbr.folios.get_new(db,iblock),3) }
        
        ref info = dbr.folios.info(db,iblock,folio)

        referencia = serie + padleft(str(folio),6,"0")
        serie, referencia >> info

        return info
    }

    //#region create()
    create::&db,&params,&data
    {
        @use_transaction = @false
        @just_read_entity = @true

        do dbr.apps.action.pre("TD11")
        do dbr.begin(db)

        serie = trim(@@(data,"$serie"))
        folio = abs(@@(data,"#folio"))
        ref fdoc = foliodocumento(db,serie,folio)

        new cmpreq
        {
            @"sys_user": @@(@http_context, "$session/user/uid")
            @"ucreo": lib.GetPkUsr(db,@@(@http_context, "$session/user/uid"))
            @"unidad_org": @@(data,"#unidad_org")
            @"ejercicio": @@(data,"#ejercicio")
            @"partida": @@(data,"#partida")
            @"periodo": @@(data,"#periodo")
            @"tipo": @@(data,"#tipo")
            @"referencia": @@(fdoc,"$referencia")
            @"folio": @@(fdoc,"#sys_pk")
            @"fecha": @@(data,"$fecha")
            @"flimite": @@(data,"$flimite")
            @"almacen": @@(data,"#almacen")
            @"cc": @@(data,"#cc")
            @"divisa": @@(data,"#divisa")
            @"tcambio": @@(data,"#tcambio")
            @"status": @@(data,"#status")
            @"subtotal": 0
            @"impuestos": 0
        }

        if @@(cmpreq,"#tipo") <= 0 { do rise_error(511,"No se ha indicado el tipo de requisición.") }
        if @@(cmpreq,"$fecha") == "" { do rise_error(512,"No se establecio la fecha de elaboración.") }
        if @@(cmpreq,"#unidad_org") < 1 && @@(cmpreq,"#tipo") != @type_req_consl { do rise_error(513,"No se ha indicado la unidad organizacional.") }
        if @@(cmpreq,"#almacen") < 1 && @@(cmpreq,"#tipo") != @type_req_consl { do rise_error(514,"No se ha indicado el almacén.") }
        if @@(cmpreq,"#cc") < 1 { do rise_error(515,"No se ha indicado el centro de surtido.") }
        if @@(cmpreq,"#divisa") < 1 { do rise_error(516,"No se ha indicado una divisa.") }
        if @@(cmpreq,"#tcambio") <= 0 { do rise_error(517,"Debe especificar un tipo de cambio válido.") }
        if @@(cmpreq,"#status") < 0 { cmpreq<"status"> : @stt_req_borrador }
        if @@(cmpreq,"$flimite") == "" { do field.remove(cmpreq,"flimite") }
        if @@(cmpreq,"#unidad_org") < 1 { do field.remove(cmpreq,"unidad_org") }
        if @@(cmpreq,"#almacen") < 1 { do field.remove(cmpreq,"almacen") }

        add_products = parse.bool(@@(data,"$add-products"))
        affect_gop = parse.bool(@@(data,"$affect-gop"))
        url_redir = path.concat(@CMP_REQUISICION, "/{_entity_id}/")

        switch @@(data,"#tipo")
        {
            case @type_req_gop
            {
                cmpreq<"notas"> : "Requisición directa para gastos de operación."
                break
            }
            case @type_req_stock
            {
                cmpreq<"notas"> : "Requisición directa para mantenimiento de stock."
                break
            }
            case @type_req_gral
            {
                cmpreq<"notas"> : "Requisición directa para previsión en general."
                break
            }
            case @type_req_consl
            {
                add_products = @false
                affect_gop = @false
                url_redir = path.concat(@CMP_CONSOLIDADO, "/{_entity_id}/")

                cmpreq<"consolidacion"> : @true
                cmpreq<"notas"> : "Requisición consolidada."
                break
            }
        }

        if not(affect_gop) || @@(cmpreq,"#ejercicio") < 1 { do field.remove(cmpreq,"ejercicio") }
        if not(affect_gop) || @@(cmpreq,"#partida") < 1 { do field.remove(cmpreq,"partida") }
        if not(affect_gop) || @@(cmpreq,"#periodo") < 1 { do field.remove(cmpreq,"periodo") }
        if add_products
        {
            ref filters = record.copy(data,"almacen,fil_clase,fil_linea,fil_marca,fil_depto,fil_gv,fil_prod_below,fil_prod_until")
            do setStockKeeping(db,filters,cmpreq)
        }

        ref entity = entity.create(db,params,cmpreq)

        do dbr.apps.action.pos(entity)
        do dbr.commit(db)
        do dbr.apps.action.ext(entity)

        @url_redir = replace(url_redir, "{_entity_id}", @@(entity,"$sys_pk"))
        return entity

        exception{ do catch(db,params,data) }
    }

    //#region genArrayDetails()
    genArrayDetails::&data
    {
        new cmpreq
        {
            @"sys_lastuser": @@(@http_context, "$session/user/uid")
            @"sys_recver": @@(data,"#sys_recver")

            @"periodo": @@(data,"#periodo")
            @"fecha": @@(data,"$fecha")
            @"flimite": @@(data,"$flimite")
            @"subtotal": 0
            @"impuestos": 0
            @"tcambio": @@(data,"#tcambio")
            @"notas": trim(@@(data,"$notas"))
        }

        if @@(cmpreq,"$flimite") == "" { do field.remove(cmpreq,"flimite") }

        // 1 - $ | 2 - # | 3 - * | 0 - not exist
        if field.typeof(data,"_detalle") == 1
        {
            ref _detalle = from.json(@@(data,"_detalle"))
            ref dcmpreq = list.create()

            subtotal = 0
            impuestos = 0

            for i = 0; i < list.count(_detalle)
            {
                ref producto = list.obj(_detalle,i)

                new d
                {
                    @"producto": @@(producto,"#producto")
                    @"cantidad": @@(producto,"#cantidad")
                    @"unidad": @@(producto,"$unidad")
                    @"precio": @@(producto,"#precio")
                    @"impuestos": (@@(producto,"#impuesto1") + @@(producto,"#impuesto2") + @@(producto,"#impuesto3") + @@(producto,"#impuesto4"))
                    @"excluido": parse.bool(@@(producto,"$excluido"))
                    @"notas": @@(producto,"$notas")
                }
                do list.add(dcmpreq,d)

                subtotal = subtotal + @@(producto,"#subtotal")
                impuestos = impuestos + @@(d,"#impuestos")
            }

            cmpreq<"subtotal"> : subtotal
            cmpreq<"impuestos"> : impuestos
            cmpreq<"_detalle*"> : dcmpreq
        }

        using @childs
        {
            member "_detalle"
            {
                @"joinfield": "ref_req"
                @"keyfield": "sys_pk"
                @"table": "dcmpreq"
                @"select_query": @qry_dcmpreq
                @"fields": "producto,cantidad,unidad,precio,impuestos,excluido,notas"
            }
        }

        return cmpreq
    }

    //#region update()
    update::&db,&params,&data
    {
        @use_transaction = @false
        @just_read_entity = @true

        do dbr.apps.action.pre("TD12")
        do dbr.begin(db)

        ref cmpreq = genArrayDetails(data)
        ref entity = entity.update(db,params,cmpreq)

        do dbr.apps.action.pos(entity)
        do dbr.commit(db)
        do dbr.apps.action.ext(entity)

        @url_redir = @CMP_REQUISICION
        return entity

        exception{ do catch(db,params,data) }
    }

    //#region genAdditional()
    genAdditional::&db,&data,&details
    {
        ref dcmpreq = list.create()
        subtotal = 0
        impuestos = 0

        for i = 0; i < list.count(details)
        {
            ref p = list.obj(details,i)
            if @@(p,"#comprar") > 0
            {
                ref t = calculateTaxes(p)
                new d
                {
                    @"producto": @@(p,"#iproducto")
                    @"unidad": @@(p,"$unidad")
                    @"precio": @@(p,"#precio")
                    @"cantidad": @@(p,"#comprar")
                    @"impuestos": @@(t,"#impuestos")
                    @"notas": ""
                    @"excluido": @false
                }
                do list.add(dcmpreq,d)

                subtotal = subtotal + @@(t,"#subtotal")
                impuestos = impuestos + @@(t,"#impuestos")
            }
        }

        if list.count(dcmpreq) > 0
        {
            ref params = record.copy(@@(@http_context,"&request/get"),"*")
            ref cmpreq = record.copyex(data,@null,"serie,unidad,almacen,cc,divisa,tcambio", ",", "unidad:unidad_org", ":")
            ref fdoc = foliodocumento(db,@@(cmpreq,"$serie"),0)
            userid = @@(@http_context,"$session/user/uid")
            userpk = lib.GetPkUsr(db,userid)
            params<"_entity_id"> : "_new"

            using cmpreq
            {
                @"sys_user": userid

                @"tipo": @type_req_sup
                @"referenncia": @@(fdoc,"$referencia")
                @"folio": @@(fdoc,"#sys_pk")
                @"fecha": date_str(now(),"yyyy-MM-dd")
                @"status": @stt_req_aprobado
                @"subtotal": subtotal
                @"impuestos": impuestos
                @"notas": "Requisición suplementaria proviniente de "+@@(data,"$referencia")
                @"ucreo": userpk
                @"uaprobo": userpk
                @"origen": @@(data,"#sys_pk")

                @"dcmpreq*":dcmpreq
            }

            using @childs
            {
                member "dcmpreq"
                {
                    @"joinfield": "ref_req"
                    @"keyfield": "sys_pk"
                    @"table": "dcmpreq"
                    @"select_query": @qry_dcmpreq
                    @"fields": "producto,unidad,precio,cantidad,impuestos,notas,excluido"
                }
            }

            do entity.create(db,params,cmpreq)
        }
    }

    //#region genProduction()
    genProduction::&db,&data,&details
    {
        ref record = record.create()
        for i = 0; i < list.count(details)
        {
            ref p = list.obj(details,i)
            if @@(p,"#producir") > 0
            {
                cproduccion = @@(p,"$iproduccion")
                if not(field.exist(record,cproduccion)) { record<cproduccion+"*"> : list.create() }

                new d
                {
                    @"iproducto": @@(p,"#iproducto")
                    @"precio": 0
                    @"cantidad": @@(p,"#producir")
                    @"d1": 0
                    @"d2": 0
                    @"cdirecto": @@(p,"#cdirecto")
                    @"cindirecto": 0
                    @"cmanoobra": 0
                    @"cmaquinaria": 0
                    @"idivisa": @@(p,"#idivisa")
                    @"tipocambio": @@(p,"#tcambio")
                    @"tiemposervicio": 0
                    @"tiempoproduccion": 0
                    @"especificaciones": ""
                }

                do list.add(@@(record,"&"+cproduccion), d)
            }
        }

        ref keys = list.create_from_fields(record)
        for i = 0; i < list.count(keys)
        {
            icproduccion = list.num(keys,i)
            ref dorden = @@(record,"&"+icproduccion)
            new orden
            {
                @"referencia": @@(data,"$referencia")
                @"hora": date_str(now(),"yyyy-MM-dd HH:mm")
                @"icproduccion": icproduccion
                @"icconsumo": @@(data,"#cc")
                @"idivisa": @@(data,"#divisa")
                @"tipocambio": @@(data,"#tcambio")
                @"notas": "Orden generada por requisición "+@@(data,"$referencia")

                @"_detalle": to.json(dorden)
            }

            do dprod.orden.setGlobalConfigs()
            do dprod.orden.create(db,record.create(),orden)
        }
        do setGlobalConfigs()
    }

    //#region supply()
    supply::&db,&params,&data
    {
        @use_transaction = @false
        @just_read_entity = @true

        do dbr.apps.action.pre("TD1B")
        do dbr.begin(db)

        ref cmpreq = entity.read(db,params)
        ref details = @@(data,"&detalle")

        do genAdditional(db,cmpreq,details)
        do genProduction(db,cmpreq,details)

        do dbr.apps.action.pos(@null)
        do dbr.commit(db)
        do dbr.apps.action.ext(@null)

        lastuser = @@(@http_context,"$session/user/uid")
        do dbr.execute(db,ftext("
            UPDATE #<@table_name> SET
                sys_timestamp = NOW(),
                sys_lastuser = '#<lastuser>',
                sys_recver = sys_recver + 1,
                status = #<@stt_req_completado>
        "),params)

        new response
        {
            @"message": "Proceso completado"
            @"url_redir": @CMP_REQUISICION
        }
        return response

        exception{ do catch(db,params,data) }
    }

    //#region stock()
    stock::&db,&params,&data
    {
        @use_transaction = @false
        @just_read_entity = @true

        do dbr.apps.action.pre("TD1C")
        do dbr.begin(db)

        ref req = dbr.rec(db,"
            SELECT
                r.referencia,
                c.sys_pk AS almacen_origen,
                r.almacen AS almacen_destino
            FROM cmpreq r
                INNER JOIN cconsumo c ON r.cc = c.sys_pk
            WHERE r.sys_pk = @_entity_id
        ",params)
        ref det = @@(data,"&detalle")

        ref productos = list.create()
        for i = 0; i < list.count(det)
        {
            ref o = list.obj(det,i)
            entregar = @@(o,"#entregar")
            
            if entregar > 0
            {
                o<"entregar"> : entregar
                new p
                {
                    @"sys_pk": @@(o,"#iproducto")
                    @"costoultimo": @@(o,"#costoultimo")
                    @"cantidad": entregar
                }
                do list.add(productos,p)
                
                // Actualizar cantidad surtida por cada producto en el detalle de la requisición
                sql_up_surtido = "
                update dcmpreq set
                    surtido = (ifnull(surtido,0) + @entregar)
                where
                    sys_pk = @idetalle
                    and (ifnull(surtido,0) + @entregar) <= @faltante
                "
                if not(dbr.execute(db,sql_up_surtido,o)) {
                    do rise_error(511,"Detalle de requisición no encontrado o la cantidad a entregar es mayor al faltante.")
                }
            }
        }
        if list.count(productos) < 1 { do rise_error(511,"¡No es posible continuar! Nada por procesar.") }

        transfer_mode = parse.num(dbr.vars.getd(db,"cmpreq_transfer_mode","1"))
        params<"catinv"> : dbr.vars.getd(db,"cmpreq_catinv_para_surtir","SR")
        referencia = @@(req,"$referencia")

        last_cardex = dbr.str(db,"select referencia from cardex where referencia like concat(@referencia,'/%') order by sys_dtcreated desc limit 1",req)
        if last_cardex == "" { referencia = referencia + "/1" }
        else
        {
            ref parts = split(last_cardex,"/")
            consecutive = list.num(parts,1)
            referencia = referencia +"/"+ str(consecutive + 1)
        }

        // Preparar la carga útil y encabezados para la petición de transferencia
        new header
        {
            @"Content-Type": "application/json; charset=utf-8"
            @"Authorization": "Bearer "+@@(@http_context,"$session/user/ids")
        }
        new payload
        {
            @"tipo_movimiento": "traspaso"
            @"fecha": date_str(now(),"yyyy-MM-dd")
            @"referencia": referencia
            @"icategoria": dbr.num(db,"select sys_pk from categoria where codigo = @catinv",params)
            @"mov_2p": (transfer_mode == 2)
            @"step": 1 //Número de paso que representa la operación cuando el modo de transferencia es en 2 pasos
            @"ialmacen": @@(req,"#almacen_origen")
            @"ialmacen2": @@(req,"#almacen_destino")
            @"descripcion": "Movimiento generado por requisición "+@@(req,"$referencia")

            @"_productos*": productos
        }

        endpoint = path.concat(lib.base_url(@false),@URL_NEW_MOVINV)
        response = http.request(endpoint,"POST",header,to.json(payload))
        ref resp = from.json(response)
        
        if field.exist(resp,"message") { do rise_error(500,@@(resp,"$message")) }
        // Vincular dcardex por cada producto en el detalle de la requisición
        for i = 0; i < list.count(det)
        {
            ref o = list.obj(det,i)
            o<"referencia"> : referencia
            o<"movimiento"> : dbr.num(db,"select d.sys_pk from dcardex d inner join cardex c on d.fk_cardex_movimientos=c.sys_pk where c.referencia=@referencia and d.iproducto=@iproducto and ifnull(d.salidas,0) > 0;",o)
            do dbr.execute(db,"insert into dcmpreq_surtido (detalle,movimiento) value (@idetalle,@movimiento)",o)
        }

        do dbr.apps.action.pos(resp)
        do dbr.commit(db)
        do dbr.apps.action.ext(resp)

        new r
        {
            @"message": "Proceso completado"
            @"url_redir": @CMP_REQUISICION
        }
        return r

        exception{ do catch(db,params,data) }
    }

    delete::&db,&params
    {
        do rise_error(500,"Acción no implementada")
    }

    //#region catch()
    catch::&db,&params,&data
    {
        do errordet(@false)
        code = last_error_code()
        error = last_error()

        if dbr.in_transaction(db) { do dbr.rollback(db) }
        if isset("@@_action_context") { do dbr.apps.action.log() }

        if isanyword(@@(params,"$_operation"),"create,update")
        {
            if isnull(data) { ref data:record.create() }
            if contains(error,"Duplicate entry") { error = "Entrada duplicada, ya existe un registro con los mismos valores." }

            ref FormData = record.copy(data,"*")
            do record.clear(data)
            data<"form*"> : FormData

            do prepareView(db,params,data)
        }
        else if @@(params,"$_operation") == "delete"
        {
            if contains(error,"Cannot delete or update a parent row") || contains(error,"DELETE Error") {
                error = "No es posible eliminar, otros registros dependen del elemento proporcionado."
            }
        }

        do clear_exceptions()
        do rise_error(code,error)
    }
}