#include "dkli.dkh"
#!
module ""
{
    switch @@(@http_context,"$request/get/_view")
    {
        case "buscar-unidad-org"
        {
            point @list to buscarUnidad
            break
        }
        case "buscar-partida-pre"
        {
            point @list to buscarPartida
            break
        }
        case "buscar-producto"
        {
            point @list to buscarProducto
            break
        }
        case "obtener-lineas"
        {
            point @list to obtenerLineaXClase
            break
        }
        case "obtener-fultimo"
        {
            point @read to obtenerFultimo
            break
        }
        case "change-status"
        {
            point @update to req.changeStatus
            break
        }
        default
        {
            _entity_id = @@(@http_context,"$request/get/_entity_id")
            cmpreq_type = @@(@http_context,"#request/get/cmpreq_type")

            if cmpreq_type == @type_req_gop { @form_view = "form.new.dk" }
            else if cmpreq_type == @type_req_stock { @form_view = "form.stock.dk" }
            else if cmpreq_type == @type_req_gral { @form_view = "form.gral.dk" }
            else if cmpreq_type == @type_req_consl {
                @http_context<"response/headers/location"> : path.concat(@CMP_CONSOLIDADO,"_new")
                return
            }
            else { @form_view = "choose.dk" }
            
            if _entity_id != "_new" { @form_view = "form.edt.dk" }

            point @list to req.list
            point @read to req.read
            point @blank to req.blank
            point @create to req.create
            point @update to req.update
            point @delete to req.delete
            break
        }
    }
}