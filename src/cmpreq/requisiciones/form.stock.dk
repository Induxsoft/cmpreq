#include "dkli.dkh"
#!
module "form.dk"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "uielements.v12.dkl"
    #include "../_lib/config.dk"
	#include "../_lib/icons.dk"
    #include "../_lib/lib.dk"

    do @context.begin(@crud_context)

    ref @_GET = ifnull(@("&parameters"),record.create())
    ref cmpreq = ifnull(@("&./cmpreq"),record.create())
    ref dt_unidad_org = ifnull(@("&./dt_unidad_org"),record.create())
    ref dt_partida_pre = ifnull(@("&./dt_partida_pre"),record.create())
    ref list_series =ifnull(@("&./list_series"),list.create())
    ref list_status = ifnull(@("&./list_status"),list.create())
    ref list_divisas = ifnull(@("&./list_divisas"),list.create())
    ref list_almacenes = ifnull(@("&./list_almacenes"),list.create())
    ref list_clases = ifnull(@("&./list_clases"),list.create())
    ref list_lineas = ifnull(@("&./list_lineas"),list.create())
    ref list_marcas = ifnull(@("&./list_marcas"),list.create())
    ref list_deptos = ifnull(@("&./list_deptos"),list.create())

	@_entities_type = @("$parameters/_entities_type")
	@_entity_id = @("$parameters/_entity_id")

    new sel_serie
    {
        @"datatable*": list_series
        @"id": "sel_serie"
        new member "attributes"
        {
            @"class": "form-select form-select-sm rounded-0"
            @"style": "max-width:6rem;"
            @"name": "serie"
            @"required": ""
        }
        @"value_field": "serie"
        @"text_field": "serie"
        new member "attr_options"
        {
            @"data-iblock": "#<@@(row,'#sys_pk')>"
        }
        @"selected": lib.form('serie','nm',cmpreq)
    }

    new sel_status
    {
        @"datatable*": list_status
        @"id": "sel_status"
        member "attributes"
        {
            @"class": "form-select form-select-sm rounded-0"
            @"name": "status"
            @"required": ""
        }
        @"value_field": "id"
        @"text_field": "const"
        @"selected": field.dnum(ifnull(@("&./form"),cmpreq),"status",1)
    }

    new sel_divisa
    {
        @"datatable*": list_divisas
        @"id": "sel_divisa"
        new member "attributes"
        {
            @"class": "form-select form-select-sm rounded-0"
            @"name": "divisa"
            @"required": ""
        }
        @"value_field": "sys_pk"
        @"text_field": "text"
        new member "attr_options"
        {
            @"data-codigo": "#<toupper(@@(row,'$codigo'))>"
            @"data-tcambio": "#<@@(row,'#tcambio')>"
        }
        @"selected": lib.form('divisa','nm',cmpreq)
    }

    new sel_almacen
    {
        @"datatable*": list_almacenes
        @"id": "sel_almacen"
        new member "attributes"
        {
            @"class": "form-select form-select-sm rounded-0"
            @"name": "almacen"
            @"required": ""
        }
        // @"first_value": "-1"
        // @"first_text": "(Todos los almacenes)"
        @"value_field": "sys_pk"
        @"text_field": "descripcion"
        @"selected": lib.form('almacen','nm',cmpreq)
    }

    new fil_clase
    {
        @"datatable*": list_clases
        @"id": "fil_clase"
        new member "attributes"
        {
            @"class": "form-select form-select-sm rounded-0"
            @"name": "fil_clase"
        }
        @"first_value": "-1"
        @"first_text": "(Todas las clases)"
        @"value_field": "id"
        @"text_field": "const"
        @"selected": lib.form('fil_clase','nm',cmpreq)
    }

    new fil_linea
    {
        @"datatable*": list_lineas
        @"id": "fil_linea"
        new member "attributes"
        {
            @"class": "form-select form-select-sm rounded-0"
            @"name": "fil_linea"
        }
        @"first_value": "-1"
        @"first_text": "(Todas las lineas)"
        @"value_field": "sys_pk"
        @"text_field": "descripcion"
        @"selected": lib.form('fil_linea','nm',cmpreq)
    }

    new fil_marca
    {
        @"datatable*": list_marcas
        @"id": "fil_marca"
        new member "attributes"
        {
            @"class": "form-select form-select-sm rounded-0"
            @"name": "fil_marca"
        }
        @"first_value": "-1"
        @"first_text": "(Todas las marcas)"
        @"value_field": "sys_pk"
        @"text_field": "descripcion"
        @"selected": lib.form('fil_marca','nm',cmpreq)
    }

    new fil_depto
    {
        @"datatable*": list_deptos
        @"id": "fil_depto"
        new member "attributes"
        {
            @"class": "form-select form-select-sm rounded-0"
            @"name": "fil_depto"
        }
        @"first_value": "-1"
        @"first_text": "(Todos los departamentos)"
        @"value_field": "sys_pk"
        @"text_field": "descripcion"
        @"selected": lib.form('fil_depto','nm',cmpreq)
    }

    new fil_prod_below
    {
        @"datatable*": from.json('[{"v":"preorden","t":"Punto de re-orden"}, {"v":"minimo","t":"Mínimo"}]')
        @"id": "fil_prod_below"
        new member "attributes"
        {
            @"class": "form-select form-select-sm rounded-0 w-auto"
            @"name": "fil_prod_below"
        }
        @"value_field": "v"
        @"text_field": "t"
        @"selected": lib.form('fil_prod_below','tx',cmpreq)
    }

    new fil_prod_until
    {
        @"datatable*": from.json('[{"v":"minimo","t":"Mínimo"}, {"v":"maximo","t":"Máximo"}, {"v":"promedio","t":"Promedio"}]')
        @"id": "fil_prod_until"
        new member "attributes"
        {
            @"class": "form-select form-select-sm rounded-0 w-auto"
            @"name": "fil_prod_until"
        }
        @"value_field": "v"
        @"text_field": "t"
        @"selected": lib.form('fil_prod_until','tx',cmpreq)
    }

    new nav_config
    {
        @"title": "Nueva requisición"
        @"buttons*": @null
        @"urlexit": "../"
        member @"hidden"
        {
            @"print": @true
            @"refresh": @true
        }
    }

    #$
    div(class="container")
    {
        link(href="#<@CSS_MAIN>" rel="stylesheet")

        #!
        do uie.printV12FormBar(nav_config)
        #$

        div(id="work_area" class="container-section")
        {
            div(class="#<ifstr(@('$error/message')!='','alert alert-danger','')> overflow-auto"){$"#<@('$error/message')>"}

            form(method="POST" action="./?cmpreq_type=#<@type_req_stock>" id="form-new-cmpreq")
            {
                input(type="hidden" name="sys_pk" value="#<@@(cmpreq,'#sys_pk')>")
                input(type="hidden" name="sys_recver" value="#<@@(cmpreq, '#sys_recver')>")
                input(type="hidden" name="tipo" value="#<@type_req_stock>")

                div(class="row justify-content-center")
                {
                    div(class="col-lg-8 col-md-10 col-sm-12")
                    {
                        div(class="row gx-2")
                        {
                            div(class="col-lg-4 col-md-4 col-sm-4")
                            {
                                label(class="form-label" "for"="txt_referencia"){$"Referencia:"}
                                div(class="input-group input-group-sm")
                                {
                                    ##
                                    do uie.dbSelect(sel_serie)
                                    ##
                                    input(class="form-control form-control-sm rounded-0 text-end" type="number" name="folio" value="#<lib.form('folio','num',cmpreq)>" id="txt_folio" min="1" step="1" placeholder="<A>")
                                    button(class="btn btn-light btn-sm rounded-0 border" type="button" id="btn_get_folio" title="Obtener folio disponible para la serie seleccionada"){$"#<@ICON_HDOTS>"}
                                }
                            }

                            div(class="col-lg-4 col-md-4 col-sm-4")
                            {
                                label(class="form-label" "for"="txt_fecha"){$"Elaboración:"}
                                input(class="form-control form-control-sm rounded-0" type="date" name="fecha" value="#<lib.form('fecha','dt',cmpreq)>" id="txt_fecha" required="" title="Fecha formal de elaboración")
                            }

                            div(class="col-lg-4 col-md-4 col-sm-4")
                            {
                                label(class="form-label" "for"="txt_flimite"){$"Vencimiento:"}
                                input(class="form-control form-control-sm rounded-0" type="date" name="flimite" value="#<lib.form('flimite','dt',cmpreq)>" id="txt_flimite" title="Fecha y hora límite para completarla")
                            }

                            div(class="col-lg-4 col-md-4 col-sm-4")
                            {
                                label(class="form-label" "for"="txt_divisa"){$"Divisa:"}
                                ##
                                do uie.dbSelect(sel_divisa)
                                ##
                            }

                            div(class="col-lg-4 col-md-4 col-sm-4")
                            {
                                label(class="form-label" "for"="txt_tcambio"){$"T.Cambio:"}
                                input(class="form-control form-control-sm rounded-0 induxsoft-num-field mw-100" type="number" name="tcambio" value="#<lib.form('tcambio','nm',cmpreq)>" id="txt_tcambio" min="1" max="999999.999999" step="0.000001" required="" "num-decs"="6")
                            }

                            div(class="col-lg-4 col-md-4 col-sm-4")
                            {
                                label(class="form-label" "for"="txt_status"){$"Estado:"}
                                ##
                                do uie.dbSelect(sel_status)
                                ##
                            }

                            div(class="col-lg-4 col-md-4 col-sm-4")
                            {
                                label(class="form-label" "for"="sel_almacen"){$"Almacén:"}
                                ##
                                do uie.dbSelect(sel_almacen)
                                ##
                            }
                            div(class="col-lg-6")
                            {
                                label(class="form-label" "for"="ik_unidad_org"){$"Unidad organizacional:"}
                                "input-key"(name="unidad_org" id="ik_unidad_org" required="true" "data-key"="sys_pk" "data-search"="codigo" "data-text"="descripcion" 
                                    "data-value"="#<to.json(dt_unidad_org)>" "data-source"="#<@URL_BUSCAR_UNIDAD_ORG>" columns="codigo,descripcion" colcaptions="Código,Descripción"
                                    "control-styles"="
                                        #input_search_container, #input_description_container,
                                        #button_search_container, #button_clear_container {
                                            height: calc(1.5em + .5rem + 2px) !important;
                                            padding: .25rem .5rem !important;
                                            font-size: .875rem !important;
                                        }
                                    "
                                ){$""}
                            }
                            div(class="col-lg-2")
                            {
                                label(class="form-label" "for"="sel_ejercicio"){$"Ejercicio:"}
                                select(class="form-select form-select-sm rounded-0" name="ejercicio" id="sel_ejercicio" required="true")
                                {$""
                                    #!
                                    syear = lib.form('ejercicio','nm',cmpreq)
                                    if syear == 0 { syear = @curr_year }

                                    ref list_ejercicios = lib.list_years(10,5)
                                    for i = 0; i < list.count(list_ejercicios)
                                    {
                                        year = list.num(list_ejercicios,i)
                                        #$ option(value="#<year>" "#<ifstr(syear == year,'selected','')>"=""){$"#<year>"}
                                    }
                                }
                            }
                            div(class="col-lg-8")
                            {
                                label(class="form-label" "for"="ik_partida_pre"){$"Partida presupuestal:"}
                                "input-key"(name="partida" id="ik_partida_pre" "data-key"="sys_pk" "data-search"="id" "data-text"="partida"
                                    "data-value"="#<to.json(dt_partida_pre)>" "data-source"="#<@URL_BUSCAR_PARTIDA_PRE>" columns="id,partida" colcaptions="Id,Partida"
                                    "control-styles"="
                                        #input_search_container, #input_description_container,
                                        #button_search_container, #button_clear_container {
                                            height: calc(1.5em + .5rem + 2px) !important;
                                            padding: .25rem .5rem !important;
                                            font-size: .875rem !important;
                                        }
                                    "
                                ){$""}
                            }
                        }

                        hr{$""}

                        h6(class=""){$"Filtro de productos"}
                        div(class="row gx-2 gy-2")
                        {
                            div(class="col-lg-4 col-md-4 col-sm-4")
                            {
                                ##
                                do uie.dbSelect(fil_clase)
                                ##
                            }
                            div(class="col-lg-4 col-md-4 col-sm-4")
                            {
                                ##
                                do uie.dbSelect(fil_linea)
                                ##
                            }
                            div(class="col-lg-4 col-md-4 col-sm-4")
                            {
                                ##
                                do uie.dbSelect(fil_marca)
                                ##
                            }
                            div(class="col-lg-4 col-md-4 col-sm-4")
                            {
                                ##
                                do uie.dbSelect(fil_depto)
                                ##
                            }
                            div(class="col-12")
                            {
                                div(class="form-check")
                                {
                                    #!
                                    checked = lib.form("fil_gv","ch",cmpreq)
                                    #$
                                    input(class="form-check-input" type="checkbox" name="fil_gv" id="chk_use_gv" "#<checked>"="")
                                    label(class="form-check-label" "for"="chk_use_gv"){$"Si no hay valores por almacén, usar los valores globales del producto"}
                                }
                            }
                            div(class="col-12")
                            {
                                div(class="d-inline-flex align-items-center gap-1")
                                {
                                    label(class="" "for"="fil_prod_below"){$"Incluir productos iguales o por debajo del:"}
                                    ##
                                    do uie.dbSelect(fil_prod_below)
                                    ##

                                    label(class="" "for"="fil_prod_until"){$"hasta alcanzar el:"}
                                    ##
                                    do uie.dbSelect(fil_prod_until)
                                    ##
                                }
                            }
                        }

                        div(class="text-end mt-2")
                        {
                            button(class="btn btn-primary btn-sm rounded-0" type="submit"){$"#<@ICON_SAVE> Continuar"}
                        }
                    }
                }
            }
        }

        #$
        script(src="#<@JS_MAIN>"){$""}
        script(src="#<@JS_REQUISICIONES>"){$""}
		script(type="text/javascript")
		{$'
            document.addEventListener("DOMContentLoaded", () => {
                requisiciones.form.url_get_fultimo = "#<@URL_OBTENER_FULTIMO>";
                requisiciones.form.url_get_linea = "#<@URL_OBTENER_LINEAS_XCLASE>";
                requisiciones.form.init();
                InduxsoftNumberFields.Init();
            });
		'}
    }
}