#include "dkli.dkh"
#!
module "Requisiciones"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "dbr.dkh"
    #include "dbr.apps.dkl"
    #include "uielements.v12.dkl"
    #include "../_lib/config.dk"

    do @context.begin(@crud_context)

    ref @_GET = ifnull(@("&parameters"),record.create())
    ref requisiciones = ifnull(@("&./requisiciones"),list.create())
    ref titles = ifnull(@("&./titles"),record.create())

	@_entities_type = @("$parameters/_entities_type")
	table_id = "tbl_"+@_entities_type

    fdr_year_opt = ""
    for i = 2024; i <= @curr_year { fdr_year_opt = fdr_year_opt + str(i) + "," }
    fdr_year_opt = rremove(fdr_year_opt,1)

    new fdr_init
    {
        @"fdr_mode": field.dstr(@_GET,"fdr_mode","month")
        // [month]
        @"fdr_year": field.dnum(@_GET,"fdr_year",@curr_year)
        @"fdr_month": field.dnum(@_GET,"fdr_month",@curr_month)
        // [lastdays]
        @"fdr_range": field.dnum(@_GET,"fdr_range",30)
        // [range]
        @"fdr_from": field.dstr(@_GET,"fdr_from","")
        @"fdr_to": field.dstr(@_GET,"fdr_to","")
    }

    new fil_status
    {
        @"datatable*": ifnull(@("&./list_status"),list.create())
        @"id": "fil_status"
        @"value_field": "id"
        @"text_field": "const"
        @"first_value": "-1"
        @"first_text": "(Todos los estados)"
        @"selected": @("parameters/fil_status")
        member "attributes"
        {
            @"name": "fil_status"
            @"class": "induxsoft-form-select"
            @"title": "Filtrar por estados"
            @"onchange": "filter(this);"
        }
    }

    new fil_type
    {
        @"datatable*": ifnull(@("&./list_tipos"),list.create())
        @"id": "fil_type"
        @"value_field": "id"
        @"text_field": "const"
        @"first_value": "-1"
        @"first_text": "(Todos los tipos)"
        @"selected": @("parameters/fil_type")
        member "attributes"
        {
            @"name": "fil_type"
            @"class": "induxsoft-form-select"
            @"title": "Filtrar por tipo de requisición"
            @"onchange": "filter(this);"
        }
    }

    new fil_csurtido
    {
        @"datatable*": ifnull(@("&./list_csurtido"),list.create())
        @"id": "fil_csurtido"
        @"value_field": "sys_pk"
        @"text_field": "descripcion"
        @"first_value": "-1"
        @"first_text": "(Todos los centros de surtido)"
        @"selected": @("parameters/fil_csurtido")
        member "attributes"
        {
            @"name": "fil_csurtido"
            @"class": "induxsoft-form-select"
            @"title": "Filtrar por centro de surtido"
            @"onchange": "filter(this);"
        }
    }

    new fil_fdr_field
    {
        @"datatable*": from.json('[
            {"id":1, "const":"Elaboración"},
            {"id":2, "const":"Vencimiento"},
        ]')
        @"id": "fil_fdr_field"
        member "attributes"
        {
            @"name": "fil_fdr_field"
            @"class": "induxsoft-form-select"
            @"title": "Elegir método de filtro para el rango de fechas"
            @"onchange": "document.querySelector('#form_filter').submit();"
        }
        @"value_field": "id"
        @"text_field": "const"
        @"selected": @("#parameters/fil_fdr_field")
    }

    new table_definition
    {
        @"datatable*": requisiciones
        @"table_footer": "Mostrando los primeros # registros"
        member @"columns"
        {
            member @"referencia" { @"caption": "Referencia" }
			member @"fecha"
            {
                @"caption": "Elaboración"
                @"align": "center"
            }
            member @"flimite"
            {
                @"caption": "Vencimiento"
                @"align": "center"
            }
            member @"tipo" { @"caption": "Tipo" }
            member @"unidad" { @"caption": "Unidad" }
            member @"csurtido" { @"caption": "C. Surtido" }
            member @"cdivisa"
            {
                @"caption": "Divisa"
                @"align": "center"
            }
            member @"subtotal"
            {
                @"caption": "Subtotal"
                @"align": "end"
            }
            member @"impuestos"
            {
                @"caption": "Impuestos"
                @"align": "end"
            }
            member @"total"
            {
                @"caption": "Total"
                @"align": "end"
            }
            member @"cstatus"
            {
                @"caption": "Estado"
                @"align": "center"
            }
        }
    }

    new nav_config
    {
        @"title": "Requisiciones"
        @"buttons*": @null
        @"urlexit": "/"
        @"main": "TD11,TD12"
        @"actions*": dbr.apps.itemactions(@('&database'),"DET070","action","",0)
        @"reports*": dbr.apps.itemactions(@('&database'),"DET070","report","",0)
        @"jscurrentcontext": "requisiciones.list.getCurrentContext"
    }

    #$
    div(class="container-fluid" id="view")
    {
        // Filtros y acciones
        section(id="top_area")
        {
            #!
            do uie.printV12FormBar(nav_config)
            #$

            form(action="./" method="GET" id="form_filter" class="no-print")
            {
                div(class="d-flex align-items-center mb-1")
                {
                    div
                    {
                        ##
                        do uie.dbSelect(fil_fdr_field)
                        ##
                    }
                    div(class="flex-grow-1")
                    {
                        "filter-date-range"(
                            "form"="#form_filter"
                            "auto-submit"="true"
                            "custom-range"="true"
                            "selection"='#<to.json(fdr_init)>'

                            "mode-field"="fdr_mode"
                            "year-field"="fdr_year"
                            "month-field"="fdr_month"
                            "range-field"="fdr_range"
                            "from-field"="fdr_from"
                            "to-field"="fdr_to"
                            
                            "lastdays-options"="15,30,45,60,90"
                            "years-options"="#<fdr_year_opt>"
                            "month-names"="Enero,Febrero,Marzo,Abril,Mayo,Junio,Julio,Agosto,Septiembre,Octubre,Noviembre,Diciembre"
                            
                            "label-months"="Ver por cada mes"
                            "label-days"="Últ. @lastdays días"
                            "label-custom"="Personalizado"
                            "label-from"="Desde:"
                            "label-to"="Hasta:"
                        ){$""}
                    }
                }
                div(class="w-100 d-flex gap-2 flex-wrap align-items-center mb-1")
                {
                    div(class="d-flex gap-2")
                    {
                        div{ #! do uie.dbSelect(fil_type) } #$
                        div{ #! do uie.dbSelect(fil_csurtido) } #$
                        div{ #! do uie.dbSelect(fil_status) } #$
                    }
                    div(class="flex-grow-1")
                    {
                        "filter-text"(
                            "id"="fil_text"
                            "text-field"="fil_text"
                            "placeholder"="Buscar ..."
                            "form"="#form_filter"
                            "value"="#<@@(@@(@crud_context,'&http/request/get'),'$fil_text')>"
                            "auto-submit"="true"
                            "class"="w-100"
                        ){$""}
                    }
                }
            }
        }
        // Contenido principal
        section(id="work_area")
        {
            div(class="show-on-print")
            {
                p(class="text-center my-0"){$"#<@@(titles,'$title')>"}
                p(class="text-center my-0"){$"#<@@(titles,'$subtitle')>"}
                p(class="text-center my-0"){$"#<@@(titles,'$subtitle_2')>"}

                div(class="row")
                {
                    div(class="col-3 text-start")
                    {
                        small(class="d-block"){ $"#<cut(@('$http/session/user/name'),25)>" }
                        small(class="d-block"){ $"#<date_str(now(),'dd/MMM/yyyy')>" }
                    }
                    div(class="col-6 text-center")
                    {
                        h4(class=""){$"Informe general de #<@_entities_type>"}
                    }
                    div(class="col-3 text-end")
                    {
                        small(class="d-block" id="lbl_filter_1"){$""}
                        small(class="d-block" id="lbl_filter_2"){$""}
                        small(class="d-block" id="lbl_filter_3"){$""}
                    }
                }
            }

            #!
            do uie.dbeditable(table_definition,table_id)
            #$

            div(class="show-on-print"){p(class="fixed-bottom text-center my-1"){$"#<@@(titles,'$footer')>"}}
        }
        // Resúmenes y datos al pie
        section(id="bottom_area")
        {
            //////////////////////////////////////////////////////////////////
            div(id="_custom_area")
            {
                script(src="#<@JS_REQUISICIONES>"){$""}
                script(type="text/javascript")
                {$'
                    function filter(ff) { ff.form.submit(); }

                    document.addEventListener("DOMContentLoaded", () => {
                        requisiciones.list.tableId = "#<table_id>";
                        requisiciones.list.init();

                        // Script injection
                        #<@@(@crud_context,"script")>
                    });
                '}
            }
        }
    }
    #!

    do @context.end()
}