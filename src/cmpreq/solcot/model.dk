#include "dkli.dkh"
#!
module ""
{
    @table_name = "solcot"
    @sys_fields = "sys_pk,sys_guid,sys_dtcreated,sys_timestamp,sys_info,sys_user,sys_lastuser,sys_exported,sys_dtexported,sys_recver,sys_deleted,sys_lock"

    // @create_fields = @sys_fields + ",referencia,folio,proveedor,fenvio,redaccion,notas,req,fresp,cotizacion,completa,cancelada,motivo,ucreo,urecibio,ucancelo"
    // @update_fields = @sys_fields + ",fenvio,redaccion,notas,fresp,cotizacion,completa,cancelada,motivo,urecibio,ucancelo"
    
    // @create_exclude_fields = "sys_lastuser"
    // @update_exclude_fields = "sys_pk,sys_guid,sys_dtcreated,sys_user"
    
    // @create_alias_fields = ""
    // @update_alias_fields = ""

    @read_query = ftext(@qry_solcot)

    buscarProveedor::&db,&params
    {
        if trim(@@(params,"$id")) != ""
        {
            conditions = "AND (pdr.sys_pk = @id OR pdr.sys_guid = @id)"
            return dbr.rec(db,ftext(@qry_buscar_proveedor),params)
        }
        if trim(@@(params,"$search")) != ""
        {
            conditions = "
                AND NOT IFNULL(pdr.sys_deleted,0)
                AND (pdr.codigo LIKE CONCAT('%',@search,'%') OR pdr.nombre LIKE CONCAT('%',@search,'%') OR pdr.rfc LIKE CONCAT('%',@search,'%'))
            "
            return dbr.list(db,ftext(@qry_buscar_proveedor),params)
        }

        return list.create()
    }

    buscarCotizacion::&db,&params
    {
        params<"doctype"> : @cCotizacion

        sql = "
        SELECT
            cmp.sys_pk,
            cmp.referencia,
            DATE_FORMAT(cmp.fecha,'%Y-%m-%d') AS fecha,
            DATE_FORMAT(cmp.vencimiento,'%Y-%m-%d') AS vencimiento,
            IFNULL((((((cmp.subtotal - cmp.descuento1) - cmp.descuento2) + cmp.impuesto1) + cmp.impuesto2) + cmp.impuesto3) + cmp.impuesto4,0) AS total
        FROM compra AS cmp
        WHERE NOT IFNULL(cmp.sys_deleted,0)
            AND cmp.statusadministrativo = 2
            AND cmp.documento = @doctype
            AND cmp.iproveedor = @iproveedor
            AND cmp.referencia LIKE CONCAT('%',@search,'%')
        "
        return dbr.list(db,sql,params)
    }

    obtenerSolicitudes::&db,reqid
    {
        new params { @"reqid": reqid }

        conditions = "OR (NOT IFNULL(sol.sys_deleted,0) AND sol.req = @reqid)"
        return dbr.list(db,ftext(@qry_solcot),params)
    }

    obtenerProductos::&db,id,tipo
    {
        if tipo == "D"
        {
            new params { @"_entity_id": id }
            return dbr.list(db,ftext(@qry_obtener_productos),params)
        }

        if tipo == "C"
        {
            new params { @"idcon": id }

            conditions = "OR (d.ref_req IN (SELECT sys_pk FROM cmpreq WHERE en = @idcon))"
            @qry_obtener_productos = ftext(@qry_obtener_productos)

            sql_consol_prods = "
            SELECT
                sys_pk,
                descripcion,
                unidad,
                precio,
                ROUND(SUM(cantidad),4) AS cantidad,
                ROUND(SUM(impuestos),4) AS impuestos,
                ROUND(SUM(importe),4) AS importe,
                excluido
            FROM (#<@qry_obtener_productos>) AS res
            GROUP BY res.sys_pk
            "
            return dbr.list(db,ftext(sql_consol_prods),params)
        }

        return list.create()
    }

    obtenerCotizaciones::&db,&params
    {
        sql_solicitudes = "
        SELECT
            pdr.sys_pk AS iproveedor,
            pdr.nombre AS `proveedor`,
            cot.sys_pk AS icotizacion,
            ROUND(IFNULL(cot.subtotal,0),4) AS subtotal,
            ROUND(IFNULL(cot.descuento1,0) + IFNULL(cot.descuento2,0),4) AS descuentos,
            ROUND(IFNULL(cot.impuesto1,0) + IFNULL(cot.impuesto2,0) + IFNULL(cot.impuesto3,0) + IFNULL(cot.impuesto4,0),4) AS impuestos,
            ROUND((((((IFNULL(cot.subtotal,0) - IFNULL(cot.descuento1,0)) - IFNULL(cot.descuento2,0)) + IFNULL(cot.impuesto1,0)) + IFNULL(cot.impuesto2,0)) + IFNULL(cot.impuesto3,0)) + IFNULL(cot.impuesto4,0),4) AS total
        FROM solcot AS sol
            INNER JOIN proveedor AS pdr ON pdr.sys_pk = sol.`proveedor`
            INNER JOIN compra AS cot ON cot.sys_pk = sol.cotizacion
        WHERE NOT IFNULL(sol.sys_deleted,0)
            AND NOT IFNULL(sol.cancelada,0)
            AND sol.cotizacion IS NOT NULL
            AND sol.req = @_entity_id
        ORDER BY sol.sys_pk
        "
        ref solicitudes = dbr.list(db,sql_solicitudes,params)
        
        ref list = list.create()

        for i = 0; i < list.count(solicitudes)
        {
            ref solicitud = list.obj(solicitudes,i)

            sql_cotizacion = "
            SELECT
                d.sys_pk AS idetalle,
                d.iproducto,
                p.codigo,
                p.descripcion,
                d.unidad,
                ROUND(d.precio,4) AS precio,
                ROUND(d.cantidad,4) AS cantidad,
                ROUND((d.precio * d.cantidad),4) AS subtotal,
                ROUND((d.descuento1 + d.descuento2),4) AS descuentos,
                ROUND((d.impuesto1 + d.impuesto2 + d.impuesto3 + d.impuesto4),4) AS impuestos,
                ROUND((((((((IFNULL(d.costototal,0) * IFNULL(d.cantidad,0)) - IFNULL(d.descuento1,0)) - IFNULL(d.descuento2,0)) + IFNULL(d.impuesto1,0)) + IFNULL(d.impuesto2,0)) + IFNULL(d.impuesto3,0)) + IFNULL(d.impuesto4,0)),4) AS importe,
                d.notas AS notas
            FROM dcompra d
                INNER JOIN producto p ON p.sys_pk = d.iproducto
            WHERE d.fk_compra_detalle = @icotizacion
            "

            solicitud<"dcot*"> : dbr.list(db,sql_cotizacion,solicitud)
            
            do list.add(list,solicitud)
        }

        return list
    }

    prepareView::&db,&params,&data
    {
        switch @@(params,"$_view")
        {
            case "cmp-in-process"
            {
                new args
                {
                    @"doctype": @cCotizacion
                }

                if not(field.exist(data,"entity")) { data<"entity*"> : dbr.rec(db,ftext(@qry_cmpreq),params) }
                if @@(data,"entity/tipo") == "D" { data<"detail*"> : dbr.list(db,ftext(@qry_obtener_productos),params) }
                else if @@(data,"entity/tipo") == "C"
                {
                    args<"idcon"> : @@(params,"$_entity_id")

                    conditions = "OR (
                        NOT IFNULL(req.sys_deleted,0)
                        AND NOT IFNULL(req.consolidacion,0)
                        AND req.en = @idcon
                    )"

                    data<"detail*"> : dbr.list(db,ftext(@qry_cmpreq),args)
                }

                data<"solicitudes*"> : obtenerSolicitudes(db,@@(params,"$_entity_id"))
                data<"list_series*"> : dbr.list(db, @qry_list_series, args)
                data<"solcot_text"> : trim(dbr.vars.get(db,"cmpreq_redaccion_solcot"))
                break
            }
            case "cc"
            {
                if not(field.exist(data,"entity")) { data<"entity*"> : dbr.rec(db,ftext(@qry_cmpreq),params) }

                data<"productos*"> : obtenerProductos(db, @@(params,"$_entity_id"), @@(data,"entity/tipo"))
                data<"cotizaciones*"> : obtenerCotizaciones(db,params)
                break
            }
            default
            {
                // code...
                break
            }
        }
    }

    module "Vista en proceso de una requisición (cmp.in.process.dk):cmp"
    {
        read::&db,&params
        {
            /* _context = url_dcode(field.dstr(params,"_context","{}"))
            if _context == "" { _context = "{}" }

            ref data = from.json(_context)
            do prepareView(db,params,data) */

            new data
            {
                @"entity*": dbr.rec(db,ftext(@qry_cmpreq),params)
            }
            do prepareView(db,params,data)

            return data
        }
    }

    module "Cuadro comparativo de las solicitudes de una requisición (cc.dk):cc"
    {
        obtenerCotizacionesDeAsignados::&db,&data
        {
            ref list = list.create_from_fields(data)
            ref asignados = record.create()

            for i = 0; i < list.count(list)
            {
                row = list.str(list,i)
                val = field.str(data,row)
                ref part = split(val,";")

                iproveedor = list.num(part,0)
                icotizacion = list.num(part,1)
                idetalle = list.num(part,2)
                iproducto = list.num(part,3)
                
                new info
                {
                    @"iproveedor": iproveedor
                    @"icotizacion": icotizacion
                    @"idetalle": idetalle
                    @"iproducto": iproducto
                }

                keycot = "C" + str(icotizacion)

                if iproveedor == 0 { @cmpreq_status = @stt_incompleto }

                if iproveedor > 0 && not(field.exist(asignados,keycot))
                {
                    ref cotizacion = dbr.rec(db,"SELECT * FROM compra WHERE sys_pk = @icotizacion",info)
                    asignados<keycot+"*"> : cotizacion
                }

                if iproveedor > 0
                {
                    if not(field.exist(asignados,ftext("#<keycot>/_detalle"))) { asignados<keycot+"/_detalle*"> : list.create() }

                    ref detalle = dbr.rec(db,"SELECT * FROM dcompra WHERE fk_compra_detalle = @icotizacion AND sys_pk = @idetalle",info)
                    do list.add(@@(asignados,ftext("&#<keycot>/_detalle")),detalle)
                }
            }

            return asignados
        }

        generarPedido::&db,&params,&data
        {
            cmpreq_id = @@(params,"$_entity_id")
            ref_cmpreq = dbr.str(db,"SELECT referencia FROM cmpreq WHERE sys_pk = @_entity_id",params)

            using data
            {
                @"documento": @cPedido
                @"referencia": path.concat(ref_cmpreq,@@(data,"$referencia"))
                @"statusadministrativo": @stt_adm_cerrado
            }

            @table_name = "compra"
            @create_exclude_fields = @sys_fields
            @read_query = "select sys_pk AS ipedido FROM #<@table_name> WHERE #<@keyfield> = @_entity_id"

            using @childs
            {
                member "_detalle"
                {
                    @"joinfield": "fk_compra_detalle"
                    @"keyfield": "sys_pk"
                    @"table": "dcompra"
                    @"select_query": "SELECT sys_pk AS idetalle, iproducto FROM dcompra WHERE fk_compra_detalle = @ipedido"
                    @"fields": "cantidad,costototal,descuento1,descuento2,factor,impuesto1,impuesto2,impuesto3,impuesto4,notas,precio,status,tipocambio,unidad,xfacturar,documento,doc_partida,iproducto"
                }
            }
            
            do entity.create(db,params,data)
            ref pedido = entity.read(db,params)

            @table_name = "solcot"
            @create_exclude_fields = ""
            @read_query = ftext(@qry_solcot)
            params<"_entity_id"> : cmpreq_id

            return pedido
        }

        asignarPedido::&db,&params,&data
        {
            sql_asignar = "
            UPDATE cmpreq AS con
                RIGHT JOIN cmpreq AS req ON req.en = con.sys_pk
                INNER JOIN dcmpreq AS dtl ON dtl.ref_req = req.sys_pk
            SET dtl.pedido = @idetalle
            WHERE (con.sys_pk = #<cmpreq_id> OR req.sys_pk = #<cmpreq_id>)
                AND dtl.producto = @iproducto
            "

            ref detalle = ifnull(@@(data,"&_detalle"),list.create())
            cmpreq_id = @@(params,"$_entity_id")
            
            for i = 0; i < list.count(detalle)
            {
                ref obj = list.obj(detalle,i)
                do dbr.execute(db,ftext(sql_asignar),obj)
            }
        }

        read::&db,&params
        {
            new data
            {
                @"entity*": dbr.rec(db,ftext(@qry_cmpreq),params)
            }
            do prepareView(db,params,data)
            
            return data
        }

        pedir::&db,&params,&data
        {
            @use_transaction = @false
            @cmpreq_status = @stt_completado
            
            ref asignados = cc.obtenerCotizacionesDeAsignados(db,data)

            do dbr.begin(db)

            ref list = list.create_from_fields(asignados)
            for i = 0; i < list.count(list)
            {
                keycot = list.str(list,i)
                ref cotizacion = field.obj(asignados,keycot)

                ref pedido = cc.generarPedido(db,params,cotizacion)
                do cc.asignarPedido(db,params,pedido)
            }

            ref req = dbr.rec(db,ftext(@qry_cmpreq),params)

            if @@(req,"$tipo") == "D"
            {
                if not(pregop.partida.comprometido(db, @@(req,"$partida_id"), @@(req,"#ejercicio"), @@(req,"#periodo"), (@@(req,"#importe") * -1)))
                { do rise_error(500,"Hubo un problema al afectar el ejercicio correspondiente.") }

                sql_total_pedido = "
                SELECT
                    IFNULL(SUM(ROUND((((((((IFNULL(c.costototal,0) * IFNULL(c.cantidad,0)) - IFNULL(c.descuento1,0)) - IFNULL(c.descuento2,0)) + IFNULL(c.impuesto1,0)) + IFNULL(c.impuesto2,0)) + IFNULL(c.impuesto3,0)) + IFNULL(c.impuesto4,0)),4)),0) AS total
                FROM cmpreq AS req
                    INNER JOIN dcmpreq AS d ON d.ref_req = req.sys_pk
                    INNER JOIN dcompra AS c ON d.pedido = c.sys_pk
                WHERE req.sys_pk = @_entity_id
                "
                total_pedido = dbr.num(db,sql_total_pedido,params)

                if not(pregop.partida.ejercido(db, @@(req,"$partida_id"), @@(req,"#ejercicio"), @@(req,"#periodo"), total_pedido))
                { do rise_error(500,"Hubo un problema al afectar el ejercicio correspondiente de la requisición: " + @@(req,"$referencia")) }
            }

            if @@(req,"$tipo") == "C"
            {
                ref list_reqs = dbr.list(db,"SELECT sys_pk AS _entity_id FROM cmpreq WHERE en = @_entity_id",params)
                for i = 0; i < list.count(list_reqs)
                {
                    ref itm = list.obj(list_reqs,i)
                    ref req = dbr.rec(db,ftext(@qry_cmpreq),itm)

                    if not(pregop.partida.comprometido(db, @@(req,"$partida_id"), @@(req,"#ejercicio"), @@(req,"#periodo"), (@@(req,"#importe") * -1)))
                    { do rise_error(500,"Hubo un problema al afectar el ejercicio correspondiente de la requisición: " + @@(req,"$referencia")) }

                    sql_total_pedido = "
                    SELECT
                        IFNULL(SUM(ROUND((((((((IFNULL(c.costototal,0) * IFNULL(c.cantidad,0)) - IFNULL(c.descuento1,0)) - IFNULL(c.descuento2,0)) + IFNULL(c.impuesto1,0)) + IFNULL(c.impuesto2,0)) + IFNULL(c.impuesto3,0)) + IFNULL(c.impuesto4,0)),4)),0) AS total
                    FROM cmpreq AS req
                        INNER JOIN dcmpreq AS d ON d.ref_req = req.sys_pk
                        INNER JOIN dcompra AS c ON d.pedido = c.sys_pk
                    WHERE req.sys_pk = @_entity_id
                    "
                    total_pedido = dbr.num(db,sql_total_pedido,itm)

                    if not(pregop.partida.ejercido(db, @@(req,"$partida_id"), @@(req,"#ejercicio"), @@(req,"#periodo"), total_pedido))
                    { do rise_error(500,"Hubo un problema al afectar el ejercicio correspondiente de la requisición: " + @@(req,"$referencia")) }
                }
            }

            do dbr.execute(db,ftext("UPDATE cmpreq SET status = #<@cmpreq_status> WHERE sys_pk = @_entity_id"),params)

            do dbr.commit(db)

            exception
            {
                do errordet(@false)
                if dbr.in_transaction(db) { do dbr.rollback(db) }

                ref FormData = record.copy(data,"*")
                code = last_error_code()
                error = last_error()

                do record.clear(data)
                data<"form*"> : FormData

                do prepareView(db,params,data)
                do rise_error(code,error)
            }
        }
    }

    sol.agregarCotizacion::&db,&params,&data
    {
        new solcot
        {
            @"sys_pk": @@(data,"#sys_pk")
            @"sys_timestamp*": now()
            @"sys_recver": @@(data,"#sys_recver")
            @"cotizacion": @@(data,"#cotizacion")
            @"completa": @true
        }

        sql_productos_cotizados = "SELECT GROUP_CONCAT(DISTINCT d.iproducto SEPARATOR ',') AS p_cotizados FROM dcompra AS d WHERE d.fk_compra_detalle = @cotizacion;"
        sql_productos_faltantes = "
        SELECT COUNT(d.`producto`) AS p_faltantes
        FROM cmpreq AS con
            RIGHT JOIN cmpreq AS req ON req.en = con.sys_pk
            INNER JOIN dcmpreq AS d ON d.ref_req = req.sys_pk
        WHERE (con.sys_pk = @cmpreq_id OR req.sys_pk = @cmpreq_id)
            AND d.`producto` NOT IN (#<p_cotizados>)
        "

        p_cotizados = dbr.str(db,sql_productos_cotizados,data)
        p_faltantes = dbr.num(db,ftext(sql_productos_faltantes),data)

        if p_faltantes > 0 { solcot<"completa"> : @false }

        ref entity = entity.update(db,params,solcot)
        return entity
    }

    sol.removerCotizacion::&db,&params,&data
    {
        do dbr.execute(db,"UPDATE solcot SET cotizacion = NULL, completa = FALSE WHERE sys_pk = @_entity_id",params)
        return entity.read(db,params)
    }

    sol.cancelar::&db,&params,&data
    {
        new solcot
        {
            @"sys_pk": @@(data,"#sys_pk")
            @"sys_timestamp*": now()
            @"sys_recver": @@(data,"#sys_recver")
            @"cancelada": @true
            @"motivo": trim(@@(data,"$motivo"))
            @"ucancelo": lib.getPkUsr(db,@@(@http_context, "$session/user/uid"))
        }

        ref entity = entity.update(db,params,solcot)
        return entity
    }

    sol.create::&db,&params,&data
    {
        @use_transaction = @false

        serie = trim(@@(data,"$serie"))
        folio = abs(@@(data,"#folio"))

        do dbr.begin(db)

        iblock = dbr.folios.id_block(db,@cCotizacion,serie)
        if folio > 0 { folio = dbr.folios.set_new(db,iblock,folio,3) }
        else { folio = dbr.folios.set_new(db,iblock,dbr.folios.get_new(db,iblock),3) }
        ref infoFolio = dbr.folios.info(db,iblock,folio)
        referencia = serie + padleft(str(folio),dbr.vars.get(db,"cmpreq_fix_ref_size"),"0")

        new solcot
        {
            @"referencia": referencia
            @"folio": @@(infoFolio,"#sys_pk")
            @"proveedor": @@(data,"#iproveedor")
            @"fenvio*": @null
            @"redaccion": trim(@@(data,"$redaccion"))
            @"notas": trim(@@(data,"$notas"))
            @"req": @@(data,"#req")
            @"ucreo": lib.getPkUsr(db,@@(@http_context, "$session/user/uid"))
        }

        if trim(@@(data,"$fenvio")) != "" { solcot<"fenvio*"> : str2dt(trim(@@(data,"$fenvio"))) }

        ref entity = entity.create(db,params,solcot)
        do dbr.commit(db)

        return entity

        exception
        {
            do errordet(@false)
            if dbr.in_transaction(db) { do dbr.rollback(db) }

            ref FormData = record.copy(data,"*")
            code = last_error_code()
            error = last_error()

            do record.clear(data)
            data<"form*"> : FormData

            do prepareView(db,params,data)
            do rise_error(code,error)
        }
    }

    sol.update::&db,&params,&data
    {
        @use_transaction = @false

        do dbr.begin(db)

        new solcot
        {
            @"sys_pk": @@(data,"#sys_pk")
            @"sys_timestamp*": now()
            @"sys_recver": @@(data,"#sys_recver")
            @"fenvio*": @null
            @"redaccion": trim(@@(data,"$redaccion"))
            @"notas": trim(@@(data,"$notas"))
        }

        if trim(@@(data,"$fenvio")) != "" { solcot<"fenvio*"> : str2dt(trim(@@(data,"$fenvio"))) }

        ref entity = entity.update(db,params,solcot)
        do dbr.commit(db)

        return entity

        exception
        {
            do errordet(@false)
            if dbr.in_transaction(db) { do dbr.rollback(db) }

            ref FormData = record.copy(data,"*")
            code = last_error_code()
            error = last_error()

            do record.clear(data)
            data<"form*"> : FormData

            do prepareView(db,params,data)
            do rise_error(code,error)
        }
    }

    sol.delete::&db,&params
    {
        do rise_error(500,"Acción no implementada")
    }
}