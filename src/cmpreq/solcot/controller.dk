#include "dkli.dkh"
#!
module ""
{
    switch @@(@http_context,"$request/get/_view")
    {
        case "buscar-proveedor"
        {
            point @list to buscarProveedor
            break
        }
        case "buscar-cotizacion"
        {
            point @list to buscarCotizacion
            break
        }
        case "agregar-cotizacion"
        {
            point @update to sol.agregarCotizacion
            break
        }
        case "remover-cotizacion"
        {
            point @update to sol.removerCotizacion
            break
        }
        case "cancelar-solicitud"
        {
            point @update to sol.cancelar
        }
        case "cmp-in-process"
        {
            @form_view = "cmp.in.process.dk"

            point @read to cmp.read
            break
        }
        case "cc"
        {
            @form_view = "cc.dk"
            
            point @read to cc.read
            point @update to cc.pedir
            break
        }
        default
        {
            point @create to sol.create
            point @update to sol.update
            point @delete to sol.delete
            break
        }
    }
}