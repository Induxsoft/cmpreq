#include "dkli.dkh"
#!
module "form.dk"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "uielements.v12.dkl"
    #include "../_lib/config.dk"
	#include "../_lib/icons.dk"
    #include "../_lib/lib.dk"

    do @context.begin(@crud_context)

    ref entity = ifnull(@("&./entity"),record.create())
    ref productos = ifnull(@("&./productos"),list.create())
    ref cotizaciones = ifnull(@("&./cotizaciones"),list.create())

	@_entities_type = @("$parameters/_entities_type")
	@_entity_id = @("$parameters/_entity_id")

    prod_length = list.count(productos)
    cots_length = list.count(cotizaciones)
    url_exit = replace(@CMP_IN_PROCESS,"{ireq}",@_entity_id)
    container = ifstr(cots_length >= 3, 'container-fluid', 'container')

    function searchProducto(&list,iproducto)
    {
        ref detalle = ifnull(list,list.create())
        for i = 0; i < list.count(detalle)
        {
            ref obj = list.obj(detalle,i)
            if @@(obj,"#iproducto") == iproducto { return obj }
        }
        return record.create()
    }

    header_act::
    {
        btn_cls = "btn btn-sm border-secondary induxsoft-corners btn-main-action no-print"

        #$
        button(class="#<btn_cls>" type="submit" id="btn_submit"){$"Generar pedidos"}
        #!
    }

    point general_act to header_act

    new nav_config
    {
        @"title": "Cuadro Comparativo"
        @"buttons*": general_act
        @"urlexit": url_exit
        member @"hidden" { @"print": @true }
    }
    
    #$
    div(class="#<container>")
    {
        link(href="#<@CSS_MAIN>" rel="stylesheet")

        style
        {$'
            tr th { font-size:.9rem; outline:none; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; -o-text-overflow:ellipsis; }
            tr td { font-size:.8rem; }

            @media print {
                body { visibility:hidden; }
                #section-to-print {
                    visibility:visible;
                    position:absolute;
                    left:0;
                    top:0;
                    right:0;
                }
            }

            .bg-light-gray { background-color:#DCDCDC !important; }
            .bg-yellow { background-color:#ffe484 !important; }
            .fw-500 { font-weight:500 !important; }
            .induxsoft-num-field {
                border:0;
                border-radius:0;
                background-color:transparent;
            }
        '}

        div(id="work_area" class="container-section")
        {
            form(method="POST" action="./" id="frm_cc")
            {
                #!
                do uie.printV12FormBar(nav_config)
                #$

                div(class="#<ifstr(@('$error/message')!='','alert alert-danger','')> overflow-auto"){$"#<@('$error/message')>"}

                div(class="" style="display:blobk; position:relative; overflow-x:auto;")
                {
                    table(class="table table-sm border mb-0" id="tbl_cc" style="width:auto; min-width:100%; max-height:90vh;")
                    {
                        thead
                        {
                            tr
                            {
                                th(class="text-center" colspan="7"){$"#<@@(entity,'$referencia')>"}
                                #!
                                for i = 0; i < cots_length
                                {
                                    ref cot = list.obj(cotizaciones,i)
                                    proveedor = @@(cot,"$proveedor")
                                    
                                    #$ th(class="text-center" colspan="5"){$"#<proveedor>"}
                                }
                                #$
                            }
                            tr
                            {
                                th{$""}
                                th(class="text-center"){$"Descripción"}
                                th(class="text-center"){$"Unidad"}
                                th(class="text-center"){$"Cantidad"}
                                th(class="text-center"){$"Precio"}
                                th(class="text-center"){$"Impuestos"}
                                th(class="text-center"){$"Importe"}

                                #!
                                repeat cots_length
                                {
                                    #$
                                    th(class="text-centerborder-start"){$""}
                                    th(class="text-center"){$"P.U"}
                                    th(class="text-center"){$"Descuentos"}
                                    th(class="text-center"){$"Impuestos"}
                                    th(class="text-center"){$"Total"}
                                }
                                #$
                            }
                        }
                        tbody
                        {
                            #!
                            for i = 0; i < prod_length
                            {
                                ref prod = list.obj(productos,i)
                                iproducto = @@(prod,"#sys_pk")
                                unidad_ref = toupper(@@(prod,"$unidad"))
                                cantidad_ref = @@(prod,"#cantidad")
                                precio_ref = @@(prod,"#precio")
                                precio_min = precio_ref
                                row = (i+1)
                                check = ""

                                if field.exist(@("&."),"form")
                                {
                                    value = lib.form(str(row),"tx",@null)
                                    ref part = split(value,";")
                                    check = ifstr(list.num(part,0) == 0, "checked", "")
                                }
                                else { check = "checked" }

                                #$
                                tr
                                {
                                    td(class="text-center")
                                    {
                                        input(class="form-check-input" type="radio" name="#<row>" value="0;0;0;0" id="rd_#<row>_0" onclick="cc.asignar()" "#<check>"="")
                                    }
                                    td(class="text-start"){$"#<@@(prod,'$descripcion')>"}
                                    td(class="text-center"){$"#<@@(prod,'$unidad')>"}
                                    td(class="text-center"){$"#<@@(prod,'#cantidad')>"}
                                    td(class="text-end"){$"#<@@(prod,'#precio')>"}
                                    td(class="text-end"){$"#<@@(prod,'#impuestos')>"}
                                    td(class="text-end"){$"#<@@(prod,'#importe')>"}

                                    #!
                                    for j = 0; j < cots_length
                                    {
                                        ref cot = list.obj(cotizaciones,j)
                                        ref pp = searchProducto(@@(cot,"&dcot"),iproducto)
                                        
                                        iproveedor = @@(cot,"#iproveedor")
                                        icotizacion = @@(cot,"icotizacion")
                                        idetalle = @@(pp,"#idetalle")
                                        unidad_cot = toupper(@@(pp,"$unidad"))
                                        cantidad_cot = @@(pp,"#cantidad")
                                        precio_cot = @@(pp,"#precio")
                                        pdr = (j+1)
                                        check = ""
                                        disabled = ""
                                        cell_msg = ""
                                        cell_cls = ""
                                        input_cls = ""

                                        if field.exist(@("&."),"form")
                                        {
                                            value = lib.form(str(row),"tx",@null)
                                            ref part = split(value,";")
                                            check = ifstr(list.num(part,0) == iproveedor, "checked", "")
                                        }
                                        
                                        if precio_cot <= 0
                                        {
                                            disabled = "disabled"
                                            cell_msg = "No cotizado"
                                            cell_cls = "text-muted text-decoration-line-through"
                                        }
                                        else if unidad_cot != unidad_ref || cantidad_cot != cantidad_ref
                                        {
                                            disabled = "disabled"
                                            cell_msg = "Descalificado"
                                            cell_cls = "bg-warning"
                                        }
                                        else if precio_cot < precio_min
                                        {
                                            precio_min = precio_cot
                                            check = "checked"
                                        }

                                        if precio_cot > 0 && precio_cot <= precio_min && precio_cot != precio_ref && unidad_cot == unidad_ref && cantidad_cot == cantidad_ref
                                        {
                                            cell_cls = "bg-success text-white fw-500"
                                            input_cls = "bg-transparent text-white fw-500"
                                        }

                                        #$
                                        td(class="text-center border-start" title="#<cell_msg>")
                                        {
                                            input(class="form-check-input" type="radio" name="#<row>" value="#<iproveedor>;#<icotizacion>;#<idetalle>;#<iproducto>" id="rd_#<row>_#<pdr>" onclick="cc.asignar()" "data-icot"="#<icotizacion>" "data-idet"="#<idetalle>" "#<check>"="" "#<disabled>"="")
                                        }
                                        td(class="text-end #<cell_cls>" id="td_pu_#<row>_#<pdr>" "data-value"="#<@@(pp,'#precio')>" title="#<cell_msg>"){$"#<@@(pp,'#precio')>"}
                                        td(class="text-end #<cell_cls>" id="td_dto_#<row>_#<pdr>" "data-value"="#<@@(pp,'#descuentos')>" title="#<cell_msg>"){$"#<@@(pp,'#descuentos')>"}
                                        td(class="text-end #<cell_cls>" id="td_imp_#<row>_#<pdr>" "data-value"="#<@@(pp,'#impuestos')>" title="#<cell_msg>"){$"#<@@(pp,'#impuestos')>"}
                                        td(class="text-end #<cell_cls>" id="td_ttl_#<row>_#<pdr>" "data-value"="#<@@(pp,'#importe')>" title="#<cell_msg>"){$"#<@@(pp,'#importe')>"}
                                    }
                                    #$
                                }
                            }
                            #$
                        }
                        tfoot
                        {
                            tr
                            {
                                td(class="text-end fw-bolder" colspan="7"){$"Total pedido:"}
                                #!
                                for i = 0; i < cots_length
                                {
                                    #$ td(class="text-end fw-bolder" colspan="5" id="td_ttl_#<(i+1)>"){$"&nbsp;"}
                                }
                                #$
                            }
                            tr
                            {
                                td(class="text-end fw-bolder" colspan="7"){$"Total:"}
                                td(class="text-start fw-bolder" colspan="#<(5 * cots_length)>" id="td_ttl_pedido"){$""}
                            }
                        }
                    }
                }
            }
        }

        #$
        script(src="#<@JS_MAIN>"){$""}
        script(src="#<@JS_SOLCOT_CC>"){$""}
		script(type="text/javascript")
		{$'
            document.addEventListener("DOMContentLoaded", () => {
                cc.url_exit = "#<url_exit>";
                cc.prod_length = #<prod_length>;
                cc.cots_length = #<cots_length>;
                cc.init();
            });
		'}
    }
}