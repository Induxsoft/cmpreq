#include "dkli.dkh"
#!
module "form.dk"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "uielements.v12.dkl"
    #include "../_lib/config.dk"
	#include "../_lib/icons.dk"
    #include "../_lib/lib.dk"

    do @context.begin(@crud_context)

    ref entity = ifnull(@("&./entity"),record.create())
    ref productos = ifnull(@("&./productos"),list.create())
    ref cotizaciones = ifnull(@("&./cotizaciones"),list.create())

	@_entities_type = @("$parameters/_entities_type")
	@_entity_id = @("$parameters/_entity_id")

    cots_length = list.count(cotizaciones)

    function searchProducto(&list,iproducto)
    {
        for i = 0; i < list.count(list)
        {
            ref obj = list.obj(list,i)
            if @@(obj,"#iproducto") == iproducto { return obj }
        }
        return record.create()
    }

    header_act::
    {
        btn_cls = "btn btn-sm border-secondary induxsoft-corners btn-main-action no-print"

        #$
        button(class="#<btn_cls>" type="submit" id="btn_submit"){$"#<@ICON_SAVE> Generar pedidos"}
        #!
    }

    point general_act to header_act

    new nav_config
    {
        @"title": "Cuadro Comparativo"
        @"buttons*": general_act
        @"urlexit": replace(@CMP_IN_PROCESS,"{ireq}",@_entity_id)
        member @"hidden" { @"print": @true }
    }

    #$
    div(class="container")
    {
        link(href="#<@CSS_MAIN>" rel="stylesheet")

        style
        {$'
            tr th { white-space:nowrap; overflow:hidden; text-overflow:ellipsis; -o-text-overflow:ellipsis; }
            tr td { font-size:.8rem; }
            th { font-size:.9rem; outline:none!important; }

            @media print {
                body { visibility: hidden; }
                #section-to-print {
                    visibility: visible;
                    position: absolute;
                    left: 0;
                    top: 0;
                    right: 0;
                }
            }

            .bg-light-gray { background-color: #DCDCDC !important; }
            .bg-yellow { background-color: #ffe484 !important; }
            .fw-500 { font-weight:500!important; }
        '}

        div(id="work_area" class="container-section")
        {
            form(method="POST" action="./" id="form-cc")
            {
                #!
                do uie.printV12FormBar(nav_config)
                #$

                div(class="#<ifstr(@('$error/message')!='','alert alert-danger','')>"){$"#<@('$error/message')>"}

                table(class="table table-sm table-striped" style="width:auto; min-width:100%; max-height:90vh;")
                {
                    thead
                    {
                        tr(class="")
                        {
                            th(class="text-center" colspan="7"){$"Referencia"}
                            #!
                            for i = 0; i < cots_length
                            {
                                ref cot = list.obj(cotizaciones,i)
                                proveedor = @@(cot,"$proveedor")
                                
                                #$ th(class="text-center" colspan="5"){$"#<proveedor>"}
                            }
                            #$
                        }
                        tr(class="")
                        {
                            th{$""}
                            th(class=""){$"Descripción"}
                            th(class=""){$"Unidad"}
                            th(class=""){$"Cantidad"}
                            th(class=""){$"Precio"}
                            th(class=""){$"Impuestos"}
                            th(class=""){$"Importe"}

                            #!
                            repeat cots_length
                            {
                                #$
                                th(class="border-start"){$""}
                                th(class=""){$"P.U"}
                                th(class=""){$"Descuentos"}
                                th(class=""){$"Impuestos"}
                                th(class=""){$"Total"}
                            }
                            #$
                        }
                    }
                    tbody
                    {
                        #!
                        for i = 0; i < list.count(productos)
                        {
                            ref prod = list.obj(productos,i)
                            iprod = @@(prod,"#iproducto")
                            precio_ref = @@(prod,"#precio")
                            precio_min = precio_ref
                            check = ""

                            if field.exist(@("&."),"form") { check = ifstr(lib.form(str(iprod),"nm",@null) == 0, "checked", "") }
                            else { check = "checked" }

                            #$
                            tr
                            {
                                td{ input(class="form-check-input" type="radio" name="#<iprod>" value="0" "#<check>"="") }
                                td(class="text-start"){$"#<@@(prod,'$descripcion')>"}
                                td(class="text-center"){$"#<@@(prod,'$unidad')>"}
                                td(class="text-center"){$"#<@@(prod,'$cantidad')>"}
                                td(class="text-end"){$"#<@@(prod,'$precio')>"}
                                td(class="text-end"){$"#<@@(prod,'$impuestos')>"}
                                td(class="text-end"){$"#<@@(prod,'$importe')>"}

                                #!
                                for j = 0; j < cots_length
                                {
                                    ref cot = list.obj(cotizaciones,j)
                                    ref pp = searchProducto(@@(cot,"&dcot"),iprod)
                                    
                                    iproveedor = @@(cot,"#iproveedor")
                                    precio_cot = @@(pp,"#precio")
                                    check = ""
                                    cell = ""

                                    if field.exist(@("&."),"form") { check = ifstr(lib.form(str(iprod),"nm",@null) == iproveedor, "checked", "") }
                                    else if check == "" && precio_cot < precio_min {
                                        precio_min = precio_cot
                                        check = "checked"
                                    }

                                    if precio_cot <= precio_min && precio_cot != precio_ref { cell = "bg-success text-white fw-500" }

                                    #$
                                    td(class="border-start"){ input(class="form-check-input" type="radio" name="#<iprod>" value="#<iproveedor>" "#<check>"="") }
                                    td(class="text-end #<cell>"){$"#<@@(pp,'$precio')>"}
                                    td(class="text-end #<cell>"){$"#<@@(pp,'$descuentos')>"}
                                    td(class="text-end #<cell>"){$"#<@@(pp,'$impuestos')>"}
                                    td(class="text-end #<cell>"){$"#<@@(pp,'$importe')>"}
                                }
                                #$
                            }
                        }
                        #$
                    }
                }
            }
        }

        #$
        script(src="#<@JS_MAIN>"){$""}
		script(type="text/javascript")
		{$'
            document.addEventListener("DOMContentLoaded", () => {
                // code...
            });
		'}
    }
}