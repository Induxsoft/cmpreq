#include "dkli.dkh"
#!
program "Controlador de eventos"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "dbr.dkh"
    
    #include "pregop/pregop.dkh"
    #include "../../_lib/config.dk"
    #include "../../_lib/list.queries.dk"

    do @context.begin(@event_context)

    ref db:@("&database")
    ref data:@("&eventdata/output")

    // do file.wtext("___event_context.json", to.json(@event_context))
    // do rise_error(0,"stop!")

    switch trim(@("$event"))
    {
        case "pre_GA14"
        {
            // code...
            break
        }
        case "pos_GA14" // Cancelar documento de compra
        {
            // Finalizar proceso si el documento no pertenece a un Pedido.
            if @@(data,"#idocumento") != @cPedido { break }
            
            new params 
            {
                @"ipedido": @@(data,"#sys_pk")
            }

            cmpreqId = dbr.num(db,"SELECT b.ref_req FROM dcompra a INNER JOIN dcmpreq b ON b.pedido = a.sys_pk WHERE a.fk_compra_detalle = @ipedido LIMIT 1;",params)
            // Finalizar proceso si el Pedido no se genero por una requisición.
            if cmpreqId <= 0 { break }
            
            params<"_entity_id"> : cmpreqId
            @keyfield = "sys_pk"

            ref req = dbr.rec(db,ftext(@qry_cmpreq),params)
            // Finalizar proceso si la requisición no es 'Directa', o no afecta presupuesto de gastos de operación
            if @@(req,"#consolidacion") || @@(req,"#partida") < 1 { break }

            new gop_mov_data
            {
                @"sys_pk": @@(req,"#partida") //(int) Clave primaria de la partida.
                @"referencia": @@(data,"$referencia") //(string) Referencia del elemento que realiza la afectación.
                @"periodo": @@(req,"#periodo") //(int) Mes (MM) sobre el que se hara la afectación.
                @"comprometido": 0 //(decimal) Monto (+\-) de la afectación.
                @"ejercido": (@@(data,"#total") * -1) //(decimal) Monto (+\-) de la afectación.
                @"det": "DET01B" //(string) Código DET (Data Element Type) del elemento que realiza la afectación.
                @"det_id": @@(data,"#sys_pk") //(int) Clave primaria del elemento que realiza la afectación.
                @"usuario": "" //(string) UserId del usuario logueado que realiza la afectación.
                @"notas": "Cancelación del pedido de la requisición: " + @@(req,"$referencia") //(string) Descripción sobre el movimiento de afectación de presupuesto.
            }
            // if not(pregop.partida.ejercido(db, @@(req,"$partida_id"), @@(req,"#ejercicio"), @@(req,"#periodo"), (@@(data,"#total") * -1)))
            if not(pregop.partida.movimiento(db,gop_mov_data))
            { do rise_error(500,"Hubo un problema al afectar el ejercicio correspondiente de la requisición: " + @@(req,"$referencia")) }

            break
        }
        case "ext_GA14"
        {
            // code...
            break
        }
    }

    do @context.end()
}