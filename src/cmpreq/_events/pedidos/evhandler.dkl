#include "dkli.dkh"
#!
program "Controlador de eventos"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "dbr.dkh"
    
    #include "pregop/pregop.dkh"
    #include "../../_lib/list.queries.dk"

    @context.begin(@event_context)

    ref db:@("&database")
    ref data:@("&eventdata")

    switch tolower(trim(@("$event")))
    {
        case "pos_GA14" // Cancelar documento de compra
        {
            new params { @"ipedido": @@(data,"#sys_pk") }

            cmpreqId = dbr.num(db,"SELECT b.ref_req FROM dcompra a INNER JOIN dcmpreq b ON b.pedido = a.sys_pk WHERE a.fk_compra_detalle = @ipedido LIMIT 1;",params)
            if cmpreqId <= 0 { break }
            
            params<"_entity_id"> : cmpreqId
            ref req = dbr.rec(db,ftext(@qry_cmpreq),params)

            if @@(req,"$tipo") != "D" { break }

            sql_total_pedido = "
            SELECT IFNULL(SUM(ROUND((((((((IFNULL(c.costototal,0) * IFNULL(c.cantidad,0)) - IFNULL(c.descuento1,0)) - IFNULL(c.descuento2,0)) + IFNULL(c.impuesto1,0)) + IFNULL(c.impuesto2,0)) + IFNULL(c.impuesto3,0)) + IFNULL(c.impuesto4,0)),4)),0) AS total
            FROM cmpreq AS req
                INNER JOIN dcmpreq AS d ON d.ref_req = req.sys_pk
                INNER JOIN dcompra AS c ON d.pedido = c.sys_pk
            WHERE req.sys_pk = @_entity_id
            "
            total_pedido = dbr.num(db,sql_total_pedido,params)

            if not(pregop.partida.ejercido(db, @@(req,"$partida_id"), @@(req,"#ejercicio"), @@(req,"#periodo"), (total_pedido * -1)))
            { do rise_error(500,"Hubo un problema al afectar el ejercicio correspondiente de la requisición: " + @@(req,"$referencia")) }

            break
        }
        default
        {
            // code...
            break
        }
    }

    @context.end()
}