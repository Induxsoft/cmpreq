#include "dkli.dkh"
#!
module "form.dk"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "uielements.v12.dkl"
    #include "../_lib/config.dk"
	#include "../_lib/icons.dk"
    #include "../_lib/lib.dk"

    do @context.begin(@crud_context)

    ref @_GET = ifnull(@("&parameters"),record.create())
    ref cmpreq = ifnull(@("&./cmpreq"),record.create())

	@_entities_type = @("$parameters/_entities_type")
	@_entity_id = @("$parameters/_entity_id")

    ik_sm_style = "
    #input_search_container, #input_description_container,
    #button_search_container, #button_clear_container {
        height: calc(1.5em + .5rem + 2px) !important;
        padding: .25rem .5rem !important;
        font-size: .875rem !important;
    }
    "

    new sel_serie
    {
        @"id": "sel_serie"
        @"value_field": "serie"
        @"text_field": "serie"
        @"selected": lib.form('serie','nm',cmpreq)
        @"datatable*": ifnull(@("&./list_series"),list.create())
        member "attributes"
        {
            @"class": "form-select form-select-sm rounded-0"
            @"style": "max-width:6rem;"
            @"name": "serie"
            @"required": ""
        }
        member "attr_options"
        {
            @"data-iblock": "#<@@(row,'#sys_pk')>"
        }
    }

    // new sel_almacen
    // {
    //     @"id": "sel_almacen"
    //     @"value_field": "sys_pk"
    //     @"text_field": "descripcion"
    //     @"selected": lib.form('almacen','nm',cmpreq)
    //     @"datatable*": ifnull(@("&./list_almacenes"),list.create())
    //     member "attributes"
    //     {
    //         @"class": "form-select form-select-sm rounded-0"
    //         @"name": "almacen"
    //         @"required": ""
    //     }
    // }

    new sel_csurtido
    {
        @"id": "sel_csurtido"
        @"value_field": "sys_pk"
        @"text_field": "descripcion"
        @"selected": @('#./cc')
        @"datatable*": ifnull(@("&./list_csurtido"),list.create())
        member "attributes"
        {
            @"class": "form-select form-select-sm rounded-0"
            @"name": "cc"
            @"required": ""
        }
    }

    new sel_divisa
    {
        @"id": "sel_divisa"
        @"value_field": "sys_pk"
        @"text_field": "text"
        @"selected": lib.form('divisa','nm',cmpreq)
        @"datatable*": ifnull(@("&./list_divisas"),list.create())
        member "attributes"
        {
            @"class": "form-select form-select-sm rounded-0"
            @"name": "divisa"
            @"required": ""
        }
        member "attr_options"
        {
            @"data-codigo": "#<toupper(@@(row,'$codigo'))>"
            @"data-tcambio": "#<@@(row,'#tcambio')>"
        }
    }

    new sel_status
    {
        @"id": "sel_status"
        @"value_field": "id"
        @"text_field": "const"
        @"selected": field.dnum(ifnull(@("&./form"),cmpreq),"status",1)
        @"datatable*": ifnull(@("&./list_status"),list.create())
        member "attributes"
        {
            @"class": "form-select form-select-sm rounded-0"
            @"name": "status"
            @"required": ""
        }
    }

    new nav_config
    {
        @"title": "Nuevo consolidado"
        @"buttons*": @null
        @"urlexit": @CMP_REQUISICION
        member @"hidden"
        {
            @"print": @true
            @"refresh": @true
        }
    }

    #$
    div(class="container")
    {
        link(href="#<@CSS_MAIN>" rel="stylesheet")

        #!
        do uie.printV12FormBar(nav_config)
        #$

        div(id="work_area" class="container-section")
        {
            div(class="#<ifstr(@('$error/message')!='','alert alert-danger','')>"){$"#<@('$error/message')>"}

            form(method="POST" action="./" id="form-new-cmpreq")
            {
                input(type="hidden" name="sys_pk" value="#<@@(cmpreq,'#sys_pk')>")
                input(type="hidden" name="sys_recver" value="#<@@(cmpreq, '#sys_recver')>")
                input(type="hidden" name="tipo" value="#<@type_req_consl>")

                div(class="row justify-content-center")
                {
                    div(class="col-lg-8 col-md-10 col-sm-12")
                    {
                        div(class="row gx-2")
                        {
                            div(class="col-12 col-sm-4")
                            {
                                label(class="form-label" "for"="sel_serie"){$"Referencia:"}
                                div(class="input-group input-group-sm")
                                {
                                    ##
                                    do uie.dbSelect(sel_serie)
                                    ##
                                    input(class="form-control form-control-sm rounded-0 text-end" type="number" name="folio" value="#<lib.form('folio','num',cmpreq)>" id="txt_folio" min="1" step="1" placeholder="<A>")
                                    button(class="btn btn-light btn-sm rounded-0 border" type="button" id="btn_get_folio" title="Obtener folio disponible para la serie seleccionada"){$"#<@ICON_HDOTS>"}
                                }
                            }
                            div(class="col-6 col-sm-4")
                            {
                                label(class="form-label" "for"="txt_fecha"){$"Elaboración:"}
                                input(class="form-control form-control-sm rounded-0" type="date" name="fecha" value="#<lib.form('fecha','dt',cmpreq)>" id="txt_fecha" required="" title="Fecha formal de elaboración")
                            }
                            div(class="col-6 col-sm-4")
                            {
                                label(class="form-label" "for"="txt_flimite"){$"Vencimiento:"}
                                input(class="form-control form-control-sm rounded-0" type="date" name="flimite" value="#<lib.form('flimite','dt',cmpreq)>" id="txt_flimite" title="Fecha y hora límite para completarla")
                            }
                            /* div(class="col-12 col-lg-8")
                            {
                                label(class="form-label" "for"="ik_unidad_org"){"Unidad organizacional:"}
                                "input-key"(name="unidad_org" id="ik_unidad_org" required="true" "data-key"="sys_pk" "data-search"="codigo" "data-text"="descripcion" 
                                    "data-value"="{}" "data-source"="#<@URL_BUSCAR_UNIDAD_ORG>" columns="codigo,descripcion" colcaptions="Código,Descripción"
                                    "control-styles"="#<ik_sm_style>"
                                ){""}
                            }
                            div(class="col-12 col-sm-6 col-lg-4")
                            {
                                label(class="form-label" "for"="sel_almacen"){"Almacén:"}
                                ##
                                do uie.dbSelect(sel_almacen)
                                ##
                            } */
                            div(class="col-12 col-sm-4")
                            {
                                label(class="form-label" "for"="sel_csurtido"){"Centro de surtido:"}
                                ##
                                do uie.dbSelect(sel_csurtido)
                                ##
                            }
                            div(class="col-12 col-sm-6")
                            {
                                label(class="form-label" "for"="sel_divisa"){$"Divisa:"}
                                ##
                                do uie.dbSelect(sel_divisa)
                                ##
                            }
                            div(class="col-auto col-sm-2")
                            {
                                label(class="form-label" "for"="txt_tcambio"){$"T.Cambio:"}
                                input(class="form-control form-control-sm rounded-0" type="number" name="tcambio" value="#<lib.form('tcambio','nm',cmpreq)>" id="txt_tcambio" min="1" step="0.000001" required="")
                            }
                            div(class="col-auto col-sm-4")
                            {
                                label(class="form-label" "for"="sel_status"){$"Estado:"}
                                ##
                                do uie.dbSelect(sel_status)
                                ##
                            }
                        }

                        div(class="text-end mt-2")
                        {
                            button(class="btn btn-primary btn-sm rounded-0" type="submit"){$"#<@ICON_SAVE> Continuar"}
                        }
                    }
                }
            }
        }

        #$
        script(src="#<@JS_MAIN>"){$""}
        script(src="#<@JS_CONSOLIDADOS>"){$""}
		script(type="text/javascript")
		{$'
            document.addEventListener("DOMContentLoaded", () => {
                consolidados.form.url_get_fultimo = "#<@URL_OBTENER_FULTIMO>";
                consolidados.form.url_get_unialm = "#<@URL_OBTENER_UNIALM>";
                consolidados.form.url_exit = "#<@CMP_REQUISICION>";
                consolidados.form.init();
                InduxsoftNumberFields.Init();
            });
		'}
    }
}