#include "dkli.dkh"
#!
module "form.dk"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "uielements.v12.dkl"
    #include "../_lib/config.dk"
	#include "../_lib/icons.dk"
    #include "../_lib/lib.dk"

    do @context.begin(@crud_context)

    ref @_GET = ifnull(@("&parameters"),record.create())
    ref cmpcon = ifnull(@("&./cmpcon"),record.create())
    ref dcmpcon = ifnull(@("&./dcmpcon"),list.create())

	@_entities_type = @("$parameters/_entities_type")
	@_entity_id = @("$parameters/_entity_id")

    curr_ndt = ndatetime.now()
    curr_year = ndatetime.year(curr_ndt)
    curr_month = ndatetime.month(curr_ndt)
    curr_day = ndatetime.day(curr_ndt)
    empty_rows = "[{},{},{},{},{},{},{},{},{},{}]"

    if @("$error/message") != "" {
        _detalle = @("$./form/_detalle")
        if _detalle != "" { ref dcmpcon = from.json(_detalle) }
    }
    
    if list.count(dcmpcon) <= 0 { ref dcmpcon = from.json(empty_rows) }
    else
    {
        er = list.count(from.json(empty_rows)) - list.count(dcmpcon)
        repeat er
        {
            do list.add(dcmpcon,record.create())
        }
    }

    header_act::
    {
        #$
        button(class="btn btn-sm border-secondary induxsoft-corners btn-main-action no-print" type="button" id="btn_approve"){$"#<@ICON_CHECK> Aprobar"}
        button(class="btn btn-sm border-secondary induxsoft-corners btn-main-action no-print" type="button" id="btn_inprocess"){$"#<@ICON_PROCESS> En proceso"}
        button(class="btn btn-sm border-secondary induxsoft-corners btn-main-action no-print" type="button" id="btn_complete"){$"#<@ICON_FILE_CHECK> Completar"}
        button(class="btn btn-sm border-secondary induxsoft-corners btn-main-action no-print" type="button" id="btn_cancel"){$"#<@ICON_FILE_CANCEL> Cancelar"}
        button(class="btn btn-sm border-secondary induxsoft-corners btn-main-action no-print" type="button" id="btn_submit"){$"#<@ICON_SAVE>"}
        #!
    }

    point general_act to header_act

    new nav_config
    {
        @"title": @@(cmpcon,"$referencia")
        @"buttons*": general_act
        @"urlexit": @CMP_REQUISICION
        member @"hidden" { @"print": @true }
    }

    #$
    div(class="container")
    {
        link(href="#<@CSS_MAIN>" rel="stylesheet")

        #! do uie.printV12FormBar(nav_config)

        #$
        div(id="work_area" class="container-section")
        {
            div(class="#<ifstr(@('$error/message')!='','alert alert-danger','')>"){$"#<@('$error/message')>"}

            form(method="POST" action="./" id="form-edt-cmpcon")
            {
                input(type="hidden" name="sys_pk" value="#<@@(cmpcon,'#sys_pk')>")
                input(type="hidden" name="sys_recver" value="#<@@(cmpcon, '#sys_recver')>")

                div(class="row gx-2")
                {
                    div(class="col-lg-2 col-md-3 col-sm-6")
                    {
                        label(class="form-label" "for"="txt_fecha"){$"Elaboración:"}
                        input(class="form-control form-control-sm rounded-0" type="date" name="fecha" value="#<lib.form('fecha','dt',cmpcon)>" id="txt_fecha" required="" title="Fecha formal de elaboración")
                    }

                    div(class="col-lg-2 col-md-3 col-sm-6")
                    {
                        label(class="form-label" "for"="txt_flimite"){$"Vencimiento:"}
                        input(class="form-control form-control-sm rounded-0" type="date" name="flimite" value="#<lib.form('flimite','dt',cmpcon)>" id="txt_flimite" title="Fecha y hora límite para completarla")
                    }

                    div(class="col-lg-2 col-md-3 col-sm-6")
                    {
                        label(class="form-label" "for"="txt_divisa"){$"Divisa:"}
                        input(class="form-control form-control-sm rounded-0" type="text" value="#<@@(cmpcon,'$ddivisa')>" id="txt_divisa" "data-codigo"="#<@@(cmpcon,'$cdivisa')>" disabled="")
                    }

                    div(class="col-lg-2 col-md-3 col-sm-6")
                    {
                        label(class="form-label" "for"="txt_tcambio"){$"T.Cambio:"}
                        input(class="form-control form-control-sm rounded-0 induxsoft-num-field mw-100" type="number" name="tcambio" value="#<lib.form('tcambio','nm',cmpcon)>" id="txt_tcambio" min="1" max="999999.999999" step="0.000001" required="" "num-decs"="6")
                    }
                }

                label(class="form-label" "for"="txt_notas"){$"Notas:"}
                textarea(class="form-control rounded-0" name="notas" id="txt_notas" maxlength="32000"){$"#<lib.form('notas','tx',cmpcon)>"}

                input(type="hidden" name="_requisiciones" value="" id="txt_requisiciones")
                input(type="hidden" name="_detalle" value="" id="txt_detalle")
            }

            div(class="alert alert-danger rounded-0 mb-1 py-0 d-none" role="alert" id="tbl_alerts"){$""}

            nav(class="mt-2")
            {
                div(class="nav nav-tabs mb-2" id="nav-tab" role="tablist")
                {
                    button(class="nav-link py-1 active" id="nav-requisiciones-tab" "data-bs-toggle"="tab" "data-bs-target"="#nav-requisiciones" type="button" role="tab" "aria-controls"="nav-requisiciones" "aria-selected"="true"){$"Requisiciones"}
                    button(class="nav-link py-1" id="nav-productos-tab" "data-bs-toggle"="tab" "data-bs-target"="#nav-productos" type="button" role="tab" "aria-controls"="nav-productos" "aria-selected"="false"){$"Productos"}
                }
            }
            div(class="tab-content")
            {
                div(class="tab-pane fade show active" id="nav-requisiciones" role="tabpanel" "aria-labelledby"="nav-requisiciones-tab")
                {
                    div(class="d-flex justify-content-end align-items-center gap-1 px-2 my-1" id="tbl_action_bar")
                    {
                        small(class="flex-grow-1 text-muted"){$""}

                        button(class="btn btn-sm d-flex align-items-center justify-content-center gap-2 no-shadow rounded-0" type="button" id="btn-add-req" title="Agregar requisición"){$"#<@ICON_DOCUMENT> Agregar"}
                        button(class="btn btn-sm d-flex align-items-center justify-content-center gap-2 no-shadow rounded-0" type="button" id="btn-rem-req" title="Remover requisición"){$"#<@ICON_FILE_DASH> Remover"}
                    }
                    div(class="" id="div_tbl_requisiciones" style="width:auto; min-width:100%; max-height:55vh; display:flex;")
                    {
                        "edit-table"(id="tbl_requisiciones" data="#<to.json(dcmpcon)>" "auto-confirm"="true" style="width:100%;"
                        "row-height"="1.2rem"
                        "control-styles"="
                            tr th{ white-space:nowrap; overflow:hidden; text-overflow:ellipsis; -o-text-overflow:ellipsis; }
                            tr td { font-size:.8rem; }
                            th { font-size:.9rem; outline:none !important; font-weight:500 !important; }
                            #__table_input { font-size:unset !important; }
                        ")
                        {
                            "edit-thead"
                            {
                                "edit-tr"
                                {
                                    "edit-th"(type="NoEditable" field="referencia"){$"Referencia"}
                                    "edit-th"(type="NoEditable" field="unidad_org"){$"Unidad Organizacional"}
                                    "edit-th"(type="NoEditable" field="ejercicio" textalign="center"){$"Ejercicio"}
                                    "edit-th"(type="NoEditable" field="partida_pre"){$"Partida Presupuestal"}
                                    "edit-th"(type="NoEditable" field="periodo" textalign="center"){$"Periodo"}
                                    "edit-th"(type="NoEditable" field="fecha" textalign="center"){$"Elaboración"}
                                    "edit-th"(type="NoEditable" field="flimite" textalign="center"){$"Vencimiento"}
                                    "edit-th"(type="NoEditable" field="cdivisa" textalign="center"){$"Divisa"}
                                    "edit-th"(type="NoEditable" field="tcambio" textalign="center"){$"T.Cambio"}
                                    "edit-th"(type="NoEditable" field="subtotal" textalign="end" format="true" thousandssep="," decs="4"){$"Subtotal"}
                                    "edit-th"(type="NoEditable" field="impuestos" textalign="end" format="true" thousandssep="," decs="4"){$"Impuestos"}
                                    "edit-th"(type="NoEditable" field="importe" textalign="end" format="true" thousandssep="," decs="4"){$"Importe"}
                                }
                            }
                        }
                    }
                }

                div(class="tab-pane fade" id="nav-productos" role="tabpanel" "aria-labelledby"="nav-productos-tab")
                {
                    div(class="" id="div_tbl_productos" style="width:auto; min-width:100%; max-height:55vh; display:flex;")
                    {
                        "edit-table"(id="tbl_productos" data="#<empty_rows>" "auto-confirm"="true" style="width:100%;"
                        "row-height"="1.2rem"
                        "control-styles"="
                            tr th{ white-space:nowrap; overflow:hidden; text-overflow:ellipsis; -o-text-overflow:ellipsis; }
                            tr td { font-size:.8rem; }
                            th { font-size:.9rem; outline:none !important; font-weight:500 !important; }
                            #__table_input { font-size:unset !important; }
                        ")
                        {
                            "edit-thead"
                            {
                                "edit-tr"
                                {
                                    "edit-th"(type="NoEditable" field="codigo"){$"Código"}
                                    "edit-th"(type="NoEditable" field="descripcion"){$"Descripción"}
                                    "edit-th"(type="NoEditable" field="unidad" textalign="center"){$"Unidad"}
                                    "edit-th"(type="NoEditable" field="precio" textalign="end" format="true" thousandssep="," decs="4"){$"Precio"}
                                    "edit-th"(type="NoEditable" field="cantidad" textalign="center"){$"Cantidad"}
                                    "edit-th"(type="NoEditable" field="subtotal" textalign="end" format="true" thousandssep="," decs="4"){$"Subtotal"}
                                    "edit-th"(type="NoEditable" field="impuestos" textalign="end" format="true" thousandssep="," decs="4"){$"Impuestos"}
                                    "edit-th"(type="NoEditable" field="importe" textalign="end" format="true" thousandssep="," decs="4"){$"Importe"}
                                    "edit-th"(type="NoEditable" field="notas"){$"Notas"}
                                }
                            }
                        }
                    }
                }
            }

            div(class="d-flex justify-content-between w-100 bg-light p-2 border")
            {
                b{$"Subtotal: " span(id="lbl_subtotal"){$""}}
                b{$"Impuesto: " span(id="lbl_impuesto"){$""}}
                b{$"Total: " span(id="lbl_importe"){$""}}
            }
        }

        div
        {
            "input-key"(id="ik_requisicion" "data-key"="sys_pk" "data-search"="referencia" "data-text"="partida" "data-source"="#<@URL_BUSCAR_REQUISICION>" columns="referencia,partida_pre,ejercicio,cdivisa" colcaptions="Referencia,Partida,Ejercicio,Divisa" "box-title-text"="Seleccione una requisición" "control-styles"="#container{display:none !important;}"){$""}
        }

        #$
        script(src="#<@JS_MAIN>"){$""}
        script(src="#<@JS_CONSOLIDADOS>"){$""}
		script(type="text/javascript")
		{$'
            document.addEventListener("DOMContentLoaded", () => {
                consolidados.edit.url_get_productos = "#<@URL_OBTENER_PRODUCTOS>";
                consolidados.edit.url_exit = "#<@CMP_REQUISICIONES>";
                consolidados.edit.formId = "form-edt-cmpcon";
                consolidados.edit.tableReqId = "tbl_requisiciones";
                consolidados.edit.tableProdId = "tbl_productos";
                consolidados.edit.init();
                InduxsoftNumberFields.Init();
            });
		'}
    }
}