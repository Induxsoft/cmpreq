#include "dkli.dkh"
#!
module "Consolidaciones :con"
{
    @table_name = "cmpreq"
    @sys_fields = "sys_pk,sys_guid,sys_dtcreated,sys_timestamp,sys_info,sys_user,sys_lastuser,sys_exported,sys_dtexported,sys_recver,sys_deleted,sys_lock"

    @create_fields = @sys_fields + ",tipo,referencia,folio,fecha,flimite,divisa,tcambio,status,notas,subtotal,impuestos,consolidacion,cc,ucreo,uaprobo"
    @update_fields = @sys_fields + ",fecha,flimite,tcambio,status,notas,subtotal,impuestos,uaprobo"
    
    @create_exclude_fields = "sys_lastuser"
    @update_exclude_fields = "sys_pk,sys_guid,sys_dtcreated,sys_user,status"
    
    @create_alias_fields = ""
    @update_alias_fields = ""

    @list_query = @qry_list_cmpreq
    @read_query = @qry_cmpcon

    buscarRequisicion::&db,&params
    {
        if trim(@@(params,"$idcon")) != ""
        {
            conditions = "OR (
                NOT IFNULL(req.sys_deleted,0)
                AND req.en = @idcon
            )"
        }
        if trim(@@(params,"$search")) != ""
        {
            conditions = ftext("OR (
                NOT IFNULL(req.sys_deleted,0)
                AND NOT IFNULL(req.consolidacion,0)
                AND req.en IS NULL
                AND req.`status` = #<@stt_req_aprobado>
                AND (req.cc IS NULL OR req.cc = @icconsumo)
                AND (req.referencia LIKE CONCAT('%',@search,'%') OR pda.partida LIKE CONCAT('%',@search,'%'))
            )")
        }

        return dbr.list(db,ftext(@qry_cmpreq),params)
    }

    obtenerProductos::&db,&params
    {
        return dbr.list(db,ftext(@qry_obtener_productos),params)
    }

    obtenerRequisiciones::&db,idcon
    {
        new params { @"idcon": idcon }
        return buscarRequisicion(db,params)
    }

    prepareView::&db,&params,&data
    {
        isNew = (@@(params,"$_entity_id") == "_new")

        if isNew
        {
            new args
            {
                @"doctype": @cRequisicion
            }

            using data
            {
                @"list_csurtido*": dbr.list(db,"SELECT b.sys_pk, b.descripcion FROM cmpreq_cc a INNER JOIN cconsumo b ON a.cc = b.sys_pk",@null)
                @"list_series*": dbr.list(db, @qry_list_series, args)
                @"list_status*": dbr.list(db,"SELECT * FROM cmpreq_status WHERE id < 10",@null)
                @"list_divisas*": dbr.list(db, @qry_list_divisas, @null)
            }
        }
        else
        {
            if not(field.exist(data,"cmpcon")) { data<"cmpcon*"> : entity.read(db,params) }
            data<"dcmpcon*"> : obtenerRequisiciones(db,@@(params,"$_entity_id"))
        }
    }

    list::&db,&params
    {
        new data
        {
            @"consolidados*": entity.list(db,params)
        }

        return data
    }

    read::&db,&params
    {
        if not(isset("@just_read_entity")) { @just_read_entity = @false }
        if @just_read_entity { return entity.read(db,params) }

        new data
        {
            @"cmpcon*": entity.read(db,params)
        }
        do prepareView(db,params,data)

        return data
    }

    blank::&db,&params
    {
        new data {}
        do prepareView(db,params,data)

        return data
    }

    create::&db,&params,&data
    {
        @use_transaction = @false
        @just_read_entity = @true
        
        serie = trim(@@(data,"$serie"))
        folio = abs(@@(data,"#folio"))

        do dbr.apps.action.pre("TD21")
        do dbr.begin(db)

        iblock = dbr.folios.id_block(db,@cRequisicion,serie)
        if folio > 0 { folio = dbr.folios.set_new(db,iblock,folio,3) }
        else { folio = dbr.folios.set_new(db,iblock,dbr.folios.get_new(db,iblock),3) }
        ref infoFolio = dbr.folios.info(db,iblock,folio)

        referencia = serie + padleft(str(folio),6,"0")

        new cmpcon
        {
            @"sys_user": @@(@http_context, "$session/user/uid")
            @"ucreo": lib.GetPkUsr(db,@@(@http_context, "$session/user/uid"))
            @"consolidacion": @true
            @"tipo": @type_req_consl
            @"referencia": referencia
            @"folio": @@(infoFolio,"#sys_pk")
            @"fecha": @@(data,"$fecha")
            @"flimite": @@(data,"$flimite")
            @"cc": @@(data,"#cc")
            @"divisa": @@(data,"#divisa")
            @"tcambio": @@(data,"#tcambio")
            @"status": @@(data,"#status")
            @"subtotal": 0
            @"impuestos": 0
        }

        if @@(cmpcon,"$fecha") == "" { do rise_error(511,"No se establecio la fecha de elaboración.") }
        if @@(cmpcon,"#cc") < 1 { do rise_error(512,"No se ha indicado el centro de surtido.") }
        if @@(cmpcon,"#divisa") < 1 { do rise_error(513,"No se ha indicado una divisa.") }
        if @@(cmpcon,"#tcambio") <= 0 { do rise_error(514,"Debe especificar un tipo de cambio válido.") }
        if @@(cmpcon,"#status") < 0 { cmpcon<"status"> : @stt_req_borrador }
        if @@(cmpcon,"$flimite") == "" { do field.remove(cmpcon,"flimite") }
        
        ref entity = entity.create(db,params,cmpcon)

        do dbr.apps.action.pos(entity)
        do dbr.commit(db)
        do dbr.apps.action.ext(entity)

        @url_redir = path.concat(@CMP_CONSOLIDADO, @@(entity,"$sys_pk") + "/")
        return entity

        exception
        {
            do errordet(@false)
            if dbr.in_transaction(db) { do dbr.rollback(db) }

            ref FormData = record.copy(data,"*")
            code = last_error_code()
            error = last_error()

            do record.clear(data)
            data<"form*"> : FormData

            do prepareView(db,params,data)
            do dbr.apps.action.log()
            do rise_error(code,error)
        }
    }

    update::&db,&params,&data
    {
        @use_transaction = @false
        @just_read_entity = @true

        do dbr.apps.action.pre("TD22")
        do dbr.begin(db)

        new cmpcon
        {
            @"sys_lastuser": @@(@http_context, "$session/user/uid")
            @"sys_recver": @@(data,"#sys_recver")

            @"fecha": @@(data,"$fecha")
            @"flimite": @@(data,"$flimite")
            @"subtotal": 0
            @"impuestos": 0
            @"tcambio": @@(data,"#tcambio")
            @"notas": trim(@@(data,"$notas"))
        }

        if @@(cmpcon,"$flimite") == "" { do field.remove(cmpcon,"flimite") }

        new args
        {
            @"conId": @@(params,"$_entity_id")
            @"reqsId": trim(@@(data,"$_requisiciones"))
        }
        do dbr.execute(db,"UPDATE cmpreq SET en = NULL WHERE en = @conId",args)
        if @@(args,"$reqsId") != ""
        {
            // Agregar requisiciones directas a requisición consolidada
            do dbr.execute(db,"UPDATE cmpreq SET en = @conId WHERE sys_pk IN("+@@(args,"$reqsId")+")",args)
            // Asegurar un mismo centro de surtido para las requisiciones del consolidado
            do dbr.execute(db,"UPDATE cmpreq cn INNER JOIN cmpreq rq ON rq.en = cn.sys_pk SET rq.cc = cn.cc WHERE cn.sys_pk = @conId",args)
        }

        ref tt = dbr.rec(db,"SELECT ROUND(SUM(subtotal),4) subtotal, ROUND(SUM(impuestos),4) impuestos FROM cmpreq WHERE en = @conId",args)
        cmpcon<"subtotal"> : @@(tt,"#subtotal")
        cmpcon<"impuestos"> : @@(tt,"#impuestos")

        ref entity = entity.update(db,params,cmpcon)
        
        do dbr.apps.action.pos(entity)
        do dbr.commit(db)
        do dbr.apps.action.ext(entity)

        @url_redir = @CMP_REQUISICION
        return entity

        exception
        {
            do errordet(@false)
            if dbr.in_transaction(db) { do dbr.rollback(db) }

            ref FormData = record.copy(data,"*")
            code = last_error_code()
            error = last_error()

            do record.clear(data)
            data<"form*"> : FormData

            do prepareView(db,params,data)
            do dbr.apps.action.log()
            do rise_error(code,error)
        }
    }

    delete::&db,&params
    {
        do rise_error(500,"Acción no implementada")
    }
}