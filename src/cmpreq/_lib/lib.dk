#include "dkli.dkh"
#pattern function "function '$name' ()"
#!
module "Funciones de propósito general:lib"
{
    function hoy(fmt)
    {
        return date_str(now(),str(fmt))
    }

    function between(value, min, max)
    {
        return value >= min && value <= max
    }

    function record_combine(&obj1,&obj2)
    {
        return record.copyexin(obj2,obj1,"*",",","",":")
    }

    function newrec()
    {
        new record
        {
            @"sys_pk": 0
            @"sys_guid": uuid()
            @"sys_dtcreated*": now()
            @"sys_timestamp*": now()
            @"sys_info": ""
            @"sys_user": ""
            @"sys_lastuser": ""
            @"sys_exported": @false
            @"sys_dtexported*": @null
            @"sys_recver": 0
            @"sys_deleted": @false
            @"sys_lock": 0
        }
        return record
    }

    function date_format(str,fmt)
    {
        fecha = trim(str(str))
        formato = trim(str(fmt))

        if fecha == "" { return "" }
        if formato == "" { formato = "yyyy-MM-ddTHH:mm:ss" }

        ref datetime = str2dt(fecha)
        fecha = date_str(datetime,formato)

        return fecha

        exception
        {
            // do rise_error(99,"Debe proporcionar una cadena de fecha con un formato válido.")
            do clear_exceptions()
            return ""
        }
    }

    function list_years(yearsBack,yearsForward)
    {
        ndt = ndatetime.now()
        yearFrom = ndatetime.add(ndt, ((yearsBack + 1) * -1), "y")
        
        ref list = list.create()
        date = yearFrom

        for i = 1; i < yearsBack + (yearsForward + 2)
        {
            date = ndatetime.add(date,1,'y')
            do list.add(list, ndatetime.year(date))
        }
        return list
    }

    function base_url(withPort)
    {
        prot = ifstr(parse.bool(@@(@http_context,"$request/headers/HTTPS")),"https","http")
        host = @@(@http_context, "$request/headers/HTTP_HOST")
        port = @@(@http_context, "$request/headers/SERVER_PORT")

        if parse.bool(withPort) { return prot+"://"+host+":"+port }
        return prot+"://"+host
    }

    function form(name,type,&obj)
    {
        if isnull(obj) { ref obj:record.create() }
        name = trim(str(name))
        type = trim(str(type))
        
        if isanyword(type,"nm,num,number")
        {
            value = @("#./form/"+name)
            if value == 0 { value = @("#input/"+name) }
            if value == 0 { value = @@(obj,"#"+name) }
            return value
        }
        else if isanyword(type,"rd,rdb,ch,chk")
        {
            bool = trim(@("$./form/"+name))
            if bool == "" { bool = trim(@("$input/"+name)) }
            if bool == "" { bool = trim(@@(obj,"$"+name)) }
            return ifstr(parse.bool(bool),"checked","")
        }
        else
        {
            value = trim(@("$./form/"+name))
            if value == "" { value = trim(@("$input/"+name)) }
            if value == "" { value = trim(@@(obj,"$"+name)) }
            return value
        }
    }

    // Si no hay más de {minrows} filas, autorellenar con filas vacias.
    function AutoFillRows(&list,minrows)
    {
        if isnull(list){ ref list = list.create() }

        add = (minrows - list.count(list))
        repeat add
        {
            do list.add(list,record.create())
        }

        return list
    }

    function PackExist(&db,packId)
    {
        new p { @"id": packId }

        apps = dbr.num(db,"SELECT COUNT(*) FROM sys_app_catalog WHERE pack_id = @id;",p)
        return apps > 0

        exception
        {
            do pop_exception()
            return @false
        }
    }

    function GetPkUsr(&db,usrId)
    {
        new params { @"id": usrId }
        return dbr.num(db,"SELECT sys_pk FROM tuser WHERE sys_pk = @id OR sys_guid = @id OR userid = @id",params)
    }
}