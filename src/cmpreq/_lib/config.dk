#include "dkli.dkh"
#!
module
{
	if not(isset("@http_context")) && isset("@crud_context") { ref @http_context = @@(@crud_context,"&http") }

	@curr_ndt = ndatetime.now()
    @curr_year = ndatetime.year(@curr_ndt)
    @curr_month = ndatetime.month(@curr_ndt)
    @curr_day = ndatetime.day(@curr_ndt)

	//* ======================================== [ CONSTANTS ]
	ref @periodos = from.json('[
		{"id":1,"const":"Enero"},
		{"id":2,"const":"Febrero"},
		{"id":3,"const":"Marzo"},
		{"id":4,"const":"Abril"},
		{"id":5,"const":"Mayo"},
		{"id":6,"const":"Junio"},
		{"id":7,"const":"Julio"},
		{"id":8,"const":"Agosto"},
		{"id":9,"const":"Septiembre"},
		{"id":10,"const":"Octubre"},
		{"id":11,"const":"Noviembre"},
		{"id":12,"const":"Diciembre"},
		{"id":13,"const":"Extraordinario"},
	]')

	// cdocumentos
	@cCotizacion = 1
	@cPedido = 2
	@cRequisicion = 70
	// cmpreq_type
	@type_req_gop = 1
	@type_req_stock = 2
	@type_req_gral = 3
	@type_req_sup = 4
	@type_req_consl = 10
	// cmpreq_status
	@stt_req_borrador = 0
	@stt_req_xaprobar = 1
	@stt_req_aprobado = 10
	@stt_req_nproceso = 20
	@stt_req_completado = 30
	@stt_req_incompleto = 31
	@stt_req_cancelado = 99
	// cstatusadministrativos
	@stt_adm_na = 0
	@stt_adm_abierto = 1
	@stt_adm_cerrado = 2
	@stt_adm_procesado = 3
	@stt_adm_cancelado = 99
	// cstatusordenproduccion
	@stt_orden_en_espera = 0
	@stt_orden_en_proceso = 1
	@stt_orden_parcialmente_terminada = 2
	@stt_orden_terminada = 3
	@stt_orden_cancelada = 4

	@default_max_rows = 250 // limite de registros para las vistas de lista

	//bitacora
	@URL_BITACORA="/!/webshell/log/DET070/@guid/"

	//* ======================================== [ _STATIC RESOURCES ]
	@CSS_MAIN = "/$/cmpreq/css/main.css"
	@JS_MAIN = "/$/cmpreq/js/main.js"
	@JS_REQUISICIONES = "/$/cmpreq/js/requisiciones.js"
	@JS_APROVISIONAR = "/$/cmpreq/js/aprovisionar.js"
	@JS_SURTIR = "/$/cmpreq/js/surtir.js"
	@JS_CONSOLIDADOS = "/$/cmpreq/js/consolidados.js"
	@JS_SOLCOT = "/$/cmpreq/js/solcot.js"
	@JS_SOLCOT_CC = "/$/cmpreq/js/solcot.cc.js"

	//* ======================================== [ _PACKAGE ]
	@URL_BUSCAR_UNIDAD_ORG = "/!/cmpreq/requisiciones/?_view=buscar-unidad-org&search=@search"
	@URL_BUSCAR_PARTIDA_PRE = "/!/cmpreq/requisiciones/?_view=buscar-partida-pre&search=@search"
	@URL_BUSCAR_PRODUCTO = "/!/cmpreq/requisiciones/?_view=buscar-producto&search=@search"
	@URL_BUSCAR_CPRODUCCION = "/!/cmpreq/requisiciones/?_view=buscar-cproduccion&icconsumo=@icconsumo&iproducto=@iproducto&search=@search"
	@URL_BUSCAR_REQUISICION = "/!/cmpreq/consolidados/?_view=buscar-requisicion&icconsumo=@icconsumo&search=@search"
	@URL_BUSCAR_PROVEEDOR = "/!/cmpreq/solcot/?_view=buscar-proveedor&search=@search"
	@URL_BUSCAR_COTIZACION = "/!/cmpreq/solcot/?_view=buscar-cotizacion&search=@search"
	@URL_BUSCAR_CCONSUMO = "/!/cmpreq/cs/?action=buscar-cconsumo&search=@search"
	@URL_BUSCAR_ALMACEN = "/!/cmpreq/unialm/?action=buscar-almacen&s=@search"
	@URL_OBTENER_UNIALM = "/!/cmpreq/unialm/?action=buscar-almacen&u=@unidad"
	@URL_OBTENER_FULTIMO = "/!/cmpreq/requisiciones/{iblock}/obtener-fultimo/"
	@URL_OBTENER_PRODUCTOS = "/!/cmpreq/consolidados/{ireq}/obtener-productos/"
	@URL_OBTENER_LINEAS_XCLASE = "/!/cmpreq/requisiciones/?_view=obtener-lineas&iclase=@iclase"
	@URL_CHANGE_STATUS = "/!/cmpreq/requisiciones/{ireq}/change-status/"
	@URL_ADD_COTIZACION = "/!/cmpreq/solcot/{isol}/agregar-cotizacion/"
	@URL_DEL_COTIZACION = "/!/cmpreq/solcot/{isol}/remover-cotizacion/"
	@URL_CANCELAR_SOLICITUD = "/!/cmpreq/solcot/{isol}/cancelar-solicitud/"
	@URL_AGREGAR_PEDIDO = "/!/compras/compras/_new/"
	@URL_NEW_MOVINV = "/!/inventario/movimiento/_new/"

	@CMP_REQUISICION = "/!/cmpreq/requisiciones/"
	@CMP_APROVISIONAR = "/!/cmpreq/requisiciones/{ireq}/aprovisionar/"
	@CMP_SURTIR = "/!/cmpreq/requisiciones/{ireq}/surtir/"
	@CMP_CONSOLIDADO = "/!/cmpreq/consolidados/"
	@CMP_SOLCOT = "/!/cmpreq/solcot/"
	@CMP_IN_PROCESS = "/!/cmpreq/solcot/{ireq}/cmp-in-process/"
	@CMP_CC = "/!/cmpreq/solcot/{ireq}/cc/"
	@CMP_ALMACENES = "/!/cmpreq/unialm/"
	@CMP_CENTROS_SURTIDO = "/!/cmpreq/cs/"

	//* ======================================== [ AUTHORIZATIONS ]
}