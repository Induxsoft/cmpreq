#include "dkli.dkh"
#!
module ""
{
    @qry_list_cmpreq = "
    SELECT
        req.sys_pk,
        req.sys_guid,
        req.referencia,
        DATE_FORMAT(req.fecha,'%Y-%m-%d') AS fecha,
        IFNULL(DATE_FORMAT(req.flimite,'%Y-%m-%d'),'') AS flimite,
        CONCAT('$',FORMAT(req.subtotal,4)) AS subtotal,
        CONCAT('$',FORMAT(req.impuestos,4)) AS impuestos,
        CONCAT('$',FORMAT((req.subtotal + req.impuestos),4)) AS total,
        IF(req.consolidacion,'C','D') AS tipo,
        IFNULL(pda.partida,'') AS partida,
        stt.const AS cstatus,
        dvs.codigo AS cdivisa
    FROM cmpreq AS req
        LEFT JOIN gop_partida AS pda ON pda.sys_pk = req.partida
        INNER JOIN cmpreq_status AS stt ON stt.id = req.`status`
        INNER JOIN divisa AS dvs ON dvs.sys_pk = req.`divisa`
    WHERE NOT IFNULL(req.sys_deleted,0)
        #<conditions>
    "

    @qry_cmpreq = "
    SELECT
        req.sys_pk,
        req.sys_guid,
        req.sys_recver,
        req.referencia,
        DATE_FORMAT(req.fecha,'%Y-%m-%d') AS fecha,
        IFNULL(DATE_FORMAT(req.flimite,'%Y-%m-%d'),'') AS flimite,
        req.subtotal,
        req.impuestos,
        (req.subtotal + req.impuestos) AS importe,
        req.periodo,
        req.tcambio,
        req.`status`,
        IFNULL(req.notas,'') AS notas,
        IF(req.consolidacion,'C','D') AS tipo,
        IFNULL(pda.partida,'') AS partida_pre,
        IFNULL(pto.ejercicio,'') AS ejercicio,
        IFNULL(CONCAT('[',uni.codigo,'] ',uni.descripcion),'') AS unidad_org,
        CONCAT(dvs.codigo,' [',dvs.descripcion,']') AS ddivisa,
        stt.const AS cstatus,
        dvs.codigo AS cdivisa
    FROM cmpreq AS req
        LEFT JOIN gop_partida AS pda ON pda.sys_pk = req.partida
        LEFT JOIN gop_presupuesto AS pto ON pto.sys_pk = pda.ref_presupuesto
        LEFT JOIN rh_unidad_org AS uni ON uni.sys_pk = pto.ref_unidad
        INNER JOIN cmpreq_status AS stt ON stt.id = req.`status`
        INNER JOIN divisa AS dvs ON dvs.sys_pk = req.`divisa`
    WHERE req.#<@keyfield> = @_entity_id
        #<conditions>
    "

    @qry_cmpcon = "
    SELECT
        con.sys_pk,
        con.sys_guid,
        con.sys_recver,
        con.referencia,
        DATE_FORMAT(con.fecha,'%Y-%m-%d') AS fecha,
        IFNULL(DATE_FORMAT(con.flimite,'%Y-%m-%d'),'') AS flimite,
        con.subtotal,
        con.impuestos,
        (con.subtotal + con.impuestos) AS importe,
        con.tcambio,
        con.`status`,
        IFNULL(con.notas,'') AS notas,
        IF(con.consolidacion,'C','D') AS tipo,
        CONCAT(dvs.codigo,' [',dvs.descripcion,']') AS ddivisa,
        stt.const AS cstatus,
        dvs.codigo AS cdivisa
    FROM cmpreq AS con
        INNER JOIN cmpreq_status AS stt ON stt.id = con.`status`
        INNER JOIN divisa AS dvs ON dvs.sys_pk = con.`divisa`
    WHERE con.#<@keyfield> = @_entity_id
        #<conditions>
    "

    @qry_solcot = "
    SELECT
        sol.sys_pk,
        sol.sys_recver,
        sol.referencia,
        sol.folio AS ifolio,
        sol.proveedor AS iproveedor,
        IFNULL(DATE_FORMAT(sol.fenvio,'%Y-%m-%d'),'') AS fenvio,
        IFNULL(sol.redaccion,'') AS redaccion,
        IFNULL(sol.notas,'') AS notas,
        sol.req,
        IFNULL(sol.cotizacion,0) AS icotizacion,
        IF(sol.completa,'Si','No') AS completa,
        IF(sol.cancelada,'Si','No') AS cancelada,
        b.serie, f.folio,
        pdr.nombre AS proveedor,
        IFNULL(cot.referencia,'') AS cotizacion,
        IFNULL(DATE_FORMAT(cot.fecha,'%Y-%m-%d'),'') AS fcotizacion
    FROM solcot AS sol
        INNER JOIN foliosdocumentos AS f ON f.sys_pk = sol.folio
        INNER JOIN blockdocumentos AS b ON b.sys_pk = f.block
        INNER JOIN proveedor AS pdr ON pdr.sys_pk = sol.`proveedor`
        LEFT JOIN compra AS cot ON cot.sys_pk = sol.cotizacion
    WHERE sol.#<@keyfield> = @_entity_id
        #<conditions>
    "
}