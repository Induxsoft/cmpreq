#include "dkli.dkh"
#!
module ""
{
    @qry_list_cmpreq = "
    SELECT
        req.sys_pk,
        req.sys_guid,
        req.referencia,
        DATE_FORMAT(req.fecha,'%Y-%m-%d') AS fecha,
        IFNULL(DATE_FORMAT(req.flimite,'%Y-%m-%d'),'') AS flimite,
        CONCAT('$',FORMAT(req.subtotal,4)) AS subtotal,
        CONCAT('$',FORMAT(req.impuestos,4)) AS impuestos,
        CONCAT('$',FORMAT((req.subtotal + req.impuestos),4)) AS total,
        IF(req.en IS NOT NULL, 'Consolidado', stt.const) AS cstatus,
        IFNULL(req.consolidacion,0) consolidacion,
        typ.const AS tipo,
        IFNULL(cs.descripcion,'') AS csurtido,
        IFNULL(uni.descripcion,'') unidad,
        IFNULL(pda.partida,'') partida,
        dvs.codigo AS cdivisa
    FROM cmpreq AS req
        INNER JOIN cmpreq_type typ ON req.tipo = typ.id
        INNER JOIN cmpreq_status AS stt ON req.`status` = stt.id
        INNER JOIN divisa AS dvs ON req.`divisa` = dvs.sys_pk
        LEFT JOIN rh_unidad_org AS uni ON req.unidad_org = uni.sys_pk
        LEFT JOIN gop_partida AS pda ON req.partida = pda.sys_pk
        LEFT JOIN cconsumo AS cs ON req.cc = cs.sys_pk
    WHERE NOT IFNULL(req.sys_deleted,0)
        #<conditions>
    "

    @qry_cmpreq = "
    SELECT
        req.sys_pk,
        req.sys_guid,
        req.sys_recver,
        req.tipo,
        b.serie,
        f.folio,
        req.referencia,
        DATE_FORMAT(req.fecha,'%Y-%m-%d') AS fecha,
        IFNULL(DATE_FORMAT(req.flimite,'%Y-%m-%d'),'') AS flimite,
        IFNULL(req.unidad_org,0) unidad,
        IFNULL(req.ejercicio,pto.ejercicio) ejercicio,
        IFNULL(req.partida,0) partida,
        IFNULL(req.periodo,0) periodo,
        IFNULL(req.almacen,0) almacen,
        IFNULL(req.cc,0) cc,
        req.divisa,
        req.tcambio,
        req.`status`,
        req.subtotal,
        req.impuestos,
        (req.subtotal + req.impuestos) AS importe,
        IFNULL(req.notas,'') AS notas,
        IFNULL(req.consolidacion,0) consolidacion,
        IFNULL(req.en,0) en,
        IFNULL(req.origen,0) origen,
        b.sys_pk AS iblock,
        f.sys_pk AS ifolio,
        typ.const AS ctipo,
        stt.const AS cstatus,
        dvs.codigo AS cdivisa,
        IFNULL(pto.sys_pk,0) AS ipresupuesto,
        IFNULL(pda.id,'') AS partida_id,
        IFNULL(pda.partida,'') AS partida_pre,
        IFNULL(CONCAT('[',uni.codigo,'] ',uni.descripcion),'') AS unidad_org,
        IFNULL(CONCAT('[',alm.codigo,'] ',alm.descripcion),'') AS dalmacen,
        IFNULL(CONCAT('[',ccm.codigo,'] ',ccm.descripcion),'') AS dconsumo,
        CONCAT('[',dvs.codigo,'] ',dvs.descripcion) AS ddivisa
    FROM cmpreq AS req
        INNER JOIN cmpreq_type typ ON req.tipo = typ.id
        INNER JOIN cmpreq_status AS stt ON req.`status` = stt.id
        INNER JOIN foliosdocumentos f ON req.folio = f.sys_pk
        INNER JOIN blockdocumentos b ON f.block = b.sys_pk
        INNER JOIN divisa AS dvs ON req.`divisa` = dvs.sys_pk
        LEFT JOIN rh_unidad_org AS uni ON req.unidad_org = uni.sys_pk
        LEFT JOIN gop_partida AS pda ON req.partida = pda.sys_pk
        LEFT JOIN gop_presupuesto AS pto ON pda.ref_presupuesto = pto.sys_pk AND pto.ref_unidad = uni.sys_pk
        LEFT JOIN almacen alm ON req.almacen = alm.sys_pk
        LEFT JOIN cconsumo ccm ON req.cc = ccm.sys_pk
    WHERE (req.#<@keyfield> = @_entity_id)
        #<conditions>
    "

    @qry_dcmpreq = "
    SELECT
    -- Campos visibles en el editable
        p.codigo,
        p.descripcion,
        d.unidad,
        d.precio,
        d.cantidad,
        (d.precio * d.cantidad) AS subtotal,
        0 AS descuentos,
        d.impuestos,
        ((d.cantidad * d.precio) + d.impuestos) AS importe,
        IFNULL(d.notas,'') AS notas,
    -- Campos para el insert
        d.producto,
        IFNULL(d.excluido,0) AS excluido,
    -- Campos extras para operaciones
        IFNULL(i.uf_tipoi1,'') AS i1_txt,
        (CONVERT(REPLACE(SUBSTRING_INDEX(i.i1compra, '|', @zimpuesto),'%',''), DECIMAL(18,6)) / 100) AS i1_tasa,
        IFNULL(i.uf_tipoi2,'') AS i2_txt,
        (CONVERT(REPLACE(SUBSTRING_INDEX(i.i2compra, '|', @zimpuesto),'%',''), DECIMAL(18,6)) / 100) AS i2_tasa,
        IFNULL(i.uf_tipoi3,'') AS i3_txt,
        (CONVERT(REPLACE(SUBSTRING_INDEX(i.i3compra, '|', @zimpuesto),'%',''), DECIMAL(18,6)) / 100) AS i3_tasa,
        IFNULL(i.uf_tipoi4,'') AS i4_txt,
        (CONVERT(REPLACE(SUBSTRING_INDEX(i.i4compra, '|', @zimpuesto),'%',''), DECIMAL(18,6)) / 100) AS i4_tasa,
        TRIM(p.unidad) AS unidada,
        TRIM(IFNULL(p.unidadb,'')) AS unidadb,
        TRIM(IFNULL(p.unidadc,'')) AS unidadc,
        TRIM(IFNULL(p.unidadd,'')) AS unidadd,
        TRIM(IFNULL(p.unidade,'')) AS unidade,
        IFNULL(p.factorb,0) AS factorb,
        IFNULL(p.factorc,0) AS factorc,
        IFNULL(p.factord,0) AS factord,
        IFNULL(p.factore,0) AS factore
    FROM dcmpreq AS d
        INNER JOIN producto AS p ON p.sys_pk = d.producto
        INNER JOIN cfgimpuesto AS i ON i.sys_pk = p.impuestos
    WHERE (d.ref_req = COALESCE(@_entity_id,@ireq,@sys_pk))
        #<conditions>
    "

    @qry_aprovisionar_dcmpreq = "
    SELECT
        -- Campos visibles en el editable
        p.sys_pk AS iproducto,
        p.codigo,
        p.descripcion,
        dt.unidad,
        dt.precio,
        IF(@surtir_al_consolidar, SUM(dt.cantidad) - SUM(IFNULL(dt.surtido,0)), SUM(dt.cantidad)) AS requerido,
        SUM(IFNULL(e.existencia,0)) AS disponible,
        GREATEST(IF(@surtir_al_consolidar, SUM(dt.cantidad) - SUM(IFNULL(dt.surtido,0)), SUM(dt.cantidad)) - SUM(IFNULL(e.existencia,0)), 0) AS faltante,
        0 AS comprar,
        0 AS producir,
        -- Datos extras para operaciones
        IF(p.costopromedio, p.costopromedio, IFNULL(p.costoultimo,0)) AS cdirecto,
        p.iclase,
        p.idivisa,
        d.tcambio,
        IFNULL(mm.uf_minimo,0) uf_minimo,
        IFNULL(i.uf_tipoi1,'') AS i1_txt,
        (CONVERT(REPLACE(SUBSTRING_INDEX(i.i1compra, '|', @zimpuesto),'%',''), DECIMAL(18,6)) / 100) AS i1_tasa,
        IFNULL(i.uf_tipoi2,'') AS i2_txt,
        (CONVERT(REPLACE(SUBSTRING_INDEX(i.i2compra, '|', @zimpuesto),'%',''), DECIMAL(18,6)) / 100) AS i2_tasa,
        IFNULL(i.uf_tipoi3,'') AS i3_txt,
        (CONVERT(REPLACE(SUBSTRING_INDEX(i.i3compra, '|', @zimpuesto),'%',''), DECIMAL(18,6)) / 100) AS i3_tasa,
        IFNULL(i.uf_tipoi4,'') AS i4_txt,
        (CONVERT(REPLACE(SUBSTRING_INDEX(i.i4compra, '|', @zimpuesto),'%',''), DECIMAL(18,6)) / 100) AS i4_tasa
    FROM cmpreq AS cn
        RIGHT JOIN cmpreq rq ON rq.en = cn.sys_pk
        INNER JOIN dcmpreq dt ON dt.ref_req = rq.sys_pk
        INNER JOIN producto p ON dt.producto = p.sys_pk
        INNER JOIN divisa d ON p.idivisa = d.sys_pk
        INNER JOIN cfgimpuesto AS i ON p.impuestos = i.sys_pk
        INNER JOIN cconsumo c ON rq.cc = c.sys_pk
        LEFT JOIN existencias e ON c.ialmacen = e.ialmacen AND dt.producto = e.fk_producto_iexistencias
        LEFT JOIN ut_maxmin mm ON c.ialmacen = mm.ialmacen AND dt.producto = mm.iproducto
    WHERE (cn.sys_pk = @_entity_id OR rq.sys_pk = @_entity_id)
    GROUP BY
        dt.producto, dt.unidad, dt.precio,
        -- Otros campos porque MySQL 8.x se fresea :/
        p.sys_pk, p.codigo, p.descripcion, p.costopromedio, p.costoultimo,
        p.iclase, p.idivisa, d.tcambio, mm.uf_minimo,
        i.uf_tipoi1, i.uf_tipoi2, i.uf_tipoi3, i.uf_tipoi4,
        i.i1compra, i.i2compra, i.i3compra, i.i4compra
    ORDER BY
        p.codigo
    "

    @qry_surtir_dcmpreq = "
    SELECT
        d.sys_pk AS idetalle,
        p.sys_pk AS iproducto,
        p.codigo,
        p.descripcion,
        p.unidad,
        d.cantidad,
        IFNULL(p.costoultimo,0) costoultimo,
        IFNULL(d.surtido,0) surtido,
        0 AS entregar,
        (d.cantidad - IFNULL(d.surtido,0)) AS faltante,
        -- Existencias en el almacén del centro de surtido (cconsumo)
        (
            SELECT IFNULL(SUM(IFNULL(ex1.existencia,0)),0)
            FROM existencias ex1
            WHERE ex1.fk_producto_iexistencias = p.sys_pk AND ex1.ialmacen = c.ialmacen
        ) AS exist_origen,
        -- Existencias en el almacén de la unidad organizacional
        (
            SELECT IFNULL(SUM(IFNULL(ex2.existencia,0)),0)
            FROM existencias ex2
            WHERE ex2.fk_producto_iexistencias = p.sys_pk AND ex2.ialmacen = r.almacen
        ) AS exist_destino
    FROM cmpreq r
        INNER JOIN cconsumo c ON r.cc = c.sys_pk
        INNER JOIN dcmpreq d ON d.ref_req = r.sys_pk
        INNER JOIN producto p ON d.producto = p.sys_pk
    WHERE r.sys_pk = @_entity_id
    "

    @qry_buscar_producto = "
    SELECT
        p.sys_pk,
        p.codigo,
        p.descripcion,
        p.costoultimo AS precio,
        1 AS cantidad,
        0 AS descuentos,
        TRIM(p.unidad) AS unidada,
        TRIM(IFNULL(p.unidadb,'')) AS unidadb,
        TRIM(IFNULL(p.unidadc,'')) AS unidadc,
        TRIM(IFNULL(p.unidadd,'')) AS unidadd,
        TRIM(IFNULL(p.unidade,'')) AS unidade,
        IFNULL(p.factorb,0) AS factorb,
        IFNULL(p.factorc,0) AS factorc,
        IFNULL(p.factord,0) AS factord,
        IFNULL(p.factore,0) AS factore,
        dvs.codigo AS `divisa`,
        dvs.tcambio AS tipocambio,
        imp.nombre AS conf_impuestos,
        IFNULL(imp.uf_tipoi1,'') AS i1_txt,
        (CONVERT(REPLACE(SUBSTRING_INDEX(imp.i1compra, '|', @zimpuesto),'%',''), DECIMAL(18,6)) / 100) AS i1_tasa,
        IFNULL(imp.uf_tipoi2,'') AS i2_txt,
        (CONVERT(REPLACE(SUBSTRING_INDEX(imp.i2compra, '|', @zimpuesto),'%',''), DECIMAL(18,6)) / 100) AS i2_tasa,
        IFNULL(imp.uf_tipoi3,'') AS i3_txt,
        (CONVERT(REPLACE(SUBSTRING_INDEX(imp.i3compra, '|', @zimpuesto),'%',''), DECIMAL(18,6)) / 100) AS i3_tasa,
        IFNULL(imp.uf_tipoi4,'') AS i4_txt,
        (CONVERT(REPLACE(SUBSTRING_INDEX(imp.i4compra, '|', @zimpuesto),'%',''), DECIMAL(18,6)) / 100) AS i4_tasa
        #<selects>
    FROM producto AS p
        INNER JOIN divisa AS dvs ON dvs.sys_pk = p.idivisa
        INNER JOIN cfgimpuesto AS imp ON imp.sys_pk = p.impuestos
        #<joins>
    WHERE TRUE
        #<conditions>
    "

    @qry_buscar_unidad = "SELECT sys_pk, codigo, descripcion FROM rh_unidad_org WHERE TRUE #<conditions>"
    @qry_buscar_partida = "SELECT pda.sys_pk, pda.id, pda.partida FROM gop_partida AS pda #<joins> WHERE TRUE #<conditions>"
    @qry_list_series = "SELECT sys_pk, serie FROM blockdocumentos WHERE NOT IFNULL(sys_deleted,0) AND activo AND documento = @doctype"
    @qry_list_divisas = "SELECT sys_pk, codigo, tcambio, CONCAT(codigo,' [',descripcion,']') AS `text` FROM divisa WHERE NOT IFNULL(sys_deleted,0)"

    @qry_cmpcon = "
    SELECT
        con.sys_pk,
        con.sys_guid,
        con.sys_recver,
        con.referencia,
        DATE_FORMAT(con.fecha,'%Y-%m-%d') AS fecha,
        IFNULL(DATE_FORMAT(con.flimite,'%Y-%m-%d'),'') AS flimite,
        IFNULL(con.cc,0) cc,
        con.subtotal,
        con.impuestos,
        (con.subtotal + con.impuestos) AS importe,
        con.tcambio,
        con.`status`,
        IFNULL(con.notas,'') AS notas,
        IFNULL(con.consolidacion,0) AS consolidacion,
        typ.const AS ctipo,
        stt.const AS cstatus,
        dvs.codigo AS cdivisa,
        IFNULL(CONCAT('[',ccm.codigo,'] ',ccm.descripcion),'') AS dconsumo,
        CONCAT(dvs.codigo,' [',dvs.descripcion,']') AS ddivisa
    FROM cmpreq AS con
        INNER JOIN cmpreq_type typ ON con.tipo = typ.id
        INNER JOIN cmpreq_status AS stt ON stt.id = con.`status`
        INNER JOIN divisa AS dvs ON dvs.sys_pk = con.`divisa`
        LEFT JOIN cconsumo ccm ON con.cc = ccm.sys_pk
    WHERE (con.#<@keyfield> = @_entity_id)
        #<conditions>
    "

    @qry_obtener_productos = "
    SELECT
        p.sys_pk,
        p.codigo,
        p.descripcion,
        d.unidad,
        d.precio,
        d.cantidad,
        ROUND(d.precio * d.cantidad, 4) AS subtotal,
        d.impuestos,
        ROUND((d.precio * d.cantidad) + d.impuestos, 4) AS importe,
        IFNULL(d.excluido,0) AS excluido,
        IFNULL(d.notas,'') AS notas,
        d.ref_req
    FROM dcmpreq AS d
        INNER JOIN producto AS p ON p.sys_pk = d.`producto`
    WHERE (d.ref_req = @_entity_id)
        #<conditions>
    "

    @qry_solcot = "
    SELECT
        sol.sys_pk,
        sol.sys_recver,
        sol.referencia,
        sol.folio AS ifolio,
        sol.proveedor AS iproveedor,
        IFNULL(DATE_FORMAT(sol.fenvio,'%Y-%m-%d'),'') AS fenvio,
        IFNULL(sol.redaccion,'') AS redaccion,
        IFNULL(sol.notas,'') AS notas,
        sol.req,
        IFNULL(sol.cotizacion,0) AS icotizacion,
        IF(sol.completa,'Si','No') AS completa,
        IF(sol.cancelada,'Si','No') AS cancelada,
        b.serie, f.folio,
        pdr.nombre AS proveedor,
        IFNULL(cot.referencia,'') AS cotizacion,
        IFNULL(DATE_FORMAT(cot.fecha,'%Y-%m-%d'),'') AS fcotizacion,
        IFNULL((((((cot.subtotal - cot.descuento1) - cot.descuento2) + cot.impuesto1) + cot.impuesto2) + cot.impuesto3) + cot.impuesto4,0) AS ttl_cot
    FROM solcot AS sol
        INNER JOIN foliosdocumentos AS f ON f.sys_pk = sol.folio
        INNER JOIN blockdocumentos AS b ON b.sys_pk = f.block
        INNER JOIN proveedor AS pdr ON pdr.sys_pk = sol.`proveedor`
        LEFT JOIN compra AS cot ON cot.sys_pk = sol.cotizacion
    WHERE (sol.#<@keyfield> = @_entity_id)
        #<conditions>
    "

    @qry_buscar_proveedor = "
    SELECT 
        pdr.sys_pk,
        pdr.codigo,
        pdr.nombre,
        tpp.descripcion AS tipo,
        dvs.sys_pk AS idivisa,
        dvs.codigo AS cdivisa,
        dvs.tcambio,
        pdr.tasaiva,
        IF(pdr.tasaiva=2,-1,1) AS zimpuesto,
        zi.const AS zona_impuesto
    FROM proveedor AS pdr
        INNER JOIN tipoproveedor AS tpp ON tpp.sys_pk = pdr.tipo
        INNER JOIN divisa AS dvs ON dvs.sys_pk = pdr.idivisa
        INNER JOIN ctasasiva AS zi ON zi.id = pdr.tasaiva
    WHERE TRUE #<conditions>
    "
}